---
// French variant of Quickstart.astro.
// Install commands and CLI output stay English (literal command strings + stdout).
---

<section class="quickstart section" id="quickstart" aria-labelledby="quickstart-title">
  <div class="section-inner">
    <h2 id="quickstart-title" class="quickstart__title">
      Vous préférez le CLI ?
    </h2>
    <p class="quickstart__lede">
      Vous n'utilisez pas d'agents d'IA, ou vous avez besoin de valider vos spécifications
      dans votre pipeline de CI ? Il y a un CLI pour cela. S'installe en 60 secondes
      — sans compte, sans télémétrie, fonctionne sur n'importe quel dossier
      de spécifications en Markdown.
    </p>

    <div class="qs-tabs" role="tablist" aria-label="Commande d'installation pour votre système d'exploitation">
      <button
        type="button"
        role="tab"
        id="qs-tab-unix"
        aria-controls="qs-panel-unix"
        aria-selected="true"
        tabindex="0"
        class="qs-tab is-active"
        data-tab="unix"
      >
        Linux / macOS
      </button>
      <button
        type="button"
        role="tab"
        id="qs-tab-windows"
        aria-controls="qs-panel-windows"
        aria-selected="false"
        tabindex="-1"
        class="qs-tab"
        data-tab="windows"
      >
        Windows
      </button>
    </div>

    <div
      id="qs-panel-unix"
      role="tabpanel"
      aria-labelledby="qs-tab-unix"
      class="qs-panel is-active"
      data-panel="unix"
    >
<pre class="terminal"><span class="prompt">$</span> curl -fsSL https://specscore.md/install/get-cli | sh</pre>
    </div>

    <div
      id="qs-panel-windows"
      role="tabpanel"
      aria-labelledby="qs-tab-windows"
      class="qs-panel"
      data-panel="windows"
      hidden
    >
<pre class="terminal"><span class="prompt">&gt;</span> irm https://specscore.md/install/get-cli.ps1 | iex</pre>
    </div>

    <p class="quickstart__step">
      Passez le linter sur l'exemple de spécification fourni avec le binaire :
    </p>
<pre class="terminal terminal--window"><span class="prompt">$</span> specscore lint examples/checkout/apply-discount.md</pre>

    <p class="quickstart__step">Observez le résultat :</p>
<pre class="terminal terminal--window">  examples/checkout/apply-discount.md
    <span class="mark-pass">✓</span> R1  has acceptance criteria
    <span class="mark-pass">✓</span> R2  has acceptance criteria
    <span class="mark-fail">✗</span> R3  no acceptance criteria
    <span class="mark-fail">✗</span> link     <span class="dim">"Related Feature: discount-tiers" not found</span>
    <span class="mark-fail">✗</span> section  <span class="dim">"Open Questions" missing</span>

  <span class="dim">3 problems   exit 1</span></pre>

    <p class="quickstart__next">
      Lire la <a class="xref" href="/docs">documentation complète</a>
      <span aria-hidden="true">·</span>
      <a class="xref" href="https://github.com/specscore/specscore">Contribuer sur GitHub</a>
    </p>
  </div>
</section>

<script is:inline>
  (function () {
    var tabs = document.querySelectorAll('.qs-tab');
    var panels = document.querySelectorAll('.qs-panel');
    if (!tabs.length) return;

    function activate(name, focus) {
      tabs.forEach(function (t) {
        var on = t.getAttribute('data-tab') === name;
        t.classList.toggle('is-active', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.setAttribute('tabindex', on ? '0' : '-1');
        if (on && focus) t.focus();
      });
      panels.forEach(function (p) {
        var on = p.getAttribute('data-panel') === name;
        p.classList.toggle('is-active', on);
        if (on) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });
    }

    try {
      if (/Windows/i.test(navigator.userAgent)) {
        activate('windows', false);
      }
    } catch (e) {
      /* ignore */
    }

    tabs.forEach(function (tab) {
      tab.addEventListener('click', function () {
        activate(tab.getAttribute('data-tab'), false);
      });
      tab.addEventListener('keydown', function (ev) {
        var key = ev.key;
        if (key !== 'ArrowRight' && key !== 'ArrowLeft') return;
        ev.preventDefault();
        var target = tab.getAttribute('data-tab') === 'unix' ? 'windows' : 'unix';
        activate(target, true);
      });
    });
  })();
</script>

<style>
  .quickstart { background: var(--cream); }
  .quickstart__title {
    font-size: var(--fs-h2);
    margin-bottom: var(--space-2);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .quickstart__lede {
    font-size: 1.05rem;
    color: var(--mid-ink);
    margin-bottom: var(--space-4);
    max-width: 60ch;
    line-height: 1.6;
  }
  .quickstart__step {
    font-size: var(--fs-small);
    color: var(--mid-ink);
    margin-top: var(--space-3);
    margin-bottom: var(--space-1);
    font-weight: 500;
  }
  .quickstart__next {
    margin-top: var(--space-4);
    font-size: var(--fs-small);
    color: var(--mid-ink);
  }

  /* --- Quickstart OS tabs --- */
  .qs-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--hairline);
    margin-bottom: 0;
  }
  .qs-tab {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 0.5rem 0.9rem;
    font-family: var(--font-code);
    font-size: 0.825rem;
    color: var(--mid-ink);
    cursor: pointer;
    transition: color 120ms ease, border-color 160ms ease;
  }
  .qs-tab:hover {
    color: var(--ink);
  }
  .qs-tab:focus-visible {
    outline: 2px solid var(--ink-blue);
    outline-offset: -2px;
  }
  .qs-tab.is-active {
    color: var(--ink);
    border-bottom-color: var(--validator-green);
    font-weight: 600;
  }
  .qs-panel {
    border-left: 1px solid var(--hairline);
    border-right: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    background: var(--surface);
  }
  .qs-panel pre.terminal {
    margin: 0;
    border: none;
    border-radius: 0;
  }
</style>
