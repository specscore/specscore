---
// Polish variant of SiteFooter.astro. Wordmark + product names stay English.
import type { LangCode } from '../lib/languages';

const currentLocale: LangCode = 'pl';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__col site-footer__brand">
      <a href="/pl/" class="wordmark" aria-label="SpecScore — strona główna">
        <span class="wordmark__clef" aria-hidden="true">𝄞</span>
        <span class="wordmark__name">SpecScore.md</span>
      </a>
      <p class="site-footer__tagline">
        Otwarty standard dla specyfikacji, wymagań i kryteriów akceptacji.
        Ustrukturyzowany dla agentów AI, czytelny dla ludzi.
      </p>
      <p class="site-footer__copyright">
        © 2026 SpecScore contributors. Specification and docs: <a href="https://github.com/specscore/specscore/blob/main/LICENSE">CC BY 4.0</a>. CLI: <a href="https://github.com/specscore/specscore-cli/blob/main/LICENSE">Apache-2.0</a>.
      </p>
    </div>

    <div class="site-footer__col">
      <h4 class="site-footer__heading">Produkt</h4>
      <ul class="site-footer__list">
        <li><a href="/docs/">Dokumentacja</a></li>
        <li><a href="/pl/cli/">CLI</a></li>
        <li><a href="/pl/ai/">Skille AI</a></li>
        <li><a href="/pl/vs/">Porównanie</a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h4 class="site-footer__heading">Wiedza</h4>
      <ul class="site-footer__list">
        <li><a href="/pl/spec-driven-development/">Rozwój sterowany specyfikacją</a></li>
      </ul>
    </div>

    <div class="site-footer__col">
      <h4 class="site-footer__heading">Społeczność</h4>
      <ul class="site-footer__list">
        <li><a href="https://github.com/specscore/specscore">GitHub</a></li>
        <li><a href="https://github.com/specscore/specscore/blob/main/CONTRIBUTING.md">Współpraca</a></li>
        <li><a href="https://github.com/specscore/specscore/blob/main/LICENSE">Licencja</a></li>
      </ul>
    </div>

  </div>

</footer>

<style>
  .site-footer {
    background: var(--cream);
    padding: var(--space-6) var(--space-3) var(--space-5);
  }
  .site-footer__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-4);
  }
  .site-footer__brand .wordmark {
    margin-bottom: var(--space-2);
  }
  .site-footer__tagline {
    color: var(--mid-ink);
    margin-bottom: var(--space-2);
    max-width: 36ch;
    line-height: 1.5;
    font-size: 0.95rem;
  }
  .site-footer__copyright {
    color: var(--pale-ink);
    font-size: 0.825rem;
    font-family: var(--font-code);
  }
  .site-footer__heading {
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    margin-bottom: var(--space-2);
  }
  .site-footer__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .site-footer__list a {
    color: var(--ink);
    font-size: 0.9rem;
    border-bottom: 1px solid transparent;
    transition: border-color 120ms ease;
  }
  .site-footer__list a:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }

  @media (max-width: 720px) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
  }
</style>
