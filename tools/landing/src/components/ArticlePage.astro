---
import AcceptanceArticle from './AcceptanceArticle.astro';
import EarsArticle from './EarsArticle.astro';
import LintArticle from './LintArticle.astro';

const path = Astro.url.pathname;
const lint = path.includes('/articles/lint-specs-in-ci');
const ears = path.includes('/articles/ears-requirements');
---

{lint ? <LintArticle /> : ears ? <EarsArticle /> : <AcceptanceArticle />}
