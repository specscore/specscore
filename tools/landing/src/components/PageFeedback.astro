---
// Universal page feedback bar — appears at the bottom of every landing page.
// On non-English pages: mentions translation errors AND general improvements.
// On English pages: mentions general improvements only.
// Replaces the per-locale translation-note blocks that were in BaseLayout.

const path = Astro.url.pathname;
const locale =
  path.startsWith('/ru')    ? 'ru'    :
  path.startsWith('/uk')    ? 'uk'    :
  path.startsWith('/es')    ? 'es'    :
  path.startsWith('/pt-br') ? 'pt-br' :
  path.startsWith('/ja')    ? 'ja'    :
  path.startsWith('/zh-cn') ? 'zh-cn' :
  path.startsWith('/ko')    ? 'ko'    :
                              'en';

type Copy = { text: string; link: string };
const i18n: Record<string, Copy> = {
  en: {
    text: 'Have an idea how to improve this page?',
    link: 'Let us know',
  },
  es: {
    text: '¿Encontraste un error en la traducción o tienes una idea para mejorar esta página?',
    link: 'Avísanos',
  },
  'pt-br': {
    text: 'Encontrou um erro na tradução ou tem uma ideia para melhorar esta página?',
    link: 'Nos avise',
  },
  ru: {
    text: 'Нашли ошибку в переводе или знаете как улучшить эту страницу?',
    link: 'Сообщите нам',
  },
  uk: {
    text: 'Знайшли помилку в перекладі або маєте ідею як покращити цю сторінку?',
    link: 'Повідомте нам',
  },
  ja: {
    text: '翻訳の誤りやこのページの改善案がありますか？',
    link: 'お知らせください',
  },
  'zh-cn': {
    text: '发现翻译问题或有改进此页面的想法？',
    link: '告诉我们',
  },
  ko: {
    text: '번역 오류를 발견했거나 이 페이지를 개선할 아이디어가 있나요?',
    link: '알려주세요',
  },
};

const t = i18n[locale] ?? i18n.en;
---

<div class="page-feedback">
  <p>
    {t.text}
    {' '}<button type="button" data-feedback-launcher aria-haspopup="dialog" hidden>{t.link}</button>
  </p>
</div>
<script is:inline id="site-feedback-widget" src="https://improveit.now/widget.js" data-space="ao58m" data-app="75251aa279608b533e93a785f5ae3aee" data-lang={locale === 'ru' ? 'ru' : 'en'} data-color="#0d63e9" data-launcher="hidden" defer></script>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-feedback-launcher]');
  const embed = document.getElementById('site-feedback-widget');
  const widget = () => (window as Window & {ImproveIt?: {open: () => void}}).ImproveIt;
  const ready = () => { if (button && typeof widget()?.open === 'function') button.hidden = false; };
  embed?.addEventListener('load', ready, {once: true});
  ready();
  button?.addEventListener('click', () => widget()?.open());
</script>

<style>
  .page-feedback {
    background: var(--cream-2);
    border-top: 1px solid var(--hairline);
    padding: 0.75rem var(--space-3);
    text-align: center;
    font-family: var(--font-code);
    font-size: 0.78rem;
    color: var(--pale-ink);
    letter-spacing: 0.01em;
  }
  .page-feedback button {
    min-height: 44px; padding: 8px 14px; background: #0d63e9; color: #fff; border: 1px solid #084dbd; font: inherit; cursor: pointer;

    transition: color 120ms ease;
  }
  .page-feedback button[hidden] { display: none; }
  .page-feedback button:hover { background: #084dbd; }
  .page-feedback button:focus-visible { outline: 3px solid #084dbd; outline-offset: 3px; }
</style>
