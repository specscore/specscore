---
// Section 1 — Hero.
// Per hero-scene.md: two-column desktop layout, copy left (~45%), score right (~55%).
// Animation: a quiet settle (~1.7s total), not a theatrical reveal.
import { Image } from 'astro:assets';
import heroImage from '../assets/hero.webp';
import FilmEmbed from './FilmEmbed.astro';
import HeroGitHubLink from './HeroGitHubLink.astro';
import { CONTENT_UPDATED, updatedSentence } from '../content/updated.ts';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__inner">
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__title">
        SpecScore: an open, lintable format for AI-readable specs
      </h1>
      <p class="hero__headline">
        Every ambiguity in your spec<br />is a token your agent burns.
      </p>
      
      
      
      <p class="hero__sub">
        SpecScore is an open, lintable file format for specifications, written in Markdown and YAML (YAML Ain't Markup Language) — like JSON (JavaScript Object Notation) for data — with a command-line interface (CLI) your agents call to query and edit them, like <code>jq</code> for JSON. A spec score is the check on those files: the linter passes or fails a specification when required sections, references or lifecycle status are wrong, and you can run that check in CI (continuous integration), the automated build that runs on every change. SDD (<a href="/spec-driven-development/">spec-driven development</a>) means writing that specification before the code and checking the code against it. <a href="/what-is-specscore/">What a spec score means</a> explains the name; <a href="/articles/lint-specs-in-ci/">how to lint specs in CI</a> shows the check in the build.
      </p>
      <p class="page-updated"><time datetime={CONTENT_UPDATED}>{updatedSentence.en}</time></p>
      <p class="hero__stakes">
        Then a clarifying question mid-build. Then a fix after it ships.
        Then the context you keep re-explaining.
      </p>
      <HeroGitHubLink repo="specscore/specscore" label="Open-source on GitHub" />
      <div class="hero__cta">
        <a href="/ai/" class="btn btn--primary">Get AI skills for your agent</a>
        <a href="/cli/" class="btn btn--secondary">Install the CLI</a>
      </div>
    </div>

    <div class="hero__art">
      <figure
        class="hero__illustration"
        aria-label="A SpecScore specification on cream drafting paper: two requirements pass lint (green checks), one fails (red mark)."
      >
        <Image
          src={heroImage}
          widths={[350, 700, 1050]}
          sizes="(max-width: 860px) 46vw, 24vw"
          alt=""
          loading="eager"
          decoding="async"
        />
      </figure>
      <FilmEmbed
        videoId="dvYYsFzfDlk"
        poster="/film/specscore-specs-that-pass-en.webp"
        duration="1:38"
        lang="en"
        title="SpecScore: specs that pass"
        playLabel="Play the 1:38 film: SpecScore — specs that pass"
        headingId="hero-film-caption"
        eager
      />
      <p id="hero-film-caption" class="hero__film-caption">
        See it in 1:38: lint a spec before the agent writes code, then plan
        against it. Real <code>specscore</code> CLI output on a demo repo.
      </p>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-7);
    background: var(--cream);
    overflow: hidden;
  }
  .hero__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 45fr 55fr;
    gap: var(--space-6);
    align-items: center;
  }
  .hero__copy {
    animation: hero-copy-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 280ms;
  }
  .hero__title {
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.5rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-family: var(--font-display);
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    margin-bottom: var(--space-4);
    max-width: 36ch;
    line-height: 1.5;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__art {
    margin: 0;
    animation: hero-art-in 700ms cubic-bezier(0.22, 0.61, 0.36, 1) both 100ms;
  }
  .hero__art img {
    width: 100%;
    height: auto;
    display: block;
  }

  @keyframes hero-copy-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes hero-art-in {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 860px) {
    .hero {
      padding: var(--space-5) var(--space-3) var(--space-6);
    }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }
    .hero__art {
      order: 2;
      max-width: 520px;
    }
    .hero__copy {
      order: 1;
    }
  }
</style>
