---
// /de/faq/ — Frequently asked questions (German).
// German variant of /faq/index.astro. Anchor IDs stay verbatim
// (vs-spec-kit, vs-superpowers, why-cli, naming, token-savings) so the
// homepage teaser link targets land correctly.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import FinalCta from '../../../components/FinalCtaDe.astro';
import SiteFooter from '../../../components/SiteFooterDe.astro';
---

<BaseLayout
  lang="de"
  title="FAQ — SpecScore"
  description="Ehrliche Antworten auf echte Fragen: Wie sich SpecScore von spec-kit unterscheidet, warum es neben Skills eine CLI gibt, was „Score“ bedeutet und woher die Zahlen zur Token-Ersparnis kommen."
  canonical="https://specscore.md/de/faq/"
>
  <SiteHeader />

  <main>
    <section class="faq-hero" aria-labelledby="faq-hero-title">
      <div class="faq-hero__inner">
        <h1 id="faq-hero-title" class="faq-hero__headline">
          Fragen, die Reviewer wirklich gestellt haben.
        </h1>
        <p class="faq-hero__sub">
          Gesammelt aus Feedback vor dem Launch. Jede Antwort ist
          ehrlich, kein Marketing-Sprech.
        </p>
      </div>
    </section>

    <section class="faq-body section" aria-labelledby="faq-list-title">
      <div class="section-inner">
        <h2 id="faq-list-title" class="sr-only">FAQ-Liste</h2>

        <article class="faq-item">
          <h2 id="vs-spec-kit" class="faq-item__q">
            Wie unterscheidet sich SpecScore von spec-kit?
          </h2>
          <div class="faq-item__a">
            <p>
              <strong>spec-kit ist eine Methodik – ein Prozess zum Schreiben von Spezifikationen.</strong>
              SpecScore ist ein <strong>Speicherformat</strong> für die
              Spezifikationen, die du schreibst, plus eine CLI zum Abfragen und Bearbeiten. Die
              beiden ergänzen sich: spec-kit kann SpecScore-Dateien erzeugen, und eine
              spec-kit-Erweiterung, die im SpecScore-Format schreibt, ist bereits
              in Arbeit.
            </p>
            <p>
              Wähle spec-kit, wenn du einen Prozess brauchst. Wähle SpecScore, wenn du
              Spezifikationen brauchst, die KI-Agenten linten, abfragen und
              ändern können, ohne jede Datei im Repository zu lesen. Nutze beide, wenn
              du beides möchtest.
            </p>
          </div>
        </article>

        <article class="faq-item">
          <h2 id="vs-superpowers" class="faq-item__q">
            Wie unterscheiden sich die SpecStudio Skills von Superpowers und agent-skills?
          </h2>
          <div class="faq-item__a">
            <p>
              Im Ansatz ähnlich. Alle drei sind Skill-Bibliotheken, die
              KI-Agenten durch ideate → specify → plan → implement führen.
              Der Unterschied ist technischer, nicht philosophischer Natur.
            </p>
            <p>
              <strong>SpecStudio Skills schreibt seine Artefakte im SpecScore-Format</strong> (eine
              definierte Struktur aus Markdown + YAML) und steuert die CLI <code>specscore</code> für
              Abfragen, Linting und Statusänderungen an. Superpowers und agent-skills
              lesen und schreiben Dateien weitgehend direkt aus der Prosa des Skills heraus.
            </p>
            <p>
              Wähle SpecStudio Skills, wenn der Token-Verbrauch zählt – die
              CLI liefert eine strukturierte Antwort auf <em>„alle offenen Features
              mit ungeklärten Fragen“</em> in einem einzigen Aufruf,
              während ein dateibasierter Skill dafür N Dokumente einlesen muss.
            </p>
          </div>
        </article>

        <article class="faq-item">
          <h2 id="why-cli" class="faq-item__q">
            Warum eine CLI – reicht es nicht, Skills zu installieren?
          </h2>
          <div class="faq-item__a">
            <p>
              Skills können Dateien lesen und schreiben. Sie können jedoch nicht
              zuverlässig:
            </p>
            <ul>
              <li>referenzielle Integrität im gesamten Spezifikationsbaum garantieren (dass Links auflösen, IDs eindeutig sind, Indizes synchron gehalten werden);</li>
              <li>eine gefilterte Liste „offener Features mit unbeantworteten Fragen“ zurückgeben, ohne jede Datei zu lesen;</li>
              <li>das richtige Statusfeld zum richtigen Zeitpunkt in jedem Artefakt mutieren.</li>
            </ul>
            <p>
              Die CLI bietet Agenten einen sauberen Aufruf pro Aufgabe – genauso
              wie <code>jq</code> einen sauberen Aufruf für JSON-Abfragen bietet.
              Skills allein verbrauchen mehr Tokens, weichen häufiger ab und
              vergessen oft, den Index zu aktualisieren.
            </p>
          </div>
        </article>

        <article class="faq-item">
          <h2 id="naming" class="faq-item__q">
            Warum heißt es „SpecScore“ – was wird bewertet?
          </h2>
          <div class="faq-item__a">
            <p>
              „Score“ lässt sich auf zwei Arten verstehen, und beide sind beabsichtigt.
            </p>
            <p>
              <strong>Partitur.</strong> Eine strukturierte Partitur aus Anforderungen –
              genau wie eine Musikpartitur Stimmen, Parts und Takte strukturiert.
              Öffne einen SpecScore-Baum und du solltest ihn wie ein Dirigent lesen können:
              Hierarchie, Teile, Referenzen – alles auf einen Blick sichtbar.
            </p>
            <p>
              <strong>Eine buchstäbliche Qualitätsbewertung.</strong> Der Linter der CLI
              ist die deterministische Prüfung (hält die Struktur der Spezifikation stand?).
              Der <a href="https://specscore.studio/app/github.com/specscore/specstudio-skills/spec/ideas/manual-review-and-score-commands">Skill <code>/score</code></a>
              ist die KI-Beurteilung – eine Reifegradnote von A bis F pro
              Artefakt, mit Achsen-Feedback für den Autor. Der Namensteil „Score“
              wird so zu einem konkreten Feature, das das Tool liefert,
              nicht nur zu einem Wunschgedanken.
            </p>
          </div>
        </article>

        <article class="faq-item">
          <h2 id="token-savings" class="faq-item__q">
            Zeig mir die Zahlen zur Token-Ersparnis.
          </h2>
          <div class="faq-item__a">
            <p>
              Ein gemessener Direktvergleich ist in Arbeit und wird vor dem
              Veröffentlichungsbeitrag publiziert – dieselbe Aufgabe („Woran sollte ich
              als Nächstes arbeiten?“), zweimal ausgeführt: einmal mit einem
              Agenten ohne CLI, der Dokumente liest, und einmal mit demselben
              Agenten, der die SpecScore-CLI aufruft. Gemessen werden
              Token-Anzahl und Antwortzeit für beide Fälle.
            </p>
            <p>
              Bis diese Zahlen vorliegen, gilt das strukturelle Argument:
              Ein Agent, der die CLI nach offenen Features und ungeklärten
              Fragen fragt, erhält eine kompakte, strukturierte Antwort. Derselbe
              Agent ohne CLI liest N Dokumente – oft Dutzende. Die
              CLI-Oberfläche ist genau dafür gebaut, dieses Ausufern an
              Lesevorgängen zu vermeiden.
            </p>
          </div>
        </article>

                <article class="faq-item">
          <h2 id="licence" class="faq-item__q">
            Unter welcher Lizenz steht SpecScore?
          </h2>
          <div class="faq-item__a">
            <p>
              Spezifikation und Dokumentation im öffentlichen Repository <a href="https://github.com/specscore/specscore">specscore/specscore</a> stehen unter <a href="https://github.com/specscore/specscore/blob/main/LICENSE">CC BY 4.0</a>. Die Referenz-Befehlszeilenschnittstelle (CLI) in <a href="https://github.com/specscore/specscore-cli">specscore/specscore-cli</a> steht unter <a href="https://github.com/specscore/specscore-cli/blob/main/LICENSE">Apache-2.0</a>.
            </p>
          </div>
        </article>

        <article class="faq-item">
          <h2 id="ai-vendor" class="faq-item__q">
            Braucht SpecScore ein bestimmtes KI-Werkzeug?
          </h2>
          <div class="faq-item__a">
            <p>
              Nein. Spezifikationen sind Textdateien im Repository. Die CLI ist ein lokales Programm. Die AI Skills auf dieser Website kapseln diese CLI für Agenten, die Skills ausführen können. Das Format verlangt keinen einzelnen Anbieter.
            </p>
          </div>
        </article>

        <article class="faq-item">
          <h2 id="what-is-sdd" class="faq-item__q">
            Was ist spezifikationsgetriebene Entwicklung (SDD)?
          </h2>
          <div class="faq-item__a">
            <p>
              Spezifikationsgetriebene Entwicklung (SDD) heißt: zuerst eine testbare Spezifikation schreiben — Anforderungen und Akzeptanzkriterien — und das Ergebnis danach dagegen prüfen. SpecScore ist ein Dateiformat für diese Spezifikationen.
            </p>
          </div>
        </article>

        <p class="faq-extend">
          Weitere Fragen oder eine präzisere Version einer dieser Antworten? Öffne
          ein Issue auf
          <a href="https://github.com/specscore/specscore/issues">specscore/specscore</a>;
          diese Seite ist die kanonische FAQ und wächst anhand echter Fragen
          aus der Community.
        </p>
      </div>
    </section>
  </main>

  <FinalCta />
  <SiteFooter />
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap; border: 0;
  }

  .faq-hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .faq-hero__inner {
    max-width: var(--max-content);
    margin: 0 auto;
  }
  .faq-hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
    max-width: 22ch;
  }
  .faq-hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    max-width: 50ch;
    line-height: 1.5;
  }

  .faq-body { background: var(--surface); }

  .faq-item {
    border-top: 1px solid var(--hairline);
    padding: var(--space-4) 0;
    max-width: 70ch;
  }
  .faq-item:last-of-type { border-bottom: 1px solid var(--hairline); }
  .faq-item__q {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
    scroll-margin-top: var(--space-4);
  }
  .faq-item__a p,
  .faq-item__a ul {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-2);
  }
  .faq-item__a ul {
    padding-left: 1.25rem;
  }
  .faq-item__a li {
    margin-bottom: 0.4rem;
  }
  .faq-item__a a {
    color: var(--ink-blue);
    border-bottom: 1px solid currentColor;
  }
  .faq-item__a code {
    font-family: var(--font-code);
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  .faq-extend {
    margin-top: var(--space-5);
    font-size: 0.95rem;
    color: var(--mid-ink);
    max-width: 60ch;
  }
  .faq-extend a {
    color: var(--ink-blue);
    border-bottom: 1px solid currentColor;
  }
</style>
