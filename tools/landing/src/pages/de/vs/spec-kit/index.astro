---
// /de/vs/spec-kit/ — SpecScore vs GitHub Spec Kit comparison.
// Honest, factual, side-by-side. Spec Kit is a workflow/methodology;
// SpecScore is the artifact format it can target. They compose.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterDe from '../../../../components/SiteFooterDe.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="de"
  title="SpecScore vs Spec Kit — Ehrlicher Vergleich."
  description="Ein sachlicher, direkter Vergleich von SpecScore und GitHub Spec Kit: Workflow vs. Format, Linting, Lebenszyklus, Rückverfolgbarkeit und CLI. Sie ergänzen sich — hier erfahren Sie wie."
  canonical="https://specscore.md/de/vs/spec-kit/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/de/vs/" class="xref">Vergleiche</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs Spec Kit
        </h1>
        <p class="hero__sub">
          Sie operieren auf unterschiedlichen Ebenen. Spec Kit ist ein <strong>Workflow</strong> —
          ein geführter Prozess, der einen Agenten von der Idee bis zur Implementierung leitet.
          SpecScore ist das <strong>Format</strong>, in dem Spezifikationen geschrieben werden, plus ein CLI,
          das sie lintet, abfragt und zurückverfolgt. Spec Kit kann SpecScore-Dateien erzeugen.
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Was sie gemeinsam haben.</h2>
        <ul class="shared-list">
          <li>Derselbe Leitstern — Spezifikationen vor Code, mit KI-Agenten als erstklassigen Lesern.</li>
          <li>Spezifikationen liegen als Markdown in Ihrem Repository — versionskontrolliert, in PRs überprüfbar.</li>
          <li>Beide sind Open Source unter der MIT-Lizenz.</li>
          <li>Beide richten sich an Claude Code, Cursor, Copilot und weitere KI-Coding-Agenten.</li>
        </ul>
      </div>
    </section>

    {/* ── What Spec Kit does well ── */}
    <section class="section" aria-labelledby="speckit-title">
      <div class="section-inner section-inner--prose">
        <h2 id="speckit-title" class="section-title">Was Spec Kit gut macht.</h2>
        <p class="section-note">
          <a href="https://github.com/github/spec-kit" rel="nofollow noopener" target="_blank" class="xref">Spec Kit</a>
          ist ein Workflow für spezifikationsgetriebene Entwicklung von GitHub Next.
        </p>

        <div class="credit-card">
          <h3 class="credit-card__title">Ein vollständiger, meinungsstarker Prozess</h3>
          <p class="credit-card__desc">
            Spec Kit bietet den gesamten Bogen:
            <code>constitution → specify → plan → tasks → implement</code>.
            Jeder Schritt hat einen Slash-Befehl und Prompts, die den Agenten
            auf Kurs halten. Wenn Sie einen Prozess suchen, liefert Spec Kit ihn.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Starke Verbreitung und Bekanntheit</h3>
          <p class="credit-card__desc">
            Unterstützt von GitHub Next, mit einer großen Community und einer wachsenden Bibliothek an
            Erweiterungen. Für viele Entwickler ist Spec Kit der erste spezifikationsbasierte Workflow,
            dem sie begegnen.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Agenten-agnostische Befehle</h3>
          <p class="credit-card__desc">
            Die Befehle von Spec Kit funktionieren in Claude Code, Cursor, Copilot und mehr —
            der Workflow steuert den Agenten unabhängig davon, welches Tool Sie ausführen.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Feature-Vergleich.</h2>
        <p class="section-note">
          Diese Werkzeuge beantworten unterschiedliche Fragen, daher vergleicht die Tabelle Rollen, nicht Gewinner.
        </p>

        <div class="table-wrap">
          <table class="compare-table" aria-label="Feature-Vergleich SpecScore vs Spec Kit">
            <thead>
              <tr>
                <th scope="col">Fähigkeit</th>
                <th scope="col">Spec Kit</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Hauptrolle</td>
                <td>Workflow / Methodik</td>
                <td><strong>Speicherformat + CLI</strong></td>
              </tr>
              <tr>
                <td>Spezifikations-Ausgabe</td>
                <td>Freies Markdown</td>
                <td><strong>Markdown + YAML-Frontmatter</strong> (strukturiert)</td>
              </tr>
              <tr>
                <td>Spezifikations-Linting</td>
                <td>Keines</td>
                <td><strong>Inhaltsqualität</strong> — vage Verben, fehlende ACs, hängende Referenzen</td>
              </tr>
              <tr>
                <td>Anforderungs- / AC-IDs</td>
                <td>Keine</td>
                <td><strong>Maschinenadressierbare IDs</strong> (<code>REQ: slug</code>)</td>
              </tr>
              <tr>
                <td>Lebenszyklus-Status</td>
                <td>Implizit (Workflow-Schritt)</td>
                <td><strong>Durchgesetzt</strong> — Draft → Approved → Implementing → Stable → Deprecated</td>
              </tr>
              <tr>
                <td>Code-zu-Spezifikation-Rückverfolgbarkeit</td>
                <td>Keine</td>
                <td><strong><code>specscore:</code>-Annotationen</strong> + <code>Verifies:</code>-Commit-Trailer</td>
              </tr>
              <tr>
                <td>Spezifikationen über CLI abfragen</td>
                <td>Scaffolding (<code>specify</code>, <code>plan</code>, <code>tasks</code>)</td>
                <td><strong>Abfrage-API</strong> — <code>feature list / show / deps</code>, <code>lint</code>, <code>code refs</code></td>
              </tr>
              <tr>
                <td>Laufzeitabhängigkeit</td>
                <td>Python</td>
                <td><strong>Keine</strong> — einzelnes Go-Binary</td>
              </tr>
              <tr>
                <td>CI-Integration</td>
                <td>Workflow ausführen</td>
                <td><strong><code>specscore lint</code></strong> beendet sich mit Non-Zero-Code, Pre-Commit-Hooks</td>
              </tr>
              <tr>
                <td>Beziehung</td>
                <td colspan="2"><strong>Ergänzen sich</strong> — Spec Kit kann SpecScore-Dateien erzeugen</td>
              </tr>
              <tr>
                <td>Lizenz</td>
                <td>MIT</td>
                <td>MIT</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore goes further ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">Was SpecScore ergänzt.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">Die Ausgabe ist lintbar</h3>
            <p class="diff-card__desc">
              Spec Kit erzeugt freies Markdown — gut oder schlecht, es wird ausgeliefert.
              SpecScore prüft das Ergebnis in zwei Schichten: <code>lint</code>
              prüft deterministisch, dass jede Anforderung Akzeptanzkriterien besitzt,
              dass die Querverweise aufgelöst werden und dass Statusübergänge gültig sind — und ein KI-Reviewer
              (<code>/review</code>, <code>/score</code>) fängt mehrdeutige Kriterien
              und vage Verben ab.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> link  <span class="dim">"Related Feature: discount-tiers" not found</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Die Ausgabe ist abfragbar</h3>
            <p class="diff-card__desc">
              Spec Kit schreibt Dateien; sie wieder zu lesen bedeutet, sie zu öffnen. Die Spezifikationen von SpecScore
              beantworten Fragen über das CLI: <code>specscore feature list</code>,
              <code>feature deps</code>, <code>code refs</code> — so navigiert ein Agent
              den Spezifikationsgraphen, ohne jede Datei im Repository einzeln einzulesen.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Jede Anforderung hat eine ID</h3>
            <p class="diff-card__desc">
              Spec Kit referenziert Anforderungen über Prosa. SpecScore vergibt slug-basierte IDs
              (<code>REQ: slug-format</code>) und AC-IDs, die Umbenennungen,
              Refactorings und Übergaben zwischen Agenten überstehen.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Der Lebenszyklus wird durchgesetzt</h3>
            <p class="diff-card__desc">
              In Spec Kit ist die Phase einer Spezifikation der aktuelle Schritt im Workflow.
              In SpecScore ist der Lebenszyklus ein durchgesetztes Statusfeld — Draft → Approved
              → Implementing → Stable → Deprecated — validiert durch Linting und geändert
              mit <code>specscore change-status</code> über Git-Hooks oder CI.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Code lässt sich zurück zu Spezifikationen verfolgen</h3>
            <p class="diff-card__desc">
              Spec Kit bietet keinen Rückverfolgbarkeitsmechanismus. SpecScore besitzt
              Quellcode-Annotationen <code>specscore:</code> und Commit-Trailer <code>Verifies:</code>
              — führen Sie <code>specscore code refs</code> für eine deterministische Antwort
              auf „Welcher Code implementiert diese Anforderung?“ aus.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Keine Laufzeitabhängigkeit</h3>
            <p class="diff-card__desc">
              SpecScore ist ein einzelnes Go-Binary — keine Laufzeitumgebung zu installieren.
              Es funktioniert in Go-, Rust-, Python-, Java- oder JavaScript-Projekten,
              ohne die Toolchain zu belasten.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Wann Sie welches Werkzeug nutzen sollten.</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Greifen Sie zu Spec Kit, wenn…</h3>
            <ul class="when-card__list">
              <li>Sie einen geführten, meinungsstarken Prozess von der Idee bis zur Implementierung suchen.</li>
              <li>Ihr Team die Disziplin expliziter specify / plan / tasks-Schritte benötigt.</li>
              <li>Sie standardisieren möchten, wie Agenten im gesamten Team gesteuert werden.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Nutzen Sie SpecScore, wenn…</h3>
            <ul class="when-card__list">
              <li>Sie Spezifikationen brauchen, die Agenten linten, abfragen und modifizieren können, ohne jede Datei einzeln zu lesen.</li>
              <li>Sie Code-zu-Spezifikation-Rückverfolgbarkeit mit deterministischer Antwort benötigen.</li>
              <li>Sie ein großes System mit vielen Features und Lebenszyklus-Übergängen entwickeln.</li>
              <li>Sie null Laufzeitabhängigkeiten möchten — ein Binary, keine Sprach-Toolchain erforderlich.</li>
              <li>Sie Spezifikations-Qualitäts-Gates in CI benötigen, die mit Non-Zero-Exit-Code abbrechen, wie ESLint oder <code>go vet</code>.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── The integration opportunity ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">SpecScore erweitert Spec Kit — es ersetzt es nicht.</h2>
        <p class="prose-p">
          Spec Kit ist der Prozess zur Erstellung einer Spezifikation; SpecScore ist das Format,
          in dem diese Spezifikation abgelegt werden kann. Eine Spec-Kit-Erweiterung, die das SpecScore-Format
          ausgibt, ist in Arbeit — führen Sie den Workflow von Spec Kit aus und erhalten Sie Spezifikationen, die sich anschließend linten,
          abfragen und zurückverfolgen lassen.
        </p>
        <p class="prose-p">
          Wählen Sie Spec Kit für den Prozess. Wählen Sie SpecScore für das Artefakt. Nutzen Sie beides,
          wenn Sie beides wollen.
        </p>
      </div>
    </section>

    <ComparisonFeedback page="spec-kit" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Spezifikationen, die bestehen.</h2>
      <div class="final-cta__buttons">
        <a href="/de/cli/install/" class="btn btn--primary">CLI installieren</a>
        <a href="/de/ai/specstudio-skills/" class="btn btn--secondary">KI-Skills für Ihren Agenten holen</a>
        <a
          href="https://github.com/specscore/specscore"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          Open-Source auf GitHub
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterDe />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__breadcrumb {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Shared list ── */
  .shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shared-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }
  .shared-list li::before {
    content: '=';
    position: absolute;
    left: 0;
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pale-ink);
  }

  /* ── Section note ── */
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }

  /* ── Credit cards ── */
  .credit-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .credit-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .credit-card__desc {
    color: var(--mid-ink);
    line-height: 1.6;
    font-size: var(--fs-body);
  }
  .credit-card__desc code {
    font-size: 0.9em;
    background: var(--cream);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Feature comparison table ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .compare-table td:nth-child(2),
  .compare-table td:nth-child(3) {
    min-width: 200px;
  }
  .compare-table td code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .compare-table strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* ── Diff grid ── */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .diff-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .diff-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .diff-card__desc {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .diff-card__desc code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .diff-card__example {
    margin-top: var(--space-2);
  }
  .diff-card__example .terminal {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .diff-grid { grid-template-columns: 1fr; }
  }

  /* ── When to use which ── */
  .when-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .when-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .when-card--primary {
    border-color: var(--validator-green);
    border-width: 2px;
  }
  .when-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .when-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .when-card__list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
    font-size: var(--fs-small);
  }
  .when-card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--pale-ink);
    font-family: var(--font-code);
  }
  .when-card--primary .when-card__list li::before {
    color: var(--validator-green);
  }
  .when-card__list code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; }
  }

  /* ── Integration section ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-2);
  }
  .prose-p:last-child {
    margin-bottom: 0;
    font-weight: 500;
    color: var(--ink);
  }
  .prose-p code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    text-align: center;
  }
  .final-cta__title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .final-cta__buttons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
