---
// /de/vs/plain-markdown/ — SpecScore vs plain Markdown / Notion / Jira (the default).
// The default is the hardest competitor. Don't fight it head-on —
// position SpecScore as what your existing Markdown specs can graduate to.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterDe from '../../../../components/SiteFooterDe.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="de"
  title="SpecScore vs Plain Markdown — Ehrlicher Vergleich."
  description="Ein sachlicher Vergleich von SpecScore und dem Standard: Ad-hoc-Markdown, Notion und Jira-Tickets. Dasselbe Markdown, plus die Struktur, die Agenten linten, abfragen und zurückverfolgen können."
  canonical="https://specscore.md/de/vs/plain-markdown/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/de/vs/" class="xref">Vergleiche</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs Plain Markdown
        </h1>
        <p class="hero__sub">
          Die meisten Teams haben bereits „Spezifikationen“ — als Ad-hoc-Markdown in einem Docs-Ordner, Notion-Seiten oder Jira-Tickets. Es ist kostenlos, bereits vorhanden und funktioniert. SpecScore ist das <strong>selbe Markdown</strong>, plus die Struktur, die ein KI-Agent linten, abfragen und bis zum Code zurückverfolgen kann.
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Was sie gemeinsam haben.</h2>
        <ul class="shared-list">
          <li>Es ist in jedem Fall Markdown — reiner Text, für Menschen lesbar, diff-freundlich.</li>
          <li>Spezifikationen können im Repository leben, mit Versionskontrolle und PR-Reviews.</li>
          <li>Kein proprietäres Format, kein Lock-in — Sie können es in jedem Editor lesen.</li>
          <li>Sie schreiben weiterhin Fließtext; SpecScore ergänzt Struktur um den Text herum, ersetzt ihn nicht.</li>
        </ul>
      </div>
    </section>

    {/* ── What plain Markdown does well ── */}
    <section class="section" aria-labelledby="default-title">
      <div class="section-inner section-inner--prose">
        <h2 id="default-title" class="section-title">Was der Standard gut macht.</h2>
        <p class="section-note">
          Plain Markdown, Notion und Jira sind der tatsächliche Standard. Sie haben sich diesen Platz verdient.
        </p>

        <div class="credit-card">
          <h3 class="credit-card__title">Null Lernkurve</h3>
          <p class="credit-card__desc">
            Kein Schema, keine Pflichtfelder, kein CLI im Arbeitsablauf. Datei öffnen, losschreiben. Für eine schnelle Notiz oder ein winziges Projekt ist das genau richtig — Struktur, die man nicht braucht, ist nur Reibung.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Bereits installiert</h3>
          <p class="credit-card__desc">
            Ihr Team nutzt bereits Notion, Confluence oder einen <code>docs/</code>-Ordner. Nichts einzuführen, nichts zu migrieren. Die Option mit dem geringsten Widerstand ist die, die Sie bereits nutzen.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Universell portabel</h3>
          <p class="credit-card__desc">
            Plain Markdown lässt sich überall öffnen und überlebt jedes Tool. SpecScore baut auf genau dieser Eigenschaft auf — deshalb ist SpecScore ebenfalls Markdown und keine Datenbank.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Feature-Vergleich.</h2>
        <p class="section-note">
          Der Unterschied liegt nicht in der Datei — sondern darin, was ein Agent damit tun kann.
        </p>

        <div class="table-wrap">
          <table class="compare-table" aria-label="Feature-Vergleich SpecScore vs Plain Markdown">
            <thead>
              <tr>
                <th scope="col">Fähigkeit</th>
                <th scope="col">Plain Markdown / Notion</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Format</td>
                <td>Freies Markdown / Docs</td>
                <td><strong>Markdown + YAML-Frontmatter</strong> (strukturiert)</td>
              </tr>
              <tr>
                <td>Wo Anforderungen leben</td>
                <td>Jira, Notion, Slack, im Kopf von jemandem</td>
                <td><strong>Im Repository, direkt neben dem Code</strong></td>
              </tr>
              <tr>
                <td>„Ist diese Spezifikation vollständig?“</td>
                <td>Ein Mensch liest sie und entscheidet</td>
                <td><strong><code>specscore lint</code></strong> — automatisch</td>
              </tr>
              <tr>
                <td>Erkennung von Mehrdeutigkeiten</td>
                <td>Keine — vage Verben passieren unbemerkt</td>
                <td><strong>Vage Verben, fehlende ACs, hängende Referenzen werden markiert</strong></td>
              </tr>
              <tr>
                <td>Anforderungs- / AC-IDs</td>
                <td>Keine</td>
                <td><strong>Maschinenadressierbare IDs</strong> (<code>REQ: slug</code>)</td>
              </tr>
              <tr>
                <td>Lebenszyklus-Status</td>
                <td>Implizit, falls überhaupt erfasst</td>
                <td><strong>Durchgesetzt</strong> — Draft → Approved → Implementing → Stable</td>
              </tr>
              <tr>
                <td>Code-zu-Spezifikation-Rückverfolgbarkeit</td>
                <td>Keine</td>
                <td><strong><code>specscore:</code>-Annotationen</strong> + <code>Verifies:</code>-Trailer</td>
              </tr>
              <tr>
                <td>Agenten-Navigation</td>
                <td>Jede Datei durchlesen, um etwas zu finden</td>
                <td><strong>Spezifikationsgraph abfragen</strong> über das CLI</td>
              </tr>
              <tr>
                <td>CI-Qualitäts-Gate</td>
                <td>Keines</td>
                <td><strong><code>specscore lint</code></strong> beendet sich mit Non-Zero-Code, wie ein Linter</td>
              </tr>
              <tr>
                <td>Lernkurve</td>
                <td><strong>Keine</strong></td>
                <td>Ein Format zu lernen (inkrementell)</td>
              </tr>
              <tr>
                <td>Kosten / Lizenz</td>
                <td>Kostenlos</td>
                <td>Kostenlos, Open Source</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore goes further ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">Wo SpecScore weiter geht.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">Mehrdeutigkeit wird erkannt, nicht interpretiert</h3>
            <p class="diff-card__desc">
              Bei frei formulierten Spezifikationen beginnt jede Agenten-Interaktion mit Interpretation — „Login sollte funktionieren“ ist ein Münzwurf zwischen korrekt und plausibel-aber-falsch. Das <code>lint</code> von SpecScore markiert vage Verben und fehlende Akzeptanzkriterien, bevor ein Agent darauf aufbaut.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint auth/login.md
  <span class="mark-fail">✗</span> R1  <span class="dim">"should work" — nicht messbar</span>
  <span class="mark-fail">✗</span> R1  no acceptance criteria</pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Fehlinterpretationen summieren sich nicht mehr auf</h3>
            <p class="diff-card__desc">
              Ein Agent missversteht eine Anforderung, ein zweiter baut darauf auf, ein dritter hängt von beiden ab — und Sie bemerken es erst drei Agenten später. Strukturierte Akzeptanzkriterien geben jedem Agenten dieselben Pass/Fail-Bedingungen, sodass die Interpretation zwischen ihnen nicht driftet.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Code lässt sich zurück zur Spezifikation verfolgen</h3>
            <p class="diff-card__desc">
              Einfache Docs haben keine Verbindung zum Code, der sie implementiert. SpecScore ergänzt Quellcode-Annotationen <code>specscore:</code> und Commit-Trailer <code>Verifies:</code> — <code>specscore code refs</code> beantwortet deterministisch: „Welcher Code implementiert diese Anforderung?“
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Eine Spezifikation statt vierzig Tickets</h3>
            <p class="diff-card__desc">
              Ein neues Teammitglied (oder ein frischer Agent) liest eine Feature-Spezifikation mit vollem Kontext, statt die Intention mühsam aus vierzig Jira-Tickets und einem Slack-Thread zu rekonstruieren.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Agenten fragen ab, statt alles neu zu lesen</h3>
            <p class="diff-card__desc">
              In einem Docs-Ordner bedeutet „Was ist in Arbeit?“, Dateien durchzusehen. In SpecScore heißt es <code>specscore feature list</code> — der Spezifikationsgraph antwortet über das CLI, sodass Agenten keinen Kontext mit dem wiederholten Einlesen des Repositories verschwenden.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Qualität wird in CI durchgesetzt</h3>
            <p class="diff-card__desc">
              Frei formulierte Spezifikationen haben kein Gate — eine halb geschriebene Datei wird genauso leicht gemergt wie eine vollständige. <code>specscore lint</code> beendet sich bei Problemen mit einem Exit-Code ungleich null, genau wie ESLint oder <code>go vet</code> Ihren Code schützen.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Wann Sie welches Werkzeug nutzen sollten.</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Plain Markdown reicht aus, wenn…</h3>
            <ul class="when-card__list">
              <li>Es sich um eine einmalige Notiz, einen Spike oder ein Projekt handelt, das zu klein für zusätzliche Struktur ist.</li>
              <li>Kein KI-Agent auf Basis des Dokuments baut — ein Mensch liest es und versteht es direkt.</li>
              <li>Sie eine grobe Idee festhalten, keine Anforderung, die jemand implementieren wird.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Greifen Sie zu SpecScore, wenn…</h3>
            <ul class="when-card__list">
              <li>Ein KI-Agent auf Basis der Spezifikation baut — Mehrdeutigkeit wird zu fehlerhaftem Code.</li>
              <li>Mehrere Agenten oder Personen von denselben Anforderungen abhängen.</li>
              <li>Sie wissen müssen, welcher Code welche Anforderung implementiert.</li>
              <li>„Ist diese Spezifikation fertig?“ von einem Tool beantwortet werden sollte, nicht in einem Meeting.</li>
              <li>Das Projekt groß genug ist, dass wiederholtes Lesen aller Dokumente nicht mehr skaliert.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── The adoption path ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">Lassen Sie vorhandene Spezifikationen wachsen.</h2>
        <p class="prose-p">
          Sie müssen weder Ihr Backlog umstellen noch Ihre Tools austauschen. Wählen Sie Ihr nächstes Feature, schreiben Sie dafür eine SpecScore-Spezifikation und führen Sie <code>specscore lint</code> aus — prüfen Sie, ob es Dinge findet, die Ihr Ticket übersehen hat. Ergänzen Sie <code>specscore:</code>-Annotationen bei der Implementierung. Erweitern Sie es erst auf den nächsten Sprint, wenn es geholfen hat.
        </p>
        <p class="prose-p">
          Plain Markdown ist die Auffahrt. SpecScore ist das, wozu es sich weiterentwickelt.
        </p>
      </div>
    </section>

    <ComparisonFeedback page="plain-markdown" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Spezifikationen, die bestehen.</h2>
      <div class="final-cta__buttons">
        <a href="/de/cli/install/" class="btn btn--primary">CLI installieren</a>
        <a href="/de/ai/specstudio-skills/" class="btn btn--secondary">KI-Skills für Ihren Agenten holen</a>
        <a
          href="https://github.com/specscore/specscore"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          Open-Source auf GitHub
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterDe />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__breadcrumb {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Shared list ── */
  .shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shared-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }
  .shared-list li::before {
    content: '=';
    position: absolute;
    left: 0;
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pale-ink);
  }

  /* ── Section note ── */
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }

  /* ── Credit cards ── */
  .credit-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .credit-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .credit-card__desc {
    color: var(--mid-ink);
    line-height: 1.6;
    font-size: var(--fs-body);
  }
  .credit-card__desc code {
    font-size: 0.9em;
    background: var(--cream);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Feature comparison table ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .compare-table td:nth-child(2),
  .compare-table td:nth-child(3) {
    min-width: 200px;
  }
  .compare-table td code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .compare-table strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* ── Diff grid ── */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .diff-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .diff-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .diff-card__desc {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .diff-card__desc code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .diff-card__example {
    margin-top: var(--space-2);
  }
  .diff-card__example .terminal {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .diff-grid { grid-template-columns: 1fr; }
  }

  /* ── When to use which ── */
  .when-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .when-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .when-card--primary {
    border-color: var(--validator-green);
    border-width: 2px;
  }
  .when-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .when-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .when-card__list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
    font-size: var(--fs-small);
  }
  .when-card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--pale-ink);
    font-family: var(--font-code);
  }
  .when-card--primary .when-card__list li::before {
    color: var(--validator-green);
  }
  .when-card__list code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; }
  }

  /* ── Adoption section ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-2);
  }
  .prose-p:last-child {
    margin-bottom: 0;
    font-weight: 500;
    color: var(--ink);
  }
  .prose-p code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    text-align: center;
  }
  .final-cta__title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .final-cta__buttons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
