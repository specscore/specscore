---
// /de/vs/openspec/ — SpecScore vs OpenSpec comparison (German).
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterDe from '../../../../components/SiteFooterDe.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="de"
  title="SpecScore vs OpenSpec — Ehrlicher Vergleich."
  description="Ein sachlicher, direkter Vergleich von SpecScore und OpenSpec: Spezifikationsformat, Linting, Lebenszyklus, Rückverfolgbarkeit, CLI und Agenten-Unterstützung. Ehrlich zu beiden."
  canonical="https://specscore.md/de/vs/openspec/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/de/vs/" class="xref">Vergleiche</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs OpenSpec
        </h1>
        <p class="hero__sub">
          Beide legen Spezifikationen in Markdown direkt neben Ihrem Code ab, lesbar für KI-Agenten. Sie beantworten unterschiedliche Fragen: OpenSpec organisiert Spezifikationen und generiert Agenten-Prompts. SpecScore validiert den Inhalt von Spezifikationen, setzt Lebenszyklen durch und verfolgt Code zurück zu Anforderungen.
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Was sie gemeinsam haben.</h2>
        <ul class="shared-list">
          <li>Spezifikationen liegen als Markdown-Dateien in Ihrem Repository — versionskontrolliert, in PRs überprüfbar.</li>
          <li>Beide sind Open Source unter der MIT-Lizenz.</li>
          <li>Beide nutzen Given/When/Then-Akzeptanzkriterien.</li>
          <li>Beide behandeln KI-Agenten als erstklassige Konsumenten von Spezifikationen.</li>
        </ul>
      </div>
    </section>

    {/* ── What OpenSpec does well ── */}
    <section class="section" aria-labelledby="openspec-title">
      <div class="section-inner section-inner--prose">
        <h2 id="openspec-title" class="section-title">Was OpenSpec gut macht.</h2>

        <div class="credit-card">
          <h3 class="credit-card__title">Die breiteste Agenten-Unterstützung</h3>
          <p class="credit-card__desc">
            OpenSpec unterstützt 29 KI-Agenten über generierte Skill-Dateien — Claude, Cursor, Copilot, Gemini, Windsurf, Cline und mehr. Wenn Ihr Agent auf der Liste steht, integriert sich OpenSpec ohne Konfiguration.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Niedrige Einstiegshürde</h3>
          <p class="credit-card__desc">
            <code>npm install -g @fission-ai/openspec &amp;&amp; openspec init</code> und Sie schreiben bereits Spezifikationen. Kein Schema zu lernen, kein verpflichtendes Frontmatter. Entwickelt für Einfachheit — besonders für bestehende Projekte.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Sauberes Änderungs-Delta-Modell</h3>
          <p class="credit-card__desc">
            OpenSpecs <code>ADDED / MODIFIED / REMOVED</code>-Format zur Evolution von Spezifikationen ist durchdacht gestaltet. Jede Änderung ist ein Ordner mit einem Vorschlag, Delta-Spezifikationen und Aufgaben — ein strukturierter Weg, Modifikationen vorzuschlagen.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Feature-Vergleich.</h2>

        <div class="table-wrap">
          <table class="compare-table" aria-label="Feature-Vergleich SpecScore vs OpenSpec">
            <thead>
              <tr>
                <th scope="col">Fähigkeit</th>
                <th scope="col">OpenSpec</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Spezifikationsformat</td>
                <td>Markdown (ohne Frontmatter)</td>
                <td>Markdown + YAML-Frontmatter</td>
              </tr>
              <tr>
                <td>Spezifikations-Linting</td>
                <td>Nur Dateistruktur</td>
                <td><strong>Inhaltsqualität</strong> — vage Verben, fehlende ACs, hängende Referenzen</td>
              </tr>
              <tr>
                <td>Anforderungs-IDs</td>
                <td>Keine (über Titel referenziert)</td>
                <td><strong>Slug-basiert</strong> (<code>REQ: slug-format</code>)</td>
              </tr>
              <tr>
                <td>Akzeptanzkriterien-IDs</td>
                <td>Keine</td>
                <td><strong>Maschinenadressierbare IDs</strong></td>
              </tr>
              <tr>
                <td>Lebenszyklus-Status</td>
                <td>Implizit (Dateipfad)</td>
                <td><strong>Durchgesetzt</strong> — Draft → Under Review → Approved → Implementing → Stable → Deprecated</td>
              </tr>
              <tr>
                <td>Code-zu-Spezifikation-Rückverfolgbarkeit</td>
                <td>Keine</td>
                <td><strong><code>specscore:</code>-Annotationen</strong> + <code>Verifies:</code>-Commit-Trailer</td>
              </tr>
              <tr>
                <td>Sub-Features</td>
                <td>Nein</td>
                <td><strong>Ja</strong> (verschachtelte Verzeichnisse)</td>
              </tr>
              <tr>
                <td>Querverweise</td>
                <td>Kein formaler Mechanismus</td>
                <td><strong>Abhängigkeiten, Quell-Ideen, Plan-Referenzen</strong></td>
              </tr>
              <tr>
                <td>CI-Integration</td>
                <td>Grundlegend (<code>openspec validate</code>)</td>
                <td><strong><code>specscore lint</code></strong> mit konfigurierbarer Schärfe, Pre-Commit-Hooks</td>
              </tr>
              <tr>
                <td>Agenten-Unterstützung</td>
                <td><strong>29 Agenten</strong></td>
                <td>Claude Code als primärer Agent + CLI für beliebige Agenten</td>
              </tr>
              <tr>
                <td>Schema-Anpassung</td>
                <td><strong>Ja</strong> (<code>schema.yaml</code>, Fork/Init)</td>
                <td>Festes Schema (Konsistenz durch Design)</td>
              </tr>
              <tr>
                <td>Änderungsvorschläge</td>
                <td><strong>Delta-Modell</strong> (ADDED/MODIFIED/REMOVED)</td>
                <td>Änderungs-Ideen + Vorschläge</td>
              </tr>
              <tr>
                <td>Laufzeitabhängigkeit</td>
                <td>Node.js 20.19+</td>
                <td><strong>Keine</strong> — einzelnes Go-Binary</td>
              </tr>
              <tr>
                <td>Lizenz</td>
                <td>MIT</td>
                <td>MIT</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore goes further ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">Wo SpecScore weiter geht.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">Die Validierung reicht weit über die Dateistruktur hinaus</h3>
            <p class="diff-card__desc">
              OpenSpecs <code>validate</code> prüft die Dateistruktur — ob die Datei existiert, ob sie die richtigen Abschnitte hat. SpecScore prüft mehr, in zwei Schichten: <code>lint</code> prüft deterministisch Inhaltsbeziehungen — jede Anforderung hat Akzeptanzkriterien, Querverweise lösen sich auf, Statusübergänge sind gültig — und ein KI-Reviewer (<code>/review</code>, <code>/score</code>) erkennt, was kein Linter kann: mehrdeutige Kriterien und vage Verben.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> link  <span class="dim">"Related Feature: discount-tiers" not found</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Jede Anforderung hat eine maschinenlesbare ID</h3>
            <p class="diff-card__desc">
              OpenSpec referenziert Anforderungen nach Titeln — anfällig bei Umbenennungen. SpecScore vergibt slug-basierte IDs (<code>REQ: slug-format</code>) und AC-IDs, die Umbenennungen, Refactorings und Übergaben zwischen Agenten überstehen.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Lebenszyklen werden durchgesetzt, nicht abgeleitet</h3>
            <p class="diff-card__desc">
              In OpenSpec ist der Lebenszyklus einer Spezifikation ihr Dateipfad: <code>specs/</code> (aktuell), <code>changes/</code> (vorgeschlagen), <code>archive/</code> (abgeschlossen). In SpecScore ist der Lebenszyklus ein durchgesetztes Statusfeld — Draft → Under Review → Approved → Implementing → Stable → Deprecated — validiert durch Linting, geändert mit <code>specscore change-status</code> über Git-Hooks oder CI.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Code lässt sich zurück zu Spezifikationen verfolgen</h3>
            <p class="diff-card__desc">
              OpenSpec bietet keinen Rückverfolgbarkeitsmechanismus. SpecScore besitzt <code>specscore:</code>-Annotationen in Code-Kommentaren und <code>Verifies:</code>-Trailer in Commits. Führen Sie <code>specscore code refs</code> aus und erhalten Sie eine deterministische Antwort auf die Frage: „Welcher Code implementiert diese Anforderung?“
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Keine Laufzeitabhängigkeit</h3>
            <p class="diff-card__desc">
              OpenSpec erfordert Node.js 20.19+. SpecScore ist ein einzelnes Go-Binary — keine Laufzeitumgebung, keine <code>node_modules</code>. Es funktioniert in Go-, Rust-, Python- und Java-Projekten, ohne Node zur Toolchain hinzuzufügen.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Komponierbare Artefakt-Hierarchie</h3>
            <p class="diff-card__desc">
              Spezifikationen in OpenSpec sind flach nach Domäne organisiert. SpecScore hat eine typisierte Hierarchie: Ideen werden zu Features befördert, Features enthalten Anforderungen und ACs, Pläne referenzieren ACs, Tasks referenzieren Pläne. Alle Beziehungen sind über das CLI maschinell navigierbar.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Wann Sie welches Werkzeug nutzen sollten.</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Starten Sie mit OpenSpec, wenn…</h3>
            <ul class="when-card__list">
              <li>Sie Cursor, Copilot oder andere Nicht-Claude-Agenten nutzen und eine sofort einsatzbereite Integration benötigen.</li>
              <li>Sie zum ersten Mal Spezifikationen zu einer bestehenden Codebasis hinzufügen und null Reibung wollen.</li>
              <li>Ihr Team Schema-Flexibilität höher bewertet als strikte Durchsetzung.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Nutzen Sie SpecScore, wenn…</h3>
            <ul class="when-card__list">
              <li>Sie Spezifikations-Qualitätskontrolle brauchen — Linting fängt Mehrdeutigkeiten ab, bevor Agenten Tokens dafür verschwenden.</li>
              <li>Sie Code-zu-Spezifikation-Rückverfolgbarkeit benötigen — „Welcher Code implementiert diese Anforderung?“ liefert eine deterministische Antwort.</li>
              <li>Sie ein großes System mit vielen Features, Sub-Features und Lebenszyklus-Übergängen aufbauen.</li>
              <li>Sie null Laufzeitabhängigkeiten wollen — ein Binary, kein Node.js erforderlich.</li>
              <li>Sie Spezifikations-Qualitäts-Gates in CI benötigen — <code>specscore lint</code> beendet sich bei Fehlern mit Non-Zero-Exit-Code, genau wie ESLint oder <code>go vet</code>.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── The integration opportunity ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">Sie schließen sich nicht gegenseitig aus.</h2>
        <p class="prose-p">
          SpecScore kann OpenSpecs <code>spec.md</code>-Dateien linten. Teams, die mit OpenSpec beginnen, können die Qualitätsschicht von SpecScore hinzufügen, ohne zu migrieren — validieren Sie Spezifikationen, die Sie bereits haben, ergänzen Sie Rückverfolgbarkeit nach Bedarf und setzen Sie Lebenszyklen durch, wenn Ihr Team wächst.
        </p>
        <p class="prose-p">
          OpenSpec ist eine gute Auffahrt. SpecScore ist die Leitplanke.
        </p>
      </div>
    </section>

    <ComparisonFeedback page="openspec" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Spezifikationen, die bestehen.</h2>
      <div class="final-cta__buttons">
        <a href="/de/cli/install/" class="btn btn--primary">CLI installieren</a>
        <a href="/de/ai/specstudio-skills/" class="btn btn--secondary">KI-Skills für Ihren Agenten holen</a>
        <a href="https://github.com/specscore/specscore" rel="noopener" class="btn btn--tertiary">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" /></svg>
          Open-Source auf GitHub
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterDe />
</BaseLayout>

<style>
  .hero { padding: var(--space-6) var(--space-3) var(--space-5); background: var(--cream); }
  .hero__inner { max-width: var(--max-prose); margin: 0 auto; animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms; }
  .hero__breadcrumb { font-family: var(--font-code); font-size: var(--fs-small); color: var(--pale-ink); margin-bottom: var(--space-2); }
  .hero__headline { font-size: var(--fs-hero); font-weight: 700; line-height: 1.04; letter-spacing: -0.02em; margin-bottom: var(--space-3); }
  .hero__sub { font-size: 1.125rem; color: var(--mid-ink); line-height: 1.55; max-width: 52ch; }
  @keyframes fade-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .section-title { font-size: var(--fs-h2); font-weight: 700; letter-spacing: -0.01em; margin-bottom: var(--space-3); }
  .shared-list { list-style: none; margin: 0; padding: 0; }
  .shared-list li { position: relative; padding-left: 1.4rem; color: var(--mid-ink); line-height: 1.6; margin-bottom: var(--space-1); }
  .shared-list li::before { content: '='; position: absolute; left: 0; font-family: var(--font-code); font-weight: 700; color: var(--pale-ink); }
  .credit-card { background: var(--surface); border: 1px solid var(--hairline); padding: var(--space-3); margin-bottom: var(--space-2); }
  .credit-card__title { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-1); }
  .credit-card__desc { color: var(--mid-ink); line-height: 1.6; font-size: var(--fs-body); }
  .credit-card__desc code { font-size: 0.9em; background: var(--cream); padding: 0.05em 0.3em; border-radius: 2px; }
  .table-section { background: var(--cream-2); }
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .compare-table { width: 100%; border-collapse: collapse; font-size: var(--fs-small); line-height: 1.5; }
  .compare-table th, .compare-table td { text-align: left; padding: 0.65rem 0.85rem; border-bottom: 1px solid var(--hairline); vertical-align: top; }
  .compare-table thead th { font-family: var(--font-display); font-weight: 600; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--mid-ink); border-bottom: 2px solid var(--graphite); white-space: nowrap; }
  .compare-table td:first-child { font-weight: 500; white-space: nowrap; min-width: 160px; }
  .compare-table td:nth-child(2), .compare-table td:nth-child(3) { min-width: 200px; }
  .compare-table td code { font-size: 0.88em; background: var(--surface); padding: 0.05em 0.3em; border-radius: 2px; }
  .compare-table strong { font-weight: 600; color: var(--ink); }
  .diff-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
  .diff-card { background: var(--surface); border: 1px solid var(--hairline); padding: var(--space-3); }
  .diff-card__title { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-1); }
  .diff-card__desc { color: var(--mid-ink); font-size: var(--fs-small); line-height: 1.6; }
  .diff-card__desc code { font-size: 0.9em; background: var(--cream-2); padding: 0.05em 0.3em; border-radius: 2px; }
  .diff-card__example { margin-top: var(--space-2); }
  .diff-card__example .terminal { font-size: 0.78rem; line-height: 1.6; }
  @media (max-width: 860px) { .diff-grid { grid-template-columns: 1fr; } }
  .when-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
  .when-card { background: var(--surface); border: 1px solid var(--hairline); padding: var(--space-4); }
  .when-card--primary { border-color: var(--validator-green); border-width: 2px; }
  .when-card__title { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-2); }
  .when-card__list { list-style: none; margin: 0; padding: 0; }
  .when-card__list li { position: relative; padding-left: 1.2rem; color: var(--mid-ink); line-height: 1.6; margin-bottom: var(--space-1); font-size: var(--fs-small); }
  .when-card__list li::before { content: '→'; position: absolute; left: 0; color: var(--pale-ink); font-family: var(--font-code); }
  .when-card--primary .when-card__list li::before { color: var(--validator-green); }
  .when-card__list code { font-size: 0.9em; background: var(--cream-2); padding: 0.05em 0.3em; border-radius: 2px; }
  @media (max-width: 860px) { .when-grid { grid-template-columns: 1fr; } }
  .prose-p { color: var(--mid-ink); line-height: 1.65; margin-bottom: var(--space-2); }
  .prose-p:last-child { margin-bottom: 0; font-weight: 500; color: var(--ink); }
  .prose-p code { font-size: 0.9em; background: var(--cream-2); padding: 0.05em 0.3em; border-radius: 2px; }
  .final-cta { background: var(--cream-2); padding: var(--space-7) var(--space-3); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .final-cta__inner { max-width: var(--max-content); margin: 0 auto; text-align: center; }
  .final-cta__title { font-size: clamp(2.2rem, 4.2vw, 3.2rem); margin-bottom: var(--space-4); letter-spacing: -0.02em; line-height: 1.05; }
  .final-cta__buttons { display: inline-flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
</style>
