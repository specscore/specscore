---
// /de/vs/datarim/ — SpecScore vs Datarim comparison.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterDe from '../../../../components/SiteFooterDe.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="de"
  title="SpecScore vs Datarim — Ehrlicher Vergleich."
  description="Ein objektiver Vergleich von SpecScore und Datarim: Workflow-Pack für Claude Code vs. offenes, portables Spezifikationsformat. Unterschiedliche Schichten – und miteinander kombinierbar."
  canonical="https://specscore.md/de/vs/datarim/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/de/vs/" class="xref">Vergleiche</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs Datarim
        </h1>
        <p class="hero__sub">
          Unterschiedliche Schichten. Datarim ist ein meinungsstarkes <strong>Workflow-Pack</strong> für
          Claude Code – Slash-Befehle, die ein Projekt von Anforderungen bis zum
          Abschluss führen. SpecScore ist das <strong>offene Format</strong>, in dem Spezifikationen geschrieben werden,
          plus eine CLI zum Linten, Abfragen und Nachverfolgen. Ein Workflow kann darauf aufbauen.
        </p>
      </div>
    </section>

    {/* ── Was sie gemeinsam haben ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Was sie gemeinsam haben.</h2>
        <ul class="shared-list">
          <li>Beide bringen strukturierte Methodik in die KI-gestützte Entwicklung.</li>
          <li>Beide sind Open Source unter der MIT-Lizenz.</li>
          <li>Beide laufen in Claude Code – Datarim als Befehle, SpecScore über SpecStudio Skills.</li>
          <li>Beide halten ihren Zustand als versioniertes Markdown im Repository.</li>
        </ul>
      </div>
    </section>

    {/* ── Was Datarim gut macht ── */}
    <section class="section" aria-labelledby="datarim-title">
      <div class="section-inner section-inner--prose">
        <h2 id="datarim-title" class="section-title">Was Datarim gut macht.</h2>
        <p class="section-note">
          <a href="https://github.com/Arcanada-one/datarim" rel="nofollow noopener" target="_blank" class="xref">Datarim</a>
          ist ein universelles, iteratives Workflow-Framework für Claude Code.
        </p>

        <div class="credit-card">
          <h3 class="credit-card__title">Native Slash-Command-UX</h3>
          <p class="credit-card__desc">
            Eine vollständige Pipeline als Befehle – <code>/dr-prd</code>, <code>/dr-plan</code>,
            <code>/dr-design</code>, <code>/dr-do</code>, <code>/dr-qa</code> –, die sich
            in Claude Code wie zu Hause anfühlen. Ein <code>install.sh</code> nach <code>~/.claude/</code>
            und es geht los.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Komplexitätsbewusstes Routing (L1–L4)</h3>
          <p class="credit-card__desc">
            Datarim schätzt den Umfang ab und steuert entsprechend: Ein schneller L1-Fix überspringt
            die Planung, während eine größere L4-Änderung eine phasenbasierte Pipeline mit mehreren
            Review-Schleifen durchläuft. Die Zeremonie an den Umfang anzupassen, ist eine hervorragende Idee.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Consilium und Multi-Domain-Reichweite</h3>
          <p class="credit-card__desc">
            Sein „Consilium“ versammelt ein Gremium von Agenten, um Kompromisse zu diskutieren, bevor
            eine Entscheidung empfohlen wird. Und das nicht nur für Software – Datarim zielt auch auf
            Recherche-, Rechts- und Content-Workflows ab.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature-Vergleichstabelle ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Feature-Vergleich.</h2>
        <p class="section-note">
          Das eine ist ein Workflow, das andere ein Format – die Tabelle vergleicht Rollen, keine Gewinner.
        </p>

        <div class="table-wrap">
          <table class="compare-table" aria-label="Feature-Vergleich SpecScore vs Datarim">
            <thead>
              <tr>
                <th scope="col">Fähigkeit</th>
                <th scope="col">Datarim</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Hauptrolle</td>
                <td>Workflow-Pack für Claude Code</td>
                <td><strong>Offenes Spezifikationsformat + CLI</strong></td>
              </tr>
              <tr>
                <td>Läuft als</td>
                <td>Slash-Befehle (<code>/dr-*</code>)</td>
                <td>Formatdateien + CLI <span class="dim">(+ SpecStudio Skills in Claude Code)</span></td>
              </tr>
              <tr>
                <td>Zustandsspeicherung</td>
                <td><code>backlog.md</code> + <code>CLAUDE.md</code> (workflow-förmig)</td>
                <td><strong>Portabler <code>spec/</code>-Baum</strong> (Markdown + YAML)</td>
              </tr>
              <tr>
                <td>Überdauert ohne das Tool</td>
                <td>An die Datarim-Laufzeit gebunden</td>
                <td><strong>Ja</strong> – portabel durch Design</td>
              </tr>
              <tr>
                <td>Spezifikations-Linting</td>
                <td>Keines</td>
                <td><strong>Inhaltliche Qualität</strong> – vage Verben, fehlende ACs, tote Referenzen</td>
              </tr>
              <tr>
                <td>Anforderungs- / AC-IDs</td>
                <td>Keine</td>
                <td><strong>Maschinenadressierbare IDs</strong> (<code>REQ: slug</code>)</td>
              </tr>
              <tr>
                <td>Code-zu-Spezifikation-Rückverfolgbarkeit</td>
                <td>Keine</td>
                <td><strong><code>specscore:</code>-Annotationen</strong> + <code>Verifies:</code>-Trailer</td>
              </tr>
              <tr>
                <td>Komplexitäts-Routing (L1–L4)</td>
                <td><strong>Ja</strong></td>
                <td>Nein (Format, kein Workflow)</td>
              </tr>
              <tr>
                <td>Abfragbarer Spezifikations-Graph</td>
                <td>Nein</td>
                <td><strong>Ja</strong> – <code>feature list / show / deps</code></td>
              </tr>
              <tr>
                <td>An Claude Code gebunden</td>
                <td>Dafür gebaut</td>
                <td><strong>Nein</strong> – jeder Agent oder keiner</td>
              </tr>
              <tr>
                <td>Lizenz</td>
                <td>MIT</td>
                <td>MIT / CC BY 4.0</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Was SpecScore hinzufügt ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">Was SpecScore hinzufügt.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">Das Ergebnis überdauert den Workflow</h3>
            <p class="diff-card__desc">
              Der Zustand von Datarim lebt im eigenen Backlog und im <code>CLAUDE.md</code>-Format –
              wertvoll, solange du Datarim nutzt. SpecScore-Spezifikationen sind ein portables Format, das
              lesbar, lintbar und abfragbar bleibt, ganz ohne installierte SpecScore-Tools.
              Der Workflow kann sich ändern; die Spezifikationen bleiben dir erhalten.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Spezifikationen sind lintbar</h3>
            <p class="diff-card__desc">
              Ein Workflow leitet die Erstellung an, prüft aber nicht das Ergebnis. Das
              <code>lint</code> von SpecScore prüft, ob jede Anforderung Akzeptanzkriterien besitzt,
              Querverweise auflösen und Statusübergänge gültig sind.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> link  <span class="dim">"Related Feature: discount-tiers" not found</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Code lässt sich auf Spezifikationen zurückführen</h3>
            <p class="diff-card__desc">
              SpecScore fügt Quellcode-Annotationen <code>specscore:</code> und
              Commit-Trailer <code>Verifies:</code> hinzu – <code>specscore code refs</code>
              beantwortet deterministisch: „Welcher Code implementiert diese Anforderung?“,
              unabhängig davon, welcher Workflow die Spezifikation erzeugt hat.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Nicht an einen einzelnen Agenten gebunden</h3>
            <p class="diff-card__desc">
              Datarim ist für Claude Code gebaut. SpecScore ist ein Format, das jeder Agent lesen kann,
              und eine Go-Binärdatei, die jede CI ausführen kann – ohne Claude Code,
              ohne <code>~/.claude/</code>-Installation.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── Wann du was nutzt ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Wann du was nutzt.</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Greife zu Datarim, wenn…</h3>
            <ul class="when-card__list">
              <li>Du heute eine vollständige, meinungsstarke Pipeline in Claude Code willst.</li>
              <li>Du komplexitätsbewusstes Routing und Multi-Agenten-Entscheidungsrituale schätzt.</li>
              <li>Deine Arbeit mehrere Domänen umfasst – Recherche, Recht, Content, nicht nur Code.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Nutze SpecScore, wenn…</h3>
            <ul class="when-card__list">
              <li>Du Spezifikationen willst, die jeden einzelnen Workflow oder jedes Tool überdauern.</li>
              <li>Du Linting, IDs, Lebenszyklus und Code-zu-Spezifikation-Rückverfolgbarkeit brauchst.</li>
              <li>Du mit verschiedenen Agenten – oder gar keinem – arbeitest, nicht nur mit Claude Code.</li>
              <li>Du eine CLI willst, die Agenten abfragen können, statt das Repository neu zu lesen.</li>
              <li>Du Spezifikations-Qualitäts-Gates in der CI brauchst, die mit Exit-Code ungleich null abbrechen.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── Zwei Packs, ein Format ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">Zwei Workflow-Packs, ein offenes Format.</h2>
        <p class="prose-p">
          Datarim und SpecStudio Skills sind beides meinungsstarke Workflows für Claude
          Code. SpecScore ist das zugrunde liegende offene Format – das Artefakt, das ein Workflow
          erzeugen kann, damit Spezifikationen nach Abschluss der Pipeline portabel, lintbar und nachverfolgbar
          bleiben. Ein Datarim, das SpecScore ausgibt, würde seine UX behalten und ein dauerhaftes Ausgabeformat gewinnen.
        </p>
        <p class="prose-p">
          Wähle Datarim für die Pipeline. Nutze SpecScore für das Artefakt, das sie hinterlässt.
        </p>
      </div>
    </section>

    <ComparisonFeedback page="datarim" />
  </main>

  {/* ── Finaler CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Spezifikationen, die bestehen.</h2>
      <div class="final-cta__buttons">
        <a href="/de/cli/install/" class="btn btn--primary">CLI installieren</a>
        <a href="/de/ai/specstudio-skills/" class="btn btn--secondary">KI-Skills für deinen Agenten</a>
        <a
          href="https://github.com/specscore/specscore"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          Open-Source auf GitHub
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterDe />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__breadcrumb {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Shared list ── */
  .shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shared-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }
  .shared-list li::before {
    content: '=';
    position: absolute;
    left: 0;
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pale-ink);
  }

  /* ── Section note ── */
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }

  /* ── Credit cards ── */
  .credit-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .credit-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .credit-card__desc {
    color: var(--mid-ink);
    line-height: 1.6;
    font-size: var(--fs-body);
  }
  .credit-card__desc code {
    font-size: 0.9em;
    background: var(--cream);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Feature comparison table ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .compare-table td:nth-child(2),
  .compare-table td:nth-child(3) {
    min-width: 200px;
  }
  .compare-table td code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .compare-table strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* ── Diff grid ── */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .diff-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .diff-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .diff-card__desc {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .diff-card__desc code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .diff-card__example {
    margin-top: var(--space-2);
  }
  .diff-card__example .terminal {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .diff-grid { grid-template-columns: 1fr; }
  }

  /* ── When to use which ── */
  .when-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .when-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .when-card--primary {
    border-color: var(--validator-green);
    border-width: 2px;
  }
  .when-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .when-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .when-card__list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
    font-size: var(--fs-small);
  }
  .when-card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--pale-ink);
    font-family: var(--font-code);
  }
  .when-card--primary .when-card__list li::before {
    color: var(--validator-green);
  }
  .when-card__list code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; }
  }

  /* ── Bridge section ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-2);
  }
  .prose-p:last-child {
    margin-bottom: 0;
    font-weight: 500;
    color: var(--ink);
  }
  .prose-p code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    text-align: center;
  }
  .final-cta__title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .final-cta__buttons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
