---
// /de/vs/codespeak/ — SpecScore vs CodeSpeak comparison.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterDe from '../../../../components/SiteFooterDe.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="de"
  title="SpecScore vs CodeSpeak — Ehrlicher Vergleich."
  description="Ein objektiver Direktvergleich zwischen SpecScore und CodeSpeak: Spezifikation-als-Quelle vs. Spezifikation-als-Vertrag, Codegenerierung, Portabilität, Linting und Rückverfolgbarkeit."
  canonical="https://specscore.md/de/vs/codespeak/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/de/vs/" class="xref">Vergleiche</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs CodeSpeak
        </h1>
        <p class="hero__sub">
          Zwei Antworten auf die Frage, wozu Spezifikationen dienen sollten. CodeSpeak behandelt die Spezifikation als
          <strong>Quellcode</strong> – ein LLM kompiliert sie, und du pflegst die Spezifikation
          statt des Codes. SpecScore behandelt die Spezifikation als einen <strong>offenen,
          dauerhaften Vertrag</strong> – du behältst deinen Code, und jeder Agent (oder gar keiner) kann sie lesen,
          linten und nachverfolgen.
        </p>
      </div>
    </section>

    {/* ── Was sie gemeinsam haben ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Was sie gemeinsam haben.</h2>
        <ul class="shared-list">
          <li>Beide stellen die Spezifikation in das Zentrum der Softwareentwicklung.</li>
          <li>Beide sind für eine KI-gestützte Welt gebaut – Absicht vor Implementierung.</li>
          <li>Beide wollen Software leichter anpassbar machen, indem man die Spezifikation ändert.</li>
        </ul>
      </div>
    </section>

    {/* ── Was CodeSpeak gut macht ── */}
    <section class="section" aria-labelledby="codespeak-title">
      <div class="section-inner section-inner--prose">
        <h2 id="codespeak-title" class="section-title">Was CodeSpeak gut macht.</h2>
        <p class="section-note">
          <a href="https://codespeak.dev/" rel="nofollow noopener" target="_blank" class="xref">CodeSpeak</a>
          ist ein LLM-basiertes Programmiersystem, das Spezifikationen in strukturiertem Englisch zu Code kompiliert.
        </p>

        <div class="credit-card">
          <h3 class="credit-card__title">Eine kühne These, fundiert vorgetragen</h3>
          <p class="credit-card__desc">
            „Pflege die Spezifikation, nicht den Code“ ist ein echtes Umdenken, keine
            schrittweise Anpassung. Sie stammt vom Designer der Programmiersprache Kotlin
            und verdient es, ernst genommen zu werden: Wenn die Spezifikation die Quelle ist,
            wird generierter Code zum Implementierungsdetail.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Code-zu-Spezifikation-Übernahme</h3>
          <p class="credit-card__desc">
            <code>codespeak takeover</code> liest vorhandenen Quellcode ein und erzeugt eine Spezifikation,
            die dessen Verhalten abbildet – ein reibungsarmer Einstieg für Legacy-Code,
            mit einer berichteten Komprimierung von Spezifikation zu Code von ca. 5–10×.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Absichtserfassung aus Agenten-Sitzungen</h3>
          <p class="credit-card__desc">
            CodeSpeaks Intent Studio extrahiert Anforderungen aus vorherigen Agenten-Sitzungen –
            es erntet die bereits geäußerte Absicht, statt ein leeres Dokument zum
            Ausfüllen zu verlangen.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature-Vergleichstabelle ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Feature-Vergleich.</h2>
        <p class="section-note">
          Beide machen unterschiedliche Wetten – die Tabelle vergleicht Philosophie und Mechanismen, keine Gewinner.
        </p>

        <div class="table-wrap">
          <table class="compare-table" aria-label="Feature-Vergleich SpecScore vs CodeSpeak">
            <thead>
              <tr>
                <th scope="col">Fähigkeit</th>
                <th scope="col">CodeSpeak</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Quelle der Wahrheit</td>
                <td>Die Spezifikation (Kompilierungseingabe)</td>
                <td><strong>Die Spezifikation ist der Vertrag; der Code das Lieferergebnis</strong></td>
              </tr>
              <tr>
                <td>Generierter Code</td>
                <td>Von einem LLM erzeugt, nicht manuell gepflegt</td>
                <td><strong>Du und deine Agenten schreiben und besitzen den Code</strong></td>
              </tr>
              <tr>
                <td>Spezifikationsformat</td>
                <td>Einfaches Englisch, von CodeSpeak definiert</td>
                <td><strong>Offener Markdown + YAML-Standard</strong>, Schema veröffentlicht</td>
              </tr>
              <tr>
                <td>Spezifikation → Code</td>
                <td>Kernfunktion (proprietärer LLM-Compiler)</td>
                <td>Außerhalb des Umfangs – jeder Agent implementiert</td>
              </tr>
              <tr>
                <td>Funktioniert ohne den Anbieter</td>
                <td>Spezifikationen werden über CodeSpeak kompiliert</td>
                <td><strong>Ja</strong> – Spezifikationen funktionieren mit jedem Agenten oder keinem</td>
              </tr>
              <tr>
                <td>Spezifikations-Linting</td>
                <td>Nicht dokumentiert</td>
                <td><strong>Inhaltliche Qualität</strong> – vage Verben, fehlende ACs, tote Referenzen</td>
              </tr>
              <tr>
                <td>Code-zu-Spezifikation-Rückverfolgbarkeit</td>
                <td>Über Neugenerierung</td>
                <td><strong><code>specscore:</code>-Annotationen</strong> + <code>Verifies:</code>-Trailer</td>
              </tr>
              <tr>
                <td>Determinismus</td>
                <td>LLM-Kompilierung (nicht deterministisch)</td>
                <td><strong>Deterministische CLI-Abfragen</strong>; normal geschriebener Code</td>
              </tr>
              <tr>
                <td>Code → Spezifikation</td>
                <td><strong><code>codespeak takeover</code></strong></td>
                <td><code>survey</code> + Verfassen</td>
              </tr>
              <tr>
                <td>Offenheit</td>
                <td>Proprietäres System</td>
                <td><strong>Offen</strong> – Format CC BY 4.0, Tools MIT / Apache-2.0</td>
              </tr>
              <tr>
                <td>Stadium</td>
                <td>Alpha-Vorschau</td>
                <td>In Produktion</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Worin sich SpecScore unterscheidet ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">Worin sich SpecScore unterscheidet.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">Du behältst deinen Code</h3>
            <p class="diff-card__desc">
              CodeSpeak generiert und regeneriert die Implementierung; der Code ist eine
              Ausgabe, kein Vermögenswert. SpecScore belässt den Code dort, wo er hingehört – in
              deinen Händen, in deiner Sprache, Zeile für Zeile überprüfbar. Die Spezifikation liefert
              Klarheit und Rückverfolgbarkeit, ohne dir den Code zu entziehen.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Deine Spezifikationen sind portabel</h3>
            <p class="diff-card__desc">
              Eine CodeSpeak-Spezifikation ist wertvoll, weil CodeSpeak sie kompiliert. Eine SpecScore-Spezifikation
              ist für sich allein wertvoll – sie ist sauber strukturiertes Markdown, das jeder
              Agent lesen kann, und bleibt nützlich, ganz ohne installierte SpecScore-Tools.
              Nutze sie mit jedem beliebigen Werkzeug oder keinem. Wechsel jederzeit.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Ambiguität wird abgefangen, bevor sie teuer wird</h3>
            <p class="diff-card__desc">
              Bei einem LLM-Compiler führt eine mehrdeutige Spezifikation zur Build-Zeit zu fehlerhaftem Code.
              Das <code>lint</code> von SpecScore bringt vage Verben, fehlende Akzeptanzkriterien
              und tote Referenzen ans Licht, <em>bevor</em> ein Agent darauf reagiert.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> verb  <span class="dim">"handle gracefully" — nicht messbar</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Determinismus und Rückverfolgbarkeit</h3>
            <p class="diff-card__desc">
              CodeSpeaks Antwort auf „Welcher Code implementiert dies?“ lautet: „Alles,
              neu generiert.“ SpecScores Antwort ist eine konkrete Datei und Zeile, über
              <code>specscore code refs</code> und <code>Verifies:</code>-Commit-Trailer
              – deterministisch, auditierbar, diff-bar.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Ein strukturierter Artefakt-Graph</h3>
            <p class="diff-card__desc">
              CodeSpeaks Einheit ist eine Spezifikationsdatei in Prosa. SpecScore besitzt eine
              typisierte Hierarchie – Ideas werden zu Features befördert, Features enthalten Anforderungen und
              Akzeptanzkriterien mit IDs, Plans referenzieren ACs, Tasks referenzieren Plans –
              alles maschinell navigierbar.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Kein Anbieter im Build-Pfad</h3>
            <p class="diff-card__desc">
              SpecScore ist eine einzige Go-Binärdatei. Der Lint läuft in der CI und in Pre-Commit-Hooks
              ohne Account, ohne Service-Aufruf und ohne LLM-Roundtrip in deinem Build.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── Wann du was nutzt ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Wann du was nutzt.</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Greife zu CodeSpeak, wenn…</h3>
            <ul class="when-card__list">
              <li>Du die Codepflege beenden und die Spezifikation als Quelle nutzen willst.</li>
              <li>Du dich wohl damit fühlst, für diese Hebelwirkung vom Compiler eines Anbieters abhängig zu sein.</li>
              <li>Du eine bestehende Codebasis in eine deutlich kürzere Spezifikation komprimieren willst.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Nutze SpecScore, wenn…</h3>
            <ul class="when-card__list">
              <li>Du Spezifikationen willst, die jedes einzelne Tool überdauern – portabel durch Design.</li>
              <li>Du deinen Code behalten willst, in deiner Sprache, prüfbar und in deinem Besitz.</li>
              <li>Du Qualitätsprüfungen brauchst – der Linter fängt Ambiguitäten früh ab.</li>
              <li>Du deterministische Code-zu-Spezifikation-Rückverfolgbarkeit benötigst.</li>
              <li>Du keinen Anbieter und keinen LLM-Roundtrip in deinem Build-Pfad willst.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── Zwei unterschiedliche Wetten ── */}
    <section class="section" aria-labelledby="bets-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bets-title" class="section-title">Zwei unterschiedliche Wetten.</h2>
        <p class="prose-p">
          CodeSpeak ist eine Wette auf einen Compiler: Übergib die Spezifikation und vertraue darauf, dass er
          den Code erzeugt und reproduziert. SpecScore ist eine Wette auf ein Format: Halte die Spezifikation
          offen und portabel, behalte deinen Code und lass jeden beliebigen Agenten damit arbeiten.
        </p>
        <p class="prose-p">
          Das eine tauscht Portabilität gegen Hebelwirkung. Das andere bewahrt deine Unabhängigkeit – und bleibt lintbar.
        </p>
      </div>
    </section>

    <ComparisonFeedback page="codespeak" />
  </main>

  {/* ── Finaler CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Spezifikationen, die bestehen.</h2>
      <div class="final-cta__buttons">
        <a href="/de/cli/install/" class="btn btn--primary">CLI installieren</a>
        <a href="/de/ai/specstudio-skills/" class="btn btn--secondary">KI-Skills für deinen Agenten</a>
        <a
          href="https://github.com/specscore/specscore"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          Open-Source auf GitHub
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterDe />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__breadcrumb {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Shared list ── */
  .shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shared-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }
  .shared-list li::before {
    content: '=';
    position: absolute;
    left: 0;
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pale-ink);
  }

  /* ── Section note ── */
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }

  /* ── Credit cards ── */
  .credit-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .credit-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .credit-card__desc {
    color: var(--mid-ink);
    line-height: 1.6;
    font-size: var(--fs-body);
  }
  .credit-card__desc code {
    font-size: 0.9em;
    background: var(--cream);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Feature comparison table ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .compare-table td:nth-child(2),
  .compare-table td:nth-child(3) {
    min-width: 200px;
  }
  .compare-table td code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .compare-table strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* ── Diff grid ── */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .diff-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .diff-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .diff-card__desc {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .diff-card__desc code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .diff-card__example {
    margin-top: var(--space-2);
  }
  .diff-card__example .terminal {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .diff-grid { grid-template-columns: 1fr; }
  }

  /* ── When to use which ── */
  .when-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .when-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .when-card--primary {
    border-color: var(--validator-green);
    border-width: 2px;
  }
  .when-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .when-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .when-card__list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
    font-size: var(--fs-small);
  }
  .when-card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--pale-ink);
    font-family: var(--font-code);
  }
  .when-card--primary .when-card__list li::before {
    color: var(--validator-green);
  }
  .when-card__list code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; }
  }

  /* ── Bets section ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-2);
  }
  .prose-p:last-child {
    margin-bottom: 0;
    font-weight: 500;
    color: var(--ink);
  }
  .prose-p code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    text-align: center;
  }
  .final-cta__title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .final-cta__buttons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
