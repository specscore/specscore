---
// SpecStudio Skills — Landingpage auf Deutsch.
// Canonical campaign URL: specscore.md/de/ai/specstudio-skills/
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterDe from '../../../../components/SiteFooterDe.astro';
import QsTabsScript from '../../../../components/QsTabsScript.astro';
---

<BaseLayout
  lang="de"
  title="SpecStudio Skills — Spezifikationen, denen dein KI-Agent wirklich folgen kann."
  description="Kostenloses Plugin für Claude Code, das improvisierte Prompts in strukturierte, bewertete Spezifikationen verwandelt, die dein Agent liest, bevor er eine einzige Zeile Code schreibt. Aufgebaut auf dem offenen SpecScore-Protokoll."
  canonical="https://specscore.md/de/ai/specstudio-skills/"
>
  <SiteHeader />

  <main>
    {/* ── Section 1: Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 id="hero-title" class="hero__headline">
          Spezifikationen, denen dein KI-Agent<br />wirklich folgen kann.
        </h1>
        <p class="hero__sub">
          SpecStudio Skills ist ein kostenloses Plugin für Claude Code, das
          improvisierte Prompts in strukturierte, bewertete Spezifikationen verwandelt,
          die dein Agent liest, bevor er eine einzige Zeile Code schreibt. Aufgebaut
          auf dem offenen Protokoll
          <a class="xref" href="/de/">SpecScore</a>.
        </p>
        <div class="hero__install" id="install">
          <div class="qs-tabs" role="tablist" aria-label="Installationsmethode">
            <button type="button" role="tab" id="qs-tab-claude" aria-controls="qs-panel-claude" aria-selected="true" tabindex="0" class="qs-tab is-active" data-tab="claude">Claude Code</button>
            <button type="button" role="tab" id="qs-tab-setup" aria-controls="qs-panel-setup" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="setup">Andere KI-Agenten</button>
            <button type="button" role="tab" id="qs-tab-manual" aria-controls="qs-panel-manual" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="manual">Manuell</button>
          </div>

          <div id="qs-panel-claude" role="tabpanel" aria-labelledby="qs-tab-claude" class="qs-panel is-active" data-panel="claude">
<pre class="terminal"><span class="prompt">$</span> /plugin marketplace add specscore/ai-marketplace
<span class="prompt">$</span> /plugin install specstudio@specscore</pre>
          </div>
          <div id="qs-panel-setup" role="tabpanel" aria-labelledby="qs-tab-setup" class="qs-panel" data-panel="setup" hidden>
<pre class="terminal"><span class="prompt">$</span> specscore agent setup &lt;agent-name&gt;</pre>
            <p class="qs-note">
              Schreibt die passende Anweisungsdatei für deinen Agenten –
              <code>claude</code>, <code>copilot</code>, <code>cursor</code>, <code>codex</code>,
              <code>antigravity.google</code>, <code>pi.dev</code> oder <code>opencode</code>.
              Führe den Befehl innerhalb eines von SpecScore verwalteten Projekts aus. Erfordert die
              <a class="xref" href="/de/cli/">SpecScore-CLI</a>.
            </p>
          </div>
          <div id="qs-panel-manual" role="tabpanel" aria-labelledby="qs-tab-manual" class="qs-panel" data-panel="manual" hidden>
<pre class="terminal"><span class="prompt">$</span> git clone https://github.com/specscore/specstudio-skills
<span class="prompt">$</span> cp -r specstudio-skills/commands /pfad/zu/deinem/agenten/commands/
<span class="prompt">$</span> cp -r specstudio-skills/skills /pfad/zu/deinem/agenten/skills/</pre>
            <p class="qs-note">
              Klone das Plugin-Repository und kopiere die Verzeichnisse
              <code>commands/</code> und <code>skills/</code> dorthin, wo dein Agent
              Befehls- und Skill-Dateien lädt.
            </p>
          </div>
        </div>
        <p class="hero__demo-link">
          <a href="#demo" class="xref">Sieh dir die 60-Sekunden-Demo an ↓</a>
        </p>
      </div>
    </section>

    {/* ── Section 2: Demo ── */}
    <section class="section" id="demo" aria-labelledby="demo-title">
      <div class="section-inner">
        <h2 id="demo-title" class="section-title">
          Von einer vagen Idee zur bewerteten Spezifikation – in 60 Sekunden.
        </h2>

        <div class="demo-placeholder">
          <div class="terminal-frame">
            <div class="terminal-frame__head">
              <span class="terminal-frame__title">Claude Code</span>
              <span class="terminal-frame__hint">demo</span>
            </div>
<pre class="terminal terminal-frame__body"><span class="prompt">&gt;</span> /specstudio:ideate A password reset flow for our SaaS app.

<span class="dim">Refining idea...</span>
<span class="dim">Producing spec/ideas/password-reset.md</span>

<span class="prompt">&gt;</span> /specstudio:specify spec/ideas/password-reset.md

<span class="dim">Writing Feature spec...</span>
<span class="dim">spec/features/password-reset/README.md</span>

<span class="prompt">$</span> specscore lint spec/features/password-reset/
<span class="mark-pass">PASS</span>  Feature: password-reset
  <span class="mark-pass">PASS</span>  has title, status, and description
  <span class="mark-pass">PASS</span>  requirements have acceptance criteria
  <span class="mark-pass">PASS</span>  all AC IDs are unique
  <span class="mark-pass">PASS</span>  no orphan cross-references

<span class="mark-pass">Score: 92 / 100</span></pre>
          </div>
          <p class="demo-caption">
            Unbearbeitet. Ungeschnitten. Leeres Claude Code → Plugin installieren →
            echte Spezifikation bewerten → dein Agent baut das Richtige.
          </p>
        </div>
      </div>
    </section>

    {/* ── Section 3: Das Problem ── */}
    <section class="section" aria-labelledby="wedge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="wedge-title" class="section-title">
          Warum dein Agent immer wieder das Falsche baut.
        </h2>
        <p class="prose-p">
          Improvisierte Prompts funktionieren, bis sie es nicht mehr tun. Der
          Agent hat die Hälfte des Features gebaut. Die Anforderung falsch verstanden.
          Einen API-Aufruf erfunden. Die falsche Bibliothek gewählt. Du
          schreibst den Prompt neu. Noch einmal. In der dritten
          Runde schreibst du bereits die vollständige Spezifikation von Hand in den Chat.
        </p>
        <p class="prose-p">
          Das Problem ist nicht der Agent. Sondern dass „Bau mir ein Feature“ keine
          Spezifikation ist – es ist ein Wunsch. Agenten sind stochastisch. Wünsche
          vertragen sich mit dem Stochastischen. Spezifikationen nicht.
        </p>
        <p class="prose-p">
          SpecStudio Skills gibt dir einen Workflow an die Hand, um Spezifikationen
          zu schreiben, die dein Agent tatsächlich interpretieren kann: strukturierte
          Features, Anforderungen, Akzeptanzkriterien – auf Vollständigkeit
          bewertet, bevor der Agent sie überhaupt zu Gesicht bekommt. Dieselbe
          Geschwindigkeit wie Vibe-Coding, dramatisch weniger Varianz im Ergebnis.
        </p>
      </div>
    </section>

    {/* ── Section 4: Die Pipeline ── */}
    <section class="section pipeline-section" aria-labelledby="pipeline-title">
      <div class="section-inner">
        <h2 id="pipeline-title" class="section-title">
          Vier Befehle. Eine Pipeline.
        </h2>
        <p class="pipeline-intro">
          Einmal installieren, danach der Reihe nach ausführen – von der rohen Idee zum ausführbaren Plan.
        </p>

        <div class="pipeline-grid">
          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/ideate</span>
            </div>
            <p class="pipeline-card__desc">
              Verfeinert eine rohe Idee durch strukturiertes divergentes und konvergentes
              Denken. Erzeugt ein lintbares One-Pager-Dokument vor der Spezifikation.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/specify</span>
            </div>
            <p class="pipeline-card__desc">
              Verwandelt eine freigegebene Idee in ein SpecScore-Feature mit
              Anforderungen, Akzeptanzkriterien und Given/When/Then-Blöcken.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/plan</span>
            </div>
            <p class="pipeline-card__desc">
              Zerlegt ein Feature in eine geordnete Aufgabenliste. Jede Aufgabe
              wird einem oder mehreren Akzeptanzkriterien zugeordnet.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/implement</span>
            </div>
            <p class="pipeline-card__desc">
              Führt die nächste Aufgabe des Plans aus. Ein Subagent pro Aufgabe,
              Commits rückverfolgbar zu ACs, Staged Diff für deine Freigabe.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── Section 5: Was enthalten ist ── */}
    <section class="section" aria-labelledby="box-title">
      <div class="section-inner section-inner--prose">
        <h2 id="box-title" class="section-title">
          Was enthalten ist.
        </h2>

        <h3 class="list-heading">Es tut:</h3>
        <ul class="feature-list feature-list--does">
          <li>Fügt Slash-Befehle für den gesamten SDD-Workflow hinzu: <code>/ideate</code>, <code>/specify</code>, <code>/plan</code>, <code>/implement</code>.</li>
          <li>Bewertet die Vollständigkeit und Ambiguität der Spezifikation, bevor der Agent sie sieht.</li>
          <li>Schreibt Spezifikationen im offenen SpecScore-Format – ohne proprietäre Erweiterungen.</li>
        </ul>

        <h3 class="list-heading">Es tut nicht:</h3>
        <ul class="feature-list feature-list--doesnt">
          <li>Den Agenten für dich ausführen. Das Plugin ist eine Workflow-Schicht; der Agent bleibt Claude.</li>
          <li>Daten irgendwohin senden. Spezifikationen und Bewertungen bleiben lokal.</li>
          <li>Dich einsperren. Wenn du es deinstallierst, bleiben deine Spezifikationen gültiges Markdown, bewertbar mit der CLI <a class="xref" href="https://github.com/specscore/specscore">specscore</a>.</li>
        </ul>

        <p class="sibling-callout">
          Suchst du die neutrale CLI-Schnittstelle?
          <a class="xref" href="https://github.com/specscore/ai-plugin-specscore">ai-plugin-specscore</a>
          ist der schlanke Wrapper. SpecStudio Skills ist der meinungsstarke Workflow darauf aufgebaut.
        </p>
      </div>
    </section>

    {/* ── Section 6: Offenes Protokoll ── */}
    <section class="section" aria-labelledby="open-title">
      <div class="section-inner section-inner--prose">
        <h2 id="open-title" class="section-title">
          Aufgebaut auf dem offenen SpecScore-Protokoll.
        </h2>
        <p class="prose-p">
          SpecStudio Skills schreibt Spezifikationen in
          <a class="xref" href="/de/">SpecScore</a>, einem offenen
          Standard. Das Format ist für Menschen lesbares Markdown. Das Schema
          ist veröffentlicht. Die CLI ist Open Source. Kein Vendor-Lock-in. Solltest
          du SpecStudio jemals verlassen, nimmst du deine Spezifikationen einfach mit.
        </p>
      </div>
    </section>
  </main>

  {/* ── Finaler CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Probier es aus.</h2>
      <div class="final-cta__install">
        <div class="qs-tabs" role="tablist" aria-label="Installationsmethode">
          <button type="button" role="tab" id="qs-tab-claude-b" aria-controls="qs-panel-claude-b" aria-selected="true" tabindex="0" class="qs-tab is-active" data-tab="claude">Claude Code</button>
          <button type="button" role="tab" id="qs-tab-setup-b" aria-controls="qs-panel-setup-b" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="setup">Andere KI-Agenten</button>
          <button type="button" role="tab" id="qs-tab-manual-b" aria-controls="qs-panel-manual-b" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="manual">Manuell</button>
        </div>

        <div id="qs-panel-claude-b" role="tabpanel" aria-labelledby="qs-tab-claude-b" class="qs-panel is-active" data-panel="claude">
<pre class="terminal"><span class="prompt">$</span> /plugin marketplace add specscore/ai-marketplace
<span class="prompt">$</span> /plugin install specstudio@specscore</pre>
        </div>
        <div id="qs-panel-setup-b" role="tabpanel" aria-labelledby="qs-tab-setup-b" class="qs-panel" data-panel="setup" hidden>
<pre class="terminal"><span class="prompt">$</span> specscore agent setup &lt;agent-name&gt;</pre>
          <p class="qs-note">
            Schreibt die passende Anweisungsdatei für deinen Agenten –
            <code>claude</code>, <code>copilot</code>, <code>cursor</code>, <code>codex</code>,
            <code>antigravity.google</code>, <code>pi.dev</code> oder <code>opencode</code>.
            Führe den Befehl innerhalb eines von SpecScore verwalteten Projekts aus. Erfordert die
            <a class="xref" href="/de/cli/">SpecScore-CLI</a>.
          </p>
        </div>
        <div id="qs-panel-manual-b" role="tabpanel" aria-labelledby="qs-tab-manual-b" class="qs-panel" data-panel="manual" hidden>
<pre class="terminal"><span class="prompt">$</span> git clone https://github.com/specscore/specstudio-skills
<span class="prompt">$</span> cp -r specstudio-skills/commands /pfad/zu/deinem/agenten/commands/
<span class="prompt">$</span> cp -r specstudio-skills/skills /pfad/zu/deinem/agenten/skills/</pre>
          <p class="qs-note">
            Klone das Plugin-Repository und kopiere die Verzeichnisse
            <code>commands/</code> und <code>skills/</code> dorthin, wo dein Agent
            Befehls- und Skill-Dateien lädt.
          </p>
        </div>
      </div>
      <p class="final-cta__note">
        Kostenlos für öffentliche und Open-Source-Repositories. MIT-Lizenz.
      </p>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterDe />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-7) var(--space-3) var(--space-6);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    margin-bottom: var(--space-4);
    line-height: 1.55;
  }
  .hero__install {
    margin-bottom: var(--space-3);
  }
  .hero__demo-link {
    font-size: var(--fs-small);
    color: var(--mid-ink);
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Demo ── */
  .demo-placeholder {
    margin-top: var(--space-3);
  }
  .demo-caption {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    color: var(--mid-ink);
  }

  /* Terminal frame (shared with homepage AiSkills pattern) */
  .terminal-frame {
    border: 1px solid var(--hairline);
    background: var(--surface);
  }
  .terminal-frame__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--hairline);
    background: var(--cream-2);
    font-family: var(--font-code);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .terminal-frame__title { color: var(--graphite); font-weight: 700; }
  .terminal-frame__hint  { color: var(--mid-ink); }
  .terminal-frame__body  { border: none !important; }

  /* ── Wedge (prose sections) ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-3);
  }
  .prose-p:last-child {
    margin-bottom: 0;
  }

  /* ── Pipeline grid ── */
  .pipeline-section {
    background: var(--cream-2);
  }
  .pipeline-intro {
    color: var(--mid-ink);
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }
  .pipeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }
  .pipeline-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .pipeline-card__head {
    margin-bottom: var(--space-2);
  }
  .pipeline-card__cmd {
    font-family: var(--font-code);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .pipeline-card__desc {
    font-size: var(--fs-small);
    color: var(--mid-ink);
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .pipeline-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .pipeline-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── What's in the box ── */
  .list-heading {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .list-heading:first-of-type {
    margin-top: 0;
  }
  .feature-list {
    margin: 0 0 var(--space-3) 0;
    padding-left: 1.25rem;
    color: var(--mid-ink);
    line-height: 1.65;
  }
  .feature-list li {
    margin-bottom: 0.5rem;
  }
  .feature-list li:last-child {
    margin-bottom: 0;
  }
  .feature-list code {
    font-size: 0.9em;
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }
  .sibling-callout {
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid var(--hairline);
    font-size: var(--fs-small);
    color: var(--mid-ink);
    line-height: 1.55;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    text-align: center;
  }
  .final-cta__title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .final-cta__install {
    display: inline-block;
    text-align: left;
    margin-bottom: var(--space-3);
  }
  .final-cta__note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
  }
</style>

<QsTabsScript />
