---
// /it/vs/openspec/ — Confronto tra SpecScore e OpenSpec.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterIt from '../../../../components/SiteFooterIt.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
import MoreComparisons from '../../../../components/MoreComparisons.astro';
---

<BaseLayout
  lang="it"
  title="SpecScore vs OpenSpec — Confronto onesto."
  description="Un confronto oggettivo e affiancato di SpecScore e OpenSpec: formato delle specifiche, linting, ciclo di vita, tracciabilità, CLI e supporto per gli agenti. Onesto su entrambi."
  canonical="https://specscore.md/it/vs/openspec/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/it/vs/" class="xref">Confronti</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs OpenSpec
        </h1>
        <p class="hero__sub">
          Entrambi collocano le specifiche in Markdown, accanto al tuo codice, leggibili dagli agenti IA. Rispondono a domande diverse: OpenSpec organizza le specifiche e genera comandi per gli agenti. SpecScore valida il contenuto delle specifiche, applica il ciclo di vita e traccia il codice risalendo ai requisiti.
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Cosa hanno in comune.</h2>
        <ul class="shared-list">
          <li>Le specifiche risiedono nel tuo repository come file Markdown — con controllo versione, revisionabili nelle pull request.</li>
          <li>Entrambi sono open source con licenza MIT.</li>
          <li>Entrambi usano criteri di accettazione Given/When/Then.</li>
          <li>Entrambi considerano gli agenti IA come fruitori di prima classe delle specifiche.</li>
        </ul>
      </div>
    </section>

    {/* ── What OpenSpec does well ── */}
    <section class="section" aria-labelledby="openspec-title">
      <div class="section-inner section-inner--prose">
        <h2 id="openspec-title" class="section-title">Cosa fa bene OpenSpec.</h2>

        <div class="credit-card">
          <h3 class="credit-card__title">Il supporto più ampio per gli agenti</h3>
          <p class="credit-card__desc">
            OpenSpec supporta 29 agenti IA tramite file di skill generati — Claude, Cursor, Copilot, Gemini, Windsurf, Cline e altri. Se il tuo agente è nella lista, OpenSpec si integra senza alcuna configurazione.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Bassa barriera all'ingresso</h3>
          <p class="credit-card__desc">
            <code>npm install -g @fission-ai/openspec &amp;&amp; openspec init</code> e puoi già iniziare a scrivere specifiche. Nessuno schema da imparare, nessun frontmatter obbligatorio. Progettato per essere semplice — soprattutto per progetti già esistenti.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Un modello chiaro per i delta di modifica</h3>
          <p class="credit-card__desc">
            Il formato <code>ADDED / MODIFIED / REMOVED</code> di OpenSpec per far evolvere le specifiche è ben progettato. Ogni modifica è una directory contenente una proposta, specifiche delta e task — un modo strutturato per proporre modifiche.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Confronto delle funzionalità.</h2>

        <div class="table-wrap">
          <table class="compare-table" aria-label="Confronto delle funzionalità SpecScore vs OpenSpec">
            <thead>
              <tr>
                <th scope="col">Funzionalità</th>
                <th scope="col">OpenSpec</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Formato della specifica</td>
                <td>Markdown (senza frontmatter)</td>
                <td>Markdown + YAML frontmatter</td>
              </tr>
              <tr>
                <td>Linting delle specifiche</td>
                <td>Solo struttura dei file</td>
                <td><strong>Qualità dei contenuti</strong> — verbi vaghi, AC mancanti, riferimenti orfani</td>
              </tr>
              <tr>
                <td>ID dei requisiti</td>
                <td>Nessuno (riferiti per titolo)</td>
                <td><strong>Basati su slug</strong> (<code>REQ: slug-format</code>)</td>
              </tr>
              <tr>
                <td>ID dei criteri di accettazione</td>
                <td>Nessuno</td>
                <td><strong>ID indirizzabili via software</strong></td>
              </tr>
              <tr>
                <td>Stato del ciclo di vita</td>
                <td>Implicito (posizione del file)</td>
                <td><strong>Applicato rigorosamente</strong> — Draft → Under Review → Approved → Implementing → Stable → Deprecated</td>
              </tr>
              <tr>
                <td>Tracciabilità codice-a-specifica</td>
                <td>Nessuna</td>
                <td><strong>Annotazioni <code>specscore:</code></strong> + trailer di commit <code>Verifies:</code></td>
              </tr>
              <tr>
                <td>Sotto-feature</td>
                <td>No</td>
                <td><strong>Sì</strong> (directory nidificate)</td>
              </tr>
              <tr>
                <td>Riferimenti incrociati</td>
                <td>Nessun meccanismo formale</td>
                <td><strong>Dipendenze, Idee d'origine, riferimenti ai piani</strong></td>
              </tr>
              <tr>
                <td>Integrazione CI</td>
                <td>Base (<code>openspec validate</code>)</td>
                <td><strong><code>specscore lint</code></strong> con gravità configurabile, hook di pre-commit</td>
              </tr>
              <tr>
                <td>Supporto degli agenti</td>
                <td><strong>29 agenti</strong></td>
                <td>Claude Code come agente primario + CLI per qualsiasi agente</td>
              </tr>
              <tr>
                <td>Personalizzazione dello schema</td>
                <td><strong>Sì</strong> (<code>schema.yaml</code>, fork/init)</td>
                <td>Schema standard fisso (coerenza per progettazione)</td>
              </tr>
              <tr>
                <td>Proposte di modifica</td>
                <td><strong>Modello delta</strong> (ADDED/MODIFIED/REMOVED)</td>
                <td>Idee di modifica + proposte</td>
              </tr>
              <tr>
                <td>Dipendenza da runtime</td>
                <td>Node.js 20.19+</td>
                <td><strong>Nessuna</strong> — singolo binario Go</td>
              </tr>
              <tr>
                <td>Licenza</td>
                <td>MIT</td>
                <td>MIT</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore goes further ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">Dove SpecScore va oltre.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">La validazione va oltre la struttura dei file</h3>
            <p class="diff-card__desc">
              Il comando <code>validate</code> di OpenSpec verifica la struttura dei
              file — se il file esiste e se ha le sezioni corrette.
              SpecScore controlla molto più a fondo su due livelli: <code>lint</code> verifica in
              modo deterministico le relazioni di contenuto — ogni requisito ha
              criteri di accettazione, i riferimenti incrociati sono risolti, le transizioni
              di stato sono valide — e un revisore IA (<code>/review</code>, <code>/score</code>)
              rileva ciò che nessun linter statico può individuare: criteri ambigui e verbi vaghi.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> link  <span class="dim">"Related Feature: discount-tiers" not found</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Ogni requisito ha un ID leggibile via software</h3>
            <p class="diff-card__desc">
              OpenSpec fa riferimento ai requisiti tramite il titolo — fragile di fronte a ridenominazioni. SpecScore assegna ID basati su slug (<code>REQ: slug-format</code>) e ID per i criteri di accettazione che sopravvivono a rinomine, refactoring e passaggi di consegne tra agenti.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Il ciclo di vita viene applicato, non dedotto</h3>
            <p class="diff-card__desc">
              In OpenSpec, il ciclo di vita di una specifica coincide con la sua posizione nel filesystem: <code>specs/</code> (attuale), <code>changes/</code> (proposto), <code>archive/</code> (completato). In SpecScore, il ciclo di vita è un campo di stato effettivo — Draft → Under Review → Approved → Implementing → Stable → Deprecated — validato dal lint e modificato tramite <code>specscore change-status</code> da git hook o CI.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Il codice risale alle specifiche</h3>
            <p class="diff-card__desc">
              OpenSpec non dispone di meccanismi di tracciabilità. SpecScore offre annotazioni <code>specscore:</code> nei commenti del codice e trailer <code>Verifies:</code> nei commit. Esegui <code>specscore code refs</code> e ottieni una risposta deterministica a "quale codice implementa questo requisito?".
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Nessuna dipendenza da runtime</h3>
            <p class="diff-card__desc">
              OpenSpec richiede Node.js 20.19+. SpecScore è un singolo binario Go — nessun runtime, niente <code>node_modules</code>. Funziona in progetti Go, Rust, Python o Java senza dover aggiungere Node al toolchain.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Gerarchia di artefatti componibile</h3>
            <p class="diff-card__desc">
              Le specifiche di OpenSpec sono piatte per dominio. SpecScore adotta una gerarchia tipizzata: le Idee vengono promosse a Feature, le Feature contengono requisiti e AC, i Plan referenziano AC, i Task referenziano Plan. Tutte le relazioni sono navigabili via software tramite la CLI.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Quando usare l'uno o l'altro.</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Inizia con OpenSpec se…</h3>
            <ul class="when-card__list">
              <li>Usi Cursor, Copilot o altri agenti non-Claude e desideri un'integrazione pronta all'uso.</li>
              <li>Stai aggiungendo specifiche a una codebase esistente per la prima volta e cerchi zero attrito iniziale.</li>
              <li>Il tuo team preferisce la flessibilità dello schema rispetto all'applicazione rigorosa delle regole.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Usa SpecScore se…</h3>
            <ul class="when-card__list">
              <li>Hai bisogno di controllo di qualità sulle specifiche — il lint rileva le ambiguità prima che gli agenti sprechino token.</li>
              <li>Ti serve tracciabilità da codice a specifica — "quale codice implementa questo requisito?" restituisce una risposta deterministica.</li>
              <li>Stai costruendo un sistema complesso con molte feature, sotto-feature e transizioni di ciclo di vita.</li>
              <li>Vuoi zero dipendenze da runtime — un binario autonomo, senza richiedere Node.js.</li>
              <li>Hai bisogno di controlli di qualità in CI — <code>specscore lint</code> termina con codice diverso da zero in caso di errori, proprio come ESLint o <code>go vet</code>.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── The integration opportunity ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">Non si escludono a vicenda.</h2>
        <p class="prose-p">
          SpecScore può verificare tramite lint anche i file <code>spec.md</code> di OpenSpec. I team che iniziano con OpenSpec possono aggiungere il livello di qualità di SpecScore senza dover migrare — valida le specifiche che hai già, aggiungi la tracciabilità quando serve, applica il ciclo di vita man mano che il team cresce.
        </p>
        <p class="prose-p">
          OpenSpec è un'ottima rampa di accesso. SpecScore offre le barriere di sicurezza.
        </p>
      </div>
    </section>

    <MoreComparisons />
    <ComparisonFeedback page="openspec" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Specifiche che superano la prova.</h2>
      <div class="final-cta__buttons">
        <a href="/it/cli/install/" class="btn btn--primary">Installa la CLI</a>
        <a href="/it/ai/specstudio-skills/" class="btn btn--secondary">Ottieni le skill IA per il tuo agente</a>
        <a href="https://github.com/specscore/specscore" rel="noopener" class="btn btn--tertiary">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" /></svg>
          Open source su GitHub
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterIt />
</BaseLayout>

<style>
  .hero { padding: var(--space-6) var(--space-3) var(--space-5); background: var(--cream); }
  .hero__inner { max-width: var(--max-prose); margin: 0 auto; animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms; }
  .hero__breadcrumb { font-family: var(--font-code); font-size: var(--fs-small); color: var(--pale-ink); margin-bottom: var(--space-2); }
  .hero__headline { font-size: var(--fs-hero); font-weight: 700; line-height: 1.04; letter-spacing: -0.02em; margin-bottom: var(--space-3); }
  .hero__sub { font-size: 1.125rem; color: var(--mid-ink); line-height: 1.55; max-width: 52ch; }
  @keyframes fade-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .section-title { font-size: var(--fs-h2); font-weight: 700; letter-spacing: -0.01em; margin-bottom: var(--space-3); }
  .shared-list { list-style: none; margin: 0; padding: 0; }
  .shared-list li { position: relative; padding-left: 1.4rem; color: var(--mid-ink); line-height: 1.6; margin-bottom: var(--space-1); }
  .shared-list li::before { content: '='; position: absolute; left: 0; font-family: var(--font-code); font-weight: 700; color: var(--pale-ink); }
  .credit-card { background: var(--surface); border: 1px solid var(--hairline); padding: var(--space-3); margin-bottom: var(--space-2); }
  .credit-card__title { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-1); }
  .credit-card__desc { color: var(--mid-ink); line-height: 1.6; font-size: var(--fs-body); }
  .credit-card__desc code { font-size: 0.9em; background: var(--cream); padding: 0.05em 0.3em; border-radius: 2px; }
  .table-section { background: var(--cream-2); }
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .compare-table { width: 100%; border-collapse: collapse; font-size: var(--fs-small); line-height: 1.5; }
  .compare-table th, .compare-table td { text-align: left; padding: 0.65rem 0.85rem; border-bottom: 1px solid var(--hairline); vertical-align: top; }
  .compare-table thead th { font-family: var(--font-display); font-weight: 600; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--mid-ink); border-bottom: 2px solid var(--graphite); white-space: nowrap; }
  .compare-table td:first-child { font-weight: 500; white-space: nowrap; min-width: 160px; }
  .compare-table td:nth-child(2), .compare-table td:nth-child(3) { min-width: 200px; }
  .compare-table td code { font-size: 0.88em; background: var(--surface); padding: 0.05em 0.3em; border-radius: 2px; }
  .compare-table strong { font-weight: 600; color: var(--ink); }
  .diff-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
  .diff-card { background: var(--surface); border: 1px solid var(--hairline); padding: var(--space-3); }
  .diff-card__title { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-1); }
  .diff-card__desc { color: var(--mid-ink); font-size: var(--fs-small); line-height: 1.6; }
  .diff-card__desc code { font-size: 0.9em; background: var(--cream-2); padding: 0.05em 0.3em; border-radius: 2px; }
  .diff-card__example { margin-top: var(--space-2); }
  .diff-card__example .terminal { font-size: 0.78rem; line-height: 1.6; }
  @media (max-width: 860px) { .diff-grid { grid-template-columns: 1fr; } }
  .when-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
  .when-card { background: var(--surface); border: 1px solid var(--hairline); padding: var(--space-4); }
  .when-card--primary { border-color: var(--validator-green); border-width: 2px; }
  .when-card__title { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-2); }
  .when-card__list { list-style: none; margin: 0; padding: 0; }
  .when-card__list li { position: relative; padding-left: 1.2rem; color: var(--mid-ink); line-height: 1.6; margin-bottom: var(--space-1); font-size: var(--fs-small); }
  .when-card__list li::before { content: '→'; position: absolute; left: 0; color: var(--pale-ink); font-family: var(--font-code); }
  .when-card--primary .when-card__list li::before { color: var(--validator-green); }
  .when-card__list code { font-size: 0.9em; background: var(--cream-2); padding: 0.05em 0.3em; border-radius: 2px; }
  @media (max-width: 860px) { .when-grid { grid-template-columns: 1fr; } }
  .prose-p { color: var(--mid-ink); line-height: 1.65; margin-bottom: var(--space-2); }
  .prose-p:last-child { margin-bottom: 0; font-weight: 500; color: var(--ink); }
  .prose-p code { font-size: 0.9em; background: var(--cream-2); padding: 0.05em 0.3em; border-radius: 2px; }
  .final-cta { background: var(--cream-2); padding: var(--space-7) var(--space-3); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .final-cta__inner { max-width: var(--max-content); margin: 0 auto; text-align: center; }
  .final-cta__title { font-size: clamp(2.2rem, 4.2vw, 3.2rem); margin-bottom: var(--space-4); letter-spacing: -0.02em; line-height: 1.05; }
  .final-cta__buttons { display: inline-flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
</style>
