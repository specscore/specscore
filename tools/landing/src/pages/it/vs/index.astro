---
// /it/vs/ — Comparison index page (Italian).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooterIt from '../../../components/SiteFooterIt.astro';
import ComparisonFeedback from '../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="it"
  title="SpecScore vs — Come si confronta SpecScore."
  description="Confronti onesti e dettagliati tra SpecScore e altri strumenti di sviluppo guidato dalle specifiche. Tabelle delle funzionalità, differenze architetturali e quando usare ciascuno."
  canonical="https://specscore.md/it/vs/"
>
  <SiteHeader />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 id="hero-title" class="hero__headline">
          Come si confronta SpecScore.
        </h1>
        <p class="hero__sub">
          Lo sviluppo guidato dalle specifiche è un settore in crescita. Questi
          confronti sono oggettivi, affiancati e onesti su dove ciascuno
          strumento eccelle.
        </p>
        <p class="hero__sub">
          <a href="/it/spec-driven-development/tools/" class="xref">I migliori strumenti di sviluppo guidato dalle specifiche nel 2026</a>
          riunisce gli stessi strumenti in una pagina.
        </p>
      </div>
    </section>

    <section class="section minis-section" aria-labelledby="comparisons-title">
      <div class="section-inner">
        <h2 id="comparisons-title" class="sr-only">Confronti</h2>

        <p class="minis__lead">
          <span class="minis__brand">SpecScore</span>
          <span class="minis__vs">vs</span>
        </p>

        <div class="minis">
          <a href="/it/vs/plain-markdown/" class="mini">
            <span class="mini__name">Plain Markdown</span>
            <span class="mini__line">L'approccio predefinito. SpecScore è l'evoluzione del tuo Markdown.</span>
          </a>
          <a href="/it/vs/openspec/" class="mini">
            <span class="mini__name">OpenSpec</span>
            <span class="mini__line">Un buon punto di partenza. SpecScore offre i guardrail.</span>
          </a>
          <a href="/it/vs/spec-kit/" class="mini">
            <span class="mini__name">Spec Kit</span>
            <span class="mini__line">Spec Kit è il flusso di lavoro. SpecScore è l'artefatto.</span>
          </a>
          <a href="/it/vs/datarim/" class="mini">
            <span class="mini__name">Datarim</span>
            <span class="mini__line">Datarim esegue la pipeline. SpecScore è ciò che lascia traccia.</span>
          </a>
          <a href="/it/vs/codespeak/" class="mini">
            <span class="mini__name">CodeSpeak</span>
            <span class="mini__line">CodeSpeak punta su un compilatore. SpecScore punta su un formato.</span>
          </a>
          <a href="/it/vs/kiro/" class="mini">
            <span class="mini__name">Kiro</span>
            <span class="mini__line">Kiro scrive la spec nel suo IDE. SpecScore è il formato che la CI può sottoporre a lint.</span>
          </a>
          <a href="/it/vs/tessl/" class="mini">
            <span class="mini__name">Tessl</span>
            <span class="mini__line">Tessl sostiene la spec come fonte. SpecScore fa il lint della spec accanto al codice.</span>
          </a>
          <a href="/it/vs/bmad-method/" class="mini">
            <span class="mini__name">BMAD Method</span>
            <span class="mini__line">BMAD esegue il ciclo agile. SpecScore è l’artefatto che una pull request può controllare.</span>
          </a>
          <a href="/it/vs/task-master-ai/" class="mini">
            <span class="mini__name">Task Master AI</span>
            <span class="mini__line">Task Master divide un PRD in task. SpecScore è la spec che quei task possono citare.</span>
          </a>
        </div>
      </div>
    </section>

    {/* ── Cross-comparison matrix ── */}
    <section class="section table-section" aria-labelledby="matrix-title">
      <div class="section-inner">
        <h2 id="matrix-title" class="section-title">SpecScore a colpo d'occhio.</h2>
        <p class="section-note">
          Una panoramica di alto livello tra gli strumenti più vicini. Ciascuno ha
          punti di forza reali — apri uno dei confronti sopra per la versione
          dettagliata e trasparente.
        </p>

        <div class="table-wrap">
          <table class="matrix-table" aria-label="SpecScore vs Plain Markdown, OpenSpec, Spec Kit, Datarim e CodeSpeak, Kiro, Tessl, BMAD Method, Task Master AI">
            <thead>
              <tr>
                <th scope="col">Capacità</th>
                <th scope="col" class="matrix-table__own">SpecScore</th>
                <th scope="col"><a href="/it/vs/plain-markdown/" class="matrix-table__link">Plain Markdown</a></th>
                <th scope="col"><a href="/it/vs/openspec/" class="matrix-table__link">OpenSpec</a></th>
                <th scope="col"><a href="/it/vs/spec-kit/" class="matrix-table__link">Spec Kit</a></th>
                <th scope="col"><a href="/it/vs/datarim/" class="matrix-table__link">Datarim</a></th>
                <th scope="col"><a href="/it/vs/codespeak/" class="matrix-table__link">CodeSpeak</a></th>
                <th scope="col"><a href="/it/vs/kiro/" class="matrix-table__link">Kiro</a></th>
                <th scope="col"><a href="/it/vs/tessl/" class="matrix-table__link">Tessl</a></th>
                <th scope="col"><a href="/it/vs/bmad-method/" class="matrix-table__link">BMAD Method</a></th>
                <th scope="col"><a href="/it/vs/task-master-ai/" class="matrix-table__link">Task Master AI</a></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Ruolo principale</td>
                <td class="matrix-table__own">Formato di specifica con linter + CLI</td>
                <td>Documenti liberi (l'approccio predefinito)</td>
                <td>Framework di organizzazione delle specifiche</td>
                <td>Flusso di lavoro / metodologia</td>
                <td>Workflow pack per Claude Code</td>
                <td>Compilatore LLM (specifica → codice)</td>
                              <td>IDE agentico che scrive le spec</td>
                <td>Piattaforma di skill + tile di spec</td>
                <td>Metodo agile con IA</td>
                <td>Elenco di task per agenti</td>
</tr>
              <tr>
                <td>Formato di specifica</td>
                <td class="matrix-table__own">Markdown + YAML (strutturato)</td>
                <td>Markdown libero</td>
                <td>Markdown</td>
                <td>Markdown libero</td>
                <td>Markdown (orientato al workflow)</td>
                <td>Inglese semplice</td>
                              <td>requirements.md in EARS</td>
                <td>.spec.md (tile)</td>
                <td>PRD, architettura, storie</td>
                <td>PRD in prosa, poi i task</td>
</tr>
              <tr>
                <td>Mantieni il tuo codice</td>
                <td class="matrix-table__own"><span class="yes">Sì</span></td>
                <td><span class="yes">Sì</span></td>
                <td><span class="yes">Sì</span></td>
                <td><span class="yes">Sì</span></td>
                <td><span class="yes">Sì</span></td>
                <td><span class="no">Il codice viene generato</span></td>
                              <td><span class="yes">Sì</span></td>
                <td><span class="yes">Sì</span></td>
                <td><span class="yes">Sì</span></td>
                <td><span class="yes">Sì</span></td>
</tr>
              <tr>
                <td>Open source / gratuito</td>
                <td class="matrix-table__own"><span class="yes">Sì</span> (CC BY / MIT)</td>
                <td><span class="yes">Gratuito</span></td>
                <td><span class="yes">Sì</span> (MIT)</td>
                <td><span class="yes">Sì</span> (MIT)</td>
                <td><span class="yes">Sì</span> (MIT)</td>
                <td><span class="no">Sistema proprietario</span></td>
                              <td>IDE proprietario, piano gratuito</td>
                <td>Tile MIT; la piattaforma è un prodotto</td>
                <td>Sì (MIT)</td>
                <td>MIT + Commons Clause</td>
</tr>
              <tr>
                <td>Linting del contenuto delle specifiche</td>
                <td class="matrix-table__own"><span class="yes">Sì</span></td>
                <td><span class="no">No</span></td>
                <td>Solo struttura</td>
                <td><span class="no">No</span></td>
                <td><span class="no">No</span></td>
                <td>Non documentato</td>
                              <td>Analisi nel prodotto</td>
                <td>Controlli shell nel tile</td>
                <td>Gate di prontezza del flusso</td>
                <td><span class="no">No</span></td>
</tr>
              <tr>
                <td>ID di requisiti / AC</td>
                <td class="matrix-table__own"><span class="yes">Sì</span></td>
                <td><span class="no">No</span></td>
                <td><span class="no">No</span></td>
                <td><span class="no">No</span></td>
                <td><span class="no">No</span></td>
                <td><span class="no">No</span></td>
                              <td>Non documentato</td>
                <td>Link [@test]</td>
                <td>File di storia</td>
                <td>Id numerici di task</td>
</tr>
              <tr>
                <td>Ciclo di vita applicato</td>
                <td class="matrix-table__own"><span class="yes">Sì</span></td>
                <td><span class="no">No</span></td>
                <td><span class="no">No</span></td>
                <td><span class="no">No</span></td>
                <td><span class="no">No</span></td>
                <td><span class="no">No</span></td>
                              <td>Stato del task</td>
                <td>Approvazione nel tile</td>
                <td>Stato di sprint / storia</td>
                <td>Stato e tag</td>
</tr>
              <tr>
                <td>Tracciabilità codice-specifica</td>
                <td class="matrix-table__own"><span class="yes">Sì</span></td>
                <td><span class="no">No</span></td>
                <td><span class="no">No</span></td>
                <td><span class="no">No</span></td>
                <td><span class="no">No</span></td>
                <td>Tramite rigenerazione</td>
                              <td>Tramite i task</td>
                <td>targets e [@test]</td>
                <td>Le storie portano il contesto</td>
                <td>Dipendenze dei task</td>
</tr>
              <tr>
                <td>Dipendenza di runtime</td>
                <td class="matrix-table__own">Nessuna (binario Go)</td>
                <td>Nessuna</td>
                <td>Node.js</td>
                <td>Python</td>
                <td>Claude Code</td>
                <td>Compilatore del fornitore</td>
                              <td>App Kiro</td>
                <td>CLI Tessl + un agente</td>
                <td>Node.js e Python</td>
                <td>Node.js</td>
</tr>
              <tr>
                <td>Funziona con qualsiasi agente o nessuno</td>
                <td class="matrix-table__own"><span class="yes">Sì</span></td>
                <td>Legge ogni file</td>
                <td>Molti agenti</td>
                <td>Molti agenti</td>
                <td>Claude Code</td>
                <td>Tramite CodeSpeak</td>
                              <td>Agenti di Kiro</td>
                <td>Molti agenti</td>
                <td>Molti agenti di codice</td>
                <td>Via MCP</td>
</tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <ComparisonFeedback />
  </main>

  <SiteFooterIt />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-4) var(--space-3) var(--space-2);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__headline {
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-1);
  }
  .hero__sub {
    font-size: 1rem;
    color: var(--mid-ink);
    line-height: 1.5;
  }

  /* Pull the mini-cards up tight under the hero */
  .minis-section {
    padding-top: var(--space-3);
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Screen-reader only ── */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Mini comparison cards ── */
  .minis__lead {
    text-align: center;
    line-height: 1.05;
    margin-bottom: var(--space-3);
  }
  .minis__brand {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .minis__vs {
    display: block;
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
  }
  .minis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }
  .mini {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-top: 2px solid var(--validator-green);
    padding: var(--space-3);
    text-decoration: none;
    color: inherit;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .mini:hover {
    border-color: var(--graphite);
    box-shadow: 0 2px 8px rgba(26, 26, 26, 0.06);
  }
  .mini:focus-visible {
    outline: 2px solid var(--ink-blue);
    outline-offset: 2px;
  }
  .mini__name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
  }
  .mini__line {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  @media (max-width: 980px) {
    .minis { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    .minis { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── Section title / note (matrix) ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
    max-width: 60ch;
  }

  /* ── Cross-comparison matrix ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .matrix-table th,
  .matrix-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .matrix-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .matrix-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .matrix-table td,
  .matrix-table th {
    min-width: 130px;
  }
  /* Highlight the SpecScore column */
  .matrix-table__own {
    background: var(--surface);
    font-weight: 600;
    color: var(--ink);
    border-left: 2px solid var(--validator-green);
    border-right: 2px solid var(--validator-green);
  }
  thead .matrix-table__own {
    color: var(--validator-green);
    border-bottom-color: var(--validator-green);
  }
  /* Column-header links to each comparison */
  .matrix-table__link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted var(--pale-ink);
    transition: color 160ms ease, border-color 160ms ease;
  }
  .matrix-table__link:hover {
    color: var(--validator-green);
    border-bottom-color: var(--validator-green);
  }
  .matrix-table__link:focus-visible {
    outline: 2px solid var(--ink-blue);
    outline-offset: 2px;
  }
  .matrix-table .yes {
    color: var(--validator-green);
    font-weight: 600;
  }
  .matrix-table .no {
    color: var(--pale-ink);
  }
</style>
