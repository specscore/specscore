---
// /it/vs/spec-kit/ — Confronto tra SpecScore e GitHub Spec Kit.
// Onesto, basato sui fatti, fianco a fianco. Spec Kit è un flusso di lavoro/metodologia;
// SpecScore è il formato di artefatto a cui può puntare. Si compongono.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterIt from '../../../../components/SiteFooterIt.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
import MoreComparisons from '../../../../components/MoreComparisons.astro';
---

<BaseLayout
  lang="it"
  title="SpecScore vs Spec Kit — Confronto onesto."
  description="Un confronto oggettivo e affiancato di SpecScore e GitHub Spec Kit: workflow vs formato, linting, ciclo di vita, tracciabilità e CLI. Si compongono — ecco come."
  canonical="https://specscore.md/it/vs/spec-kit/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/it/vs/" class="xref">Confronti</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs Spec Kit
        </h1>
        <p class="hero__sub">
          Operano su livelli diversi. Spec Kit è un <strong>flusso di lavoro</strong> —
          un processo guidato che porta un agente dall'idea all'implementazione.
          SpecScore è il <strong>formato</strong> in cui le specifiche vengono scritte, oltre a una CLI
          che le verifica con lint, le interroga e le traccia. Spec Kit può produrre file SpecScore.
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Cosa hanno in comune.</h2>
        <ul class="shared-list">
          <li>La stessa stella polare — le specifiche prima del codice, con gli agenti IA considerati lettori di prima classe.</li>
          <li>Le specifiche vivono nel tuo repository come Markdown — con controllo versione, revisionabili nelle pull request.</li>
          <li>Entrambi sono open source con licenza MIT.</li>
          <li>Entrambi supportano Claude Code, Cursor, Copilot e altri agenti di sviluppo assistito da IA.</li>
        </ul>
      </div>
    </section>

    {/* ── What Spec Kit does well ── */}
    <section class="section" aria-labelledby="speckit-title">
      <div class="section-inner section-inner--prose">
        <h2 id="speckit-title" class="section-title">Cosa fa bene Spec Kit.</h2>
        <p class="section-note">
          <a href="https://github.com/github/spec-kit" rel="nofollow noopener" target="_blank" class="xref">Spec Kit</a>
          è un flusso di lavoro per lo sviluppo guidato da specifiche ideato da GitHub Next.
        </p>

        <div class="credit-card">
          <h3 class="credit-card__title">Un processo completo e opinionato</h3>
          <p class="credit-card__desc">
            Spec Kit offre l'intero percorso:
            <code>constitution → specify → plan → tasks → implement</code>.
            Ogni passaggio include un comando slash e un prompt studiati per mantenere l'agente
            sui binari. Se cerchi un processo strutturato, Spec Kit te ne fornisce uno pronto all'uso.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Forte distribuzione e riconoscibilità</h3>
          <p class="credit-card__desc">
            Supportato da GitHub Next, con un'ampia community e una libreria in costante crescita di
            estensioni. Per molti sviluppatori, Spec Kit rappresenta il primo approccio allo sviluppo
            basato su specifiche.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Comandi indipendenti dall'agente</h3>
          <p class="credit-card__desc">
            I comandi di Spec Kit funzionano su Claude Code, Cursor, Copilot e altri —
            il flusso di lavoro guida l'agente a prescindere da quale strumento tu stia utilizzando.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Confronto delle funzionalità.</h2>
        <p class="section-note">
          Questi strumenti rispondono a domande diverse, quindi la tabella confronta i ruoli, non i vincitori.
        </p>

        <div class="table-wrap">
          <table class="compare-table" aria-label="Confronto delle funzionalità SpecScore vs Spec Kit">
            <thead>
              <tr>
                <th scope="col">Capacità</th>
                <th scope="col">Spec Kit</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Ruolo principale</td>
                <td>Flusso di lavoro / metodologia</td>
                <td><strong>Formato di archiviazione + CLI</strong></td>
              </tr>
              <tr>
                <td>Output della specifica</td>
                <td>Markdown in formato libero</td>
                <td><strong>Markdown + YAML frontmatter</strong> (strutturato)</td>
              </tr>
              <tr>
                <td>Linting delle specifiche</td>
                <td>Nessuno</td>
                <td><strong>Qualità dei contenuti</strong> — verbi vaghi, AC mancanti, riferimenti orfani</td>
              </tr>
              <tr>
                <td>ID per requisiti / AC</td>
                <td>Nessuno</td>
                <td><strong>ID indirizzabili via software</strong> (<code>REQ: slug</code>)</td>
              </tr>
              <tr>
                <td>Stato del ciclo di vita</td>
                <td>Implicito (passaggio del flusso di lavoro)</td>
                <td><strong>Applicato rigorosamente</strong> — Draft → Approved → Implementing → Stable → Deprecated</td>
              </tr>
              <tr>
                <td>Tracciabilità codice-a-specifica</td>
                <td>Nessuna</td>
                <td><strong>Annotazioni <code>specscore:</code></strong> + trailer di commit <code>Verifies:</code></td>
              </tr>
              <tr>
                <td>Interrogazione specifiche da CLI</td>
                <td>Scaffolding (<code>specify</code>, <code>plan</code>, <code>tasks</code>)</td>
                <td><strong>API di interrogazione</strong> — <code>feature list / show / deps</code>, <code>lint</code>, <code>code refs</code></td>
              </tr>
              <tr>
                <td>Dipendenza da runtime</td>
                <td>Python</td>
                <td><strong>Nessuna</strong> — singolo binario Go</td>
              </tr>
              <tr>
                <td>Integrazione CI</td>
                <td>Esecuzione del workflow</td>
                <td><strong><code>specscore lint</code></strong> esce con codice non-zero, hook di pre-commit</td>
              </tr>
              <tr>
                <td>Relazione</td>
                <td colspan="2"><strong>Si compongono</strong> — Spec Kit può produrre file in formato SpecScore</td>
              </tr>
              <tr>
                <td>Licenza</td>
                <td>MIT</td>
                <td>MIT</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore goes further ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">Cosa aggiunge SpecScore.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">L'output è verificabile via lint</h3>
            <p class="diff-card__desc">
              Spec Kit produce Markdown in formato libero — buono o cattivo che sia, si consegna così com'è.
              SpecScore verifica il risultato su due livelli: <code>lint</code>
              controlla in modo deterministico che ogni requisito abbia criteri di accettazione,
              che i riferimenti incrociati siano risolti e che le transizioni di stato siano valide — e un revisore di
              IA (<code>/review</code>, <code>/score</code>) rileva criteri ambigui
              e verbi vaghi.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> link  <span class="dim">"Related Feature: discount-tiers" not found</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">L'output è interrogabile</h3>
            <p class="diff-card__desc">
              Spec Kit scrive file; rileggerli significa aprirli uno per uno. Le specifiche di SpecScore
              rispondono alle domande direttamente da CLI: <code>specscore feature list</code>,
              <code>feature deps</code>, <code>code refs</code> — così l'agente naviga
              il grafo delle specifiche senza dover leggere ogni singolo file nel repository.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Ogni requisito ha un ID</h3>
            <p class="diff-card__desc">
              Spec Kit fa riferimento ai requisiti in linguaggio naturale. SpecScore assegna ID basati su slug
              (<code>REQ: slug-format</code>) e ID per i criteri di accettazione che sopravvivono a rinomine,
              refactoring e passaggi di consegne tra agenti.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Il ciclo di vita viene applicato rigorosamente</h3>
            <p class="diff-card__desc">
              In Spec Kit, la fase di una specifica corrisponde al punto in cui ti trovi nel flusso di lavoro.
              In SpecScore, il ciclo di vita è un campo di stato effettivo — Draft → Approved
              → Implementing → Stable → Deprecated — validato dal lint e modificato
              tramite <code>specscore change-status</code> da git hook o CI.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Il codice risale alle specifiche</h3>
            <p class="diff-card__desc">
              Spec Kit non offre un meccanismo di tracciabilità. SpecScore include
              annotazioni di origine <code>specscore:</code> e trailer di commit <code>Verifies:</code>
              — esegui <code>specscore code refs</code> per ottenere una risposta deterministica
              a "quale codice implementa questo requisito?".
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Nessuna dipendenza da runtime</h3>
            <p class="diff-card__desc">
              SpecScore è un singolo binario Go — nessun runtime da installare.
              Funziona in progetti Go, Rust, Python, Java o JavaScript senza
              aggiungere nulla al toolchain.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Quando usare l'uno o l'altro.</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Scegli Spec Kit se…</h3>
            <ul class="when-card__list">
              <li>Vuoi un processo guidato e opinionato dall'idea all'implementazione.</li>
              <li>Il tuo team ha bisogno della disciplina di passaggi espliciti come specify / plan / tasks.</li>
              <li>Stai definendo uno standard comune su come guidare gli agenti in un team.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Usa SpecScore se…</h3>
            <ul class="when-card__list">
              <li>Hai bisogno di specifiche che gli agenti possano verificare con lint, interrogare e modificare senza leggere ogni file.</li>
              <li>Ti serve tracciabilità da codice a specifica con una risposta deterministica.</li>
              <li>Stai costruendo un sistema complesso con molte feature e transizioni di ciclo di vita.</li>
              <li>Vuoi zero dipendenze da runtime — un singolo binario, nessun toolchain di linguaggio richiesto.</li>
              <li>Hai bisogno di controlli di qualità in CI che escano con codice non-zero, come ESLint o <code>go vet</code>.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── The integration opportunity ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">SpecScore estende Spec Kit — non lo sostituisce.</h2>
        <p class="prose-p">
          Spec Kit è il processo per produrre una specifica; SpecScore è il formato
          in cui quella specifica può essere scritta. Un'estensione per Spec Kit che esporta nel formato
          SpecScore è in fase di sviluppo — potrai eseguire il flusso di lavoro di Spec Kit e ottenere dall'altra parte specifiche verificabili con lint,
          interrogabili e tracciabili.
        </p>
        <p class="prose-p">
          Scegli Spec Kit per il processo. Scegli SpecScore per l'artefatto. Usali entrambi
          quando desideri entrambi i vantaggi.
        </p>
      </div>
    </section>

    <MoreComparisons />
    <ComparisonFeedback page="spec-kit" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Specifiche che superano la prova.</h2>
      <div class="final-cta__buttons">
        <a href="/it/cli/install/" class="btn btn--primary">Installa la CLI</a>
        <a href="/it/ai/specstudio-skills/" class="btn btn--secondary">Ottieni le skill IA per il tuo agente</a>
        <a
          href="https://github.com/specscore/specscore"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          Open source su GitHub
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterIt />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__breadcrumb {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Shared list ── */
  .shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shared-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }
  .shared-list li::before {
    content: '=';
    position: absolute;
    left: 0;
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pale-ink);
  }

  /* ── Section note ── */
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }

  /* ── Credit cards ── */
  .credit-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .credit-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .credit-card__desc {
    color: var(--mid-ink);
    line-height: 1.6;
    font-size: var(--fs-body);
  }
  .credit-card__desc code {
    font-size: 0.9em;
    background: var(--cream);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Feature comparison table ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .compare-table td:nth-child(2),
  .compare-table td:nth-child(3) {
    min-width: 200px;
  }
  .compare-table td code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .compare-table strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* ── Diff grid ── */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .diff-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .diff-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .diff-card__desc {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .diff-card__desc code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .diff-card__example {
    margin-top: var(--space-2);
  }
  .diff-card__example .terminal {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .diff-grid { grid-template-columns: 1fr; }
  }

  /* ── When to use which ── */
  .when-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .when-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .when-card--primary {
    border-color: var(--validator-green);
    border-width: 2px;
  }
  .when-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .when-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .when-card__list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
    font-size: var(--fs-small);
  }
  .when-card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--pale-ink);
    font-family: var(--font-code);
  }
  .when-card--primary .when-card__list li::before {
    color: var(--validator-green);
  }
  .when-card__list code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; }
  }

  /* ── Bridge section ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-2);
  }
  .prose-p:last-child {
    margin-bottom: 0;
    font-weight: 500;
    color: var(--ink);
  }
  .prose-p code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    text-align: center;
  }
  .final-cta__title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .final-cta__buttons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
