---
// SpecStudio Skills — landing page in Italian.
// Canonical campaign URL: specscore.md/it/ai/specstudio-skills/
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterIt from '../../../../components/SiteFooterIt.astro';
import QsTabsScript from '../../../../components/QsTabsScript.astro';
---

<BaseLayout
  lang="it"
  title="SpecStudio Skills — Specifiche che il tuo agente IA può seguire davvero."
  description="Plugin gratuito per Claude Code che trasforma prompt improvvisati in specifiche strutturate e valutate che il tuo agente legge prima di scrivere una sola riga di codice. Costruito sul protocollo aperto SpecScore."
  canonical="https://specscore.md/it/ai/specstudio-skills/"
>
  <SiteHeader />

  <main>
    {/* ── Sezione 1: Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 id="hero-title" class="hero__headline">
          Specifiche che il tuo agente IA<br />può seguire davvero.
        </h1>
        <p class="hero__sub">
          SpecStudio Skills è un plugin gratuito per Claude Code che trasforma
          prompt improvvisati in specifiche strutturate e valutate che il tuo agente
          legge prima di scrivere una singola riga di codice. Costruito sul
          protocollo aperto
          <a class="xref" href="/it/">SpecScore</a>.
        </p>
        <div class="hero__install" id="install">
          <div class="qs-tabs" role="tablist" aria-label="Metodo di installazione">
            <button type="button" role="tab" id="qs-tab-claude" aria-controls="qs-panel-claude" aria-selected="true" tabindex="0" class="qs-tab is-active" data-tab="claude">Claude Code</button>
            <button type="button" role="tab" id="qs-tab-setup" aria-controls="qs-panel-setup" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="setup">Altri agenti IA</button>
            <button type="button" role="tab" id="qs-tab-manual" aria-controls="qs-panel-manual" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="manual">Manuale</button>
          </div>

          <div id="qs-panel-claude" role="tabpanel" aria-labelledby="qs-tab-claude" class="qs-panel is-active" data-panel="claude">
<pre class="terminal"><span class="prompt">$</span> /plugin marketplace add specscore/ai-marketplace
<span class="prompt">$</span> /plugin install specstudio@specscore</pre>
          </div>
          <div id="qs-panel-setup" role="tabpanel" aria-labelledby="qs-tab-setup" class="qs-panel" data-panel="setup" hidden>
<pre class="terminal"><span class="prompt">$</span> specscore agent setup &lt;nome-agente&gt;</pre>
            <p class="qs-note">
              Scrive il file di istruzioni corretto per il tuo agente —
              <code>claude</code>, <code>copilot</code>, <code>cursor</code>, <code>codex</code>,
              <code>antigravity.google</code>, <code>pi.dev</code> o <code>opencode</code>.
              Esegui all'interno di un progetto gestito da SpecScore. Richiede la
              <a class="xref" href="/it/cli/">CLI di SpecScore</a>.
            </p>
          </div>
          <div id="qs-panel-manual" role="tabpanel" aria-labelledby="qs-tab-manual" class="qs-panel" data-panel="manual" hidden>
<pre class="terminal"><span class="prompt">$</span> git clone https://github.com/specscore/specstudio-skills
<span class="prompt">$</span> cp -r specstudio-skills/commands /percorso/al/tuo/agente/commands/
<span class="prompt">$</span> cp -r specstudio-skills/skills /percorso/al/tuo/agente/skills/</pre>
            <p class="qs-note">
              Clona il repository del plugin e copia le directory
              <code>commands/</code> e <code>skills/</code> dove il tuo agente carica
              i file dei comandi e delle skill.
            </p>
          </div>
        </div>
        <p class="hero__demo-link">
          <a href="#demo" class="xref">Guarda la demo di 60 secondi ↓</a>
        </p>
      </div>
    </section>

    {/* ── Sezione 2: Demo ── */}
    <section class="section" id="demo" aria-labelledby="demo-title">
      <div class="section-inner">
        <h2 id="demo-title" class="section-title">
          Da un'idea vaga a una specifica valutata, in 60 secondi.
        </h2>

        <div class="demo-placeholder">
          <div class="terminal-frame">
            <div class="terminal-frame__head">
              <span class="terminal-frame__title">Claude Code</span>
              <span class="terminal-frame__hint">demo</span>
            </div>
<pre class="terminal terminal-frame__body"><span class="prompt">&gt;</span> /specstudio:ideate A password reset flow for our SaaS app.

<span class="dim">Refining idea...</span>
<span class="dim">Producing spec/ideas/password-reset.md</span>

<span class="prompt">&gt;</span> /specstudio:specify spec/ideas/password-reset.md

<span class="dim">Writing Feature spec...</span>
<span class="dim">spec/features/password-reset/README.md</span>

<span class="prompt">$</span> specscore lint spec/features/password-reset/
<span class="mark-pass">PASS</span>  Feature: password-reset
  <span class="mark-pass">PASS</span>  has title, status, and description
  <span class="mark-pass">PASS</span>  requirements have acceptance criteria
  <span class="mark-pass">PASS</span>  all AC IDs are unique
  <span class="mark-pass">PASS</span>  no orphan cross-references

<span class="mark-pass">Score: 92 / 100</span></pre>
          </div>
          <p class="demo-caption">
            Senza montaggi. Senza tagli. Claude Code da zero → installa il plugin →
            valuta una specifica reale → il tuo agente costruisce la cosa giusta.
          </p>
        </div>
      </div>
    </section>

    {/* ── Sezione 3: Il problema ── */}
    <section class="section" aria-labelledby="wedge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="wedge-title" class="section-title">
          Perché il tuo agente continua a costruire la cosa sbagliata.
        </h2>
        <p class="prose-p">
          I prompt improvvisati funzionano finché non smettono di funzionare. L'agente
          ha costruito metà della feature. Ha frainteso il requisito. Si è inventato una
          chiamata API. Ha scelto la libreria sbagliata. Riscrivi il prompt. Lo riscrivi
          di nuovo. Al terzo tentativo stai già scrivendo l'intera specifica a mano
          nella chat.
        </p>
        <p class="prose-p">
          Il problema non è l'agente. È che "costruiscimi una feature" non è
          una specifica — è un desiderio. Gli agenti sono stocastici. I desideri sono
          compatibili con la stocasticità. Le specifiche no.
        </p>
        <p class="prose-p">
          SpecStudio Skills ti offre un flusso di lavoro per scrivere specifiche che il tuo
          agente può effettivamente interpretare: feature strutturate, requisiti,
          criteri di accettazione, con punteggio di completezza prima ancora che
          l'agente le veda. La stessa velocità del vibe-coding, drammaticamente
          meno varianza nel risultato.
        </p>
      </div>
    </section>

    {/* ── Sezione 4: La pipeline ── */}
    <section class="section pipeline-section" aria-labelledby="pipeline-title">
      <div class="section-inner">
        <h2 id="pipeline-title" class="section-title">
          Quattro comandi. Una sola pipeline.
        </h2>
        <p class="pipeline-intro">
          Installa una volta, poi eseguili in ordine — dall'idea grezza a un piano eseguibile.
        </p>

        <div class="pipeline-grid">
          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/ideate</span>
            </div>
            <p class="pipeline-card__desc">
              Perfeziona un'idea grezza attraverso un pensiero divergente e convergente
              strutturato. Produce un one-pager pre-specifica verificabile con linter.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/specify</span>
            </div>
            <p class="pipeline-card__desc">
              Trasforma un'idea approvata in una Feature di SpecScore con
              requisiti, criteri di accettazione e blocchi Given/When/Then.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/plan</span>
            </div>
            <p class="pipeline-card__desc">
              Scompone una feature in un elenco ordinato di task. Ciascun task
              si mappa su uno o più criteri di accettazione.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/implement</span>
            </div>
            <p class="pipeline-card__desc">
              Esegue il prossimo task del piano. Un sotto-agente per task,
              commit tracciabili verso gli AC, diff in stage per la tua approvazione.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── Sezione 5: Cosa include ── */}
    <section class="section" aria-labelledby="box-title">
      <div class="section-inner section-inner--prose">
        <h2 id="box-title" class="section-title">
          Cosa include.
        </h2>

        <h3 class="list-heading">Fa:</h3>
        <ul class="feature-list feature-list--does">
          <li>Aggiunge comandi slash per l'intero flusso SDD: <code>/ideate</code>, <code>/specify</code>, <code>/plan</code>, <code>/implement</code>.</li>
          <li>Valuta la completezza e l'ambiguità della specifica prima che l'agente la veda.</li>
          <li>Scrive specifiche nel formato aperto SpecScore — senza estensioni proprietarie.</li>
        </ul>

        <h3 class="list-heading">Non fa:</h3>
        <ul class="feature-list feature-list--doesnt">
          <li>Eseguire l'agente al posto tuo. Il plugin è uno strato di workflow; l'agente rimane Claude.</li>
          <li>Inviare dati all'esterno. Specifiche e punteggi restano locali.</li>
          <li>Creare lock-in. Se lo disinstalli, le tue specifiche rimangono valido Markdown valutabile con la CLI <a class="xref" href="https://github.com/specscore/specscore">specscore</a>.</li>
        </ul>

        <p class="sibling-callout">
          Cerchi l'interfaccia CLI neutrale?
          <a class="xref" href="https://github.com/specscore/ai-plugin-specscore">ai-plugin-specscore</a>
          è il wrapper leggero. SpecStudio Skills è il flusso di lavoro strutturato costruito sopra di esso.
        </p>
      </div>
    </section>

    {/* ── Sezione 6: Costruito su standard aperto ── */}
    <section class="section" aria-labelledby="open-title">
      <div class="section-inner section-inner--prose">
        <h2 id="open-title" class="section-title">
          Costruito sul protocollo aperto SpecScore.
        </h2>
        <p class="prose-p">
          SpecStudio Skills scrive specifiche in
          <a class="xref" href="/it/">SpecScore</a>, uno standard
          aperto. Il formato è Markdown leggibile da esseri umani. Lo schema è
          pubblicato. La CLI è open source. Nessun vendor lock-in. Se un giorno
          lascerai SpecStudio, le tue specifiche verranno con te.
        </p>
      </div>
    </section>
  </main>

  {/* ── CTA finale ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Provalo.</h2>
      <div class="final-cta__install">
        <div class="qs-tabs" role="tablist" aria-label="Metodo di installazione">
          <button type="button" role="tab" id="qs-tab-claude-b" aria-controls="qs-panel-claude-b" aria-selected="true" tabindex="0" class="qs-tab is-active" data-tab="claude">Claude Code</button>
          <button type="button" role="tab" id="qs-tab-setup-b" aria-controls="qs-panel-setup-b" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="setup">Altri agenti IA</button>
          <button type="button" role="tab" id="qs-tab-manual-b" aria-controls="qs-panel-manual-b" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="manual">Manuale</button>
        </div>

        <div id="qs-panel-claude-b" role="tabpanel" aria-labelledby="qs-tab-claude-b" class="qs-panel is-active" data-panel="claude">
<pre class="terminal"><span class="prompt">$</span> /plugin marketplace add specscore/ai-marketplace
<span class="prompt">$</span> /plugin install specstudio@specscore</pre>
        </div>
        <div id="qs-panel-setup-b" role="tabpanel" aria-labelledby="qs-tab-setup-b" class="qs-panel" data-panel="setup" hidden>
<pre class="terminal"><span class="prompt">$</span> specscore agent setup &lt;nome-agente&gt;</pre>
          <p class="qs-note">
            Scrive il file di istruzioni corretto per il tuo agente —
            <code>claude</code>, <code>copilot</code>, <code>cursor</code>, <code>codex</code>,
            <code>antigravity.google</code>, <code>pi.dev</code> o <code>opencode</code>.
            Esegui all'interno di un progetto gestito da SpecScore. Richiede la
            <a class="xref" href="/it/cli/">CLI di SpecScore</a>.
          </p>
        </div>
        <div id="qs-panel-manual-b" role="tabpanel" aria-labelledby="qs-tab-manual-b" class="qs-panel" data-panel="manual" hidden>
<pre class="terminal"><span class="prompt">$</span> git clone https://github.com/specscore/specstudio-skills
<span class="prompt">$</span> cp -r specstudio-skills/commands /percorso/al/tuo/agente/commands/
<span class="prompt">$</span> cp -r specstudio-skills/skills /percorso/al/tuo/agente/skills/</pre>
          <p class="qs-note">
            Clona il repository del plugin e copia le directory
            <code>commands/</code> e <code>skills/</code> dove il tuo agente carica
            i file dei comandi e delle skill.
          </p>
        </div>
      </div>
      <p class="final-cta__note">
        Gratuito per repository pubblici e open source. Licenza MIT.
      </p>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterIt />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-7) var(--space-3) var(--space-6);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    margin-bottom: var(--space-4);
    line-height: 1.55;
  }
  .hero__install {
    margin-bottom: var(--space-3);
  }
  .hero__demo-link {
    font-size: var(--fs-small);
    color: var(--mid-ink);
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Demo ── */
  .demo-placeholder {
    margin-top: var(--space-3);
  }
  .demo-caption {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    color: var(--mid-ink);
  }

  /* Terminal frame (shared with homepage AiSkills pattern) */
  .terminal-frame {
    border: 1px solid var(--hairline);
    background: var(--surface);
  }
  .terminal-frame__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--hairline);
    background: var(--cream-2);
    font-family: var(--font-code);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .terminal-frame__title { color: var(--graphite); font-weight: 700; }
  .terminal-frame__hint  { color: var(--mid-ink); }
  .terminal-frame__body  { border: none !important; }

  /* ── Wedge (prose sections) ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-3);
  }
  .prose-p:last-child {
    margin-bottom: 0;
  }

  /* ── Pipeline grid ── */
  .pipeline-section {
    background: var(--cream-2);
  }
  .pipeline-intro {
    color: var(--mid-ink);
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }
  .pipeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }
  .pipeline-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .pipeline-card__head {
    margin-bottom: var(--space-2);
  }
  .pipeline-card__cmd {
    font-family: var(--font-code);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .pipeline-card__desc {
    font-size: var(--fs-small);
    color: var(--mid-ink);
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .pipeline-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .pipeline-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── What's in the box ── */
  .list-heading {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .list-heading:first-of-type {
    margin-top: 0;
  }
  .feature-list {
    margin: 0 0 var(--space-3) 0;
    padding-left: 1.25rem;
    color: var(--mid-ink);
    line-height: 1.65;
  }
  .feature-list li {
    margin-bottom: 0.5rem;
  }
  .feature-list li:last-child {
    margin-bottom: 0;
  }
  .feature-list code {
    font-size: 0.9em;
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }
  .sibling-callout {
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid var(--hairline);
    font-size: var(--fs-small);
    color: var(--mid-ink);
    line-height: 1.55;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    text-align: center;
  }
  .final-cta__title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .final-cta__install {
    display: inline-block;
    text-align: left;
    margin-bottom: var(--space-3);
  }
  .final-cta__note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
  }
</style>

<QsTabsScript />
