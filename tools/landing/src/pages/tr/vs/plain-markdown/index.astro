---
// /tr/vs/plain-markdown/ — SpecScore vs plain Markdown / Notion / Jira (the default).
// The default is the hardest competitor. Don't fight it head-on —
// position SpecScore as what your existing Markdown specs can graduate to.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterTr from '../../../../components/SiteFooterTr.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
import MoreComparisons from '../../../../components/MoreComparisons.astro';
---

<BaseLayout
  lang="tr"
  title="SpecScore vs Plain Markdown — Dürüst Karşılaştırma."
  description="SpecScore ile varsayılan yaklaşımın objektif bir karşılaştırması: amaca yönelik Markdown, Notion ve Jira biletleri. Aynı Markdown, ancak ajanların lint edebileceği, sorgulayabileceği ve izleyebileceği bir yapı ile."
  canonical="https://specscore.md/tr/vs/plain-markdown/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/tr/vs/" class="xref">Karşılaştırmalar</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs Plain Markdown
        </h1>
        <p class="hero__sub">
          Çoğu ekip zaten "spesifikasyonlara" sahiptir — bir doküman klasöründeki
          amaca yönelik Markdown, Notion sayfaları veya Jira biletleri. Ücretsizdir,
          zaten oradadır ve işe yarar. SpecScore ise <strong>aynı Markdown</strong>'dır;
          yapay zeka ajanlarının lint edebileceği, sorgulayabileceği ve koda geri
          izleyebileceği bir yapı eklenmiş halidir.
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Ortak noktaları.</h2>
        <ul class="shared-list">
          <li>Her halükarda Markdown'dır — düz metin, insanlar tarafından okunabilir, diff dostudur.</li>
          <li>Spesifikasyonlar deponuzda yaşayabilir, sürüm kontrollü ve PR'larda incelenebilir.</li>
          <li>Tescilli bir format veya kilitlenme yoktur — istediğiniz editörde okuyabilirsiniz.</li>
          <li>Yine düzyazı yazarsınız; SpecScore onun yerine geçmek yerine etrafına yapı ekler.</li>
        </ul>
      </div>
    </section>

    {/* ── What plain Markdown does well ── */}
    <section class="section" aria-labelledby="default-title">
      <div class="section-inner section-inner--prose">
        <h2 id="default-title" class="section-title">Varsayılan yaklaşımın iyi yaptığı şeyler.</h2>
        <p class="section-note">
          Düz Markdown, Notion ve Jira gerçek varsayılandır. Bunu hak etmişlerdir.
        </p>

        <div class="credit-card">
          <h3 class="credit-card__title">Sıfır öğrenme eğrisi</h3>
          <p class="credit-card__desc">
            Şema yok, zorunlu alanlar yok, akışta CLI yok. Bir dosya açın,
            yazmaya başlayın. Tek seferlik bir not veya küçük bir proje için bu
            tam olarak doğrudur — ihtiyacınız olmayan yapı yalnızca sürtünme yaratır.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Zaten kurulu</h3>
          <p class="credit-card__desc">
            Ekibiniz zaten Notion, Confluence veya bir <code>docs/</code> klasöründedir.
            Benimseyecek veya taşıyacak bir şey yoktur. En düşük sürtünmeli seçenek,
            halihazırda kullandığınız seçenektir.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Evrensel olarak taşınabilir</h3>
          <p class="credit-card__desc">
            Düz Markdown her yerde açılır ve her aracın ötesinde yaşar.
            SpecScore tam olarak bu özellik üzerine inşa edilmiştir — bu yüzden
            SpecScore bir veritabanı değil, yine Markdown'dır.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Özellik karşılaştırması.</h2>
        <p class="section-note">
          Fark dosya türü değil — bir ajanın onunla ne yapabileceğidir.
        </p>

        <div class="table-wrap">
          <table class="compare-table" aria-label="SpecScore vs Plain Markdown özellik karşılaştırması">
            <thead>
              <tr>
                <th scope="col">Yetenek</th>
                <th scope="col">Düz Markdown / Notion</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Format</td>
                <td>Serbest biçimli Markdown / dokümanlar</td>
                <td><strong>Markdown + YAML frontmatter</strong> (yapılandırılmış)</td>
              </tr>
              <tr>
                <td>Gereksinimler nerede yaşar</td>
                <td>Jira, Notion, Slack, birinin zihni</td>
                <td><strong>Depoda, kodun hemen yanında</strong></td>
              </tr>
              <tr>
                <td>"Bu spesifikasyon tamamlandı mı?"</td>
                <td>Bir insan okur ve karar verir</td>
                <td><strong><code>specscore lint</code></strong> — otomatik</td>
              </tr>
              <tr>
                <td>Belirsizlik tespiti</td>
                <td>Yok — muğlak fiiller sessizce geçer</td>
                <td><strong>Muğlak fiiller, eksik AC'ler, askıda referanslar işaretlenir</strong></td>
              </tr>
              <tr>
                <td>Gereksinim / AC kimlikleri</td>
                <td>Yok</td>
                <td><strong>Makine tarafından adreslenebilir kimlikler</strong> (<code>REQ: slug</code>)</td>
              </tr>
              <tr>
                <td>Yaşam döngüsü durumu</td>
                <td>Takip ediliyorsa bile örtük</td>
                <td><strong>Uygulanan</strong> — Draft → Approved → Implementing → Stable</td>
              </tr>
              <tr>
                <td>Koddan spesifikasyona izlenebilirlik</td>
                <td>Yok</td>
                <td><strong><code>specscore:</code> açıklamaları</strong> + <code>Verifies:</code> fragmanları</td>
              </tr>
              <tr>
                <td>Ajan navigasyonu</td>
                <td>Bir şey bulmak için her dosyayı okuma</td>
                <td>CLI'dan <strong>spesifikasyon grafiğini sorgulama</strong></td>
              </tr>
              <tr>
                <td>CI'da kalite kapısı</td>
                <td>Yok</td>
                <td><strong><code>specscore lint</code></strong> tıpkı bir linter gibi sıfır olmayan kodla çıkar</td>
              </tr>
              <tr>
                <td>Öğrenme eğrisi</td>
                <td><strong>Yok</strong></td>
                <td>Öğrenilecek bir format (kademeli)</td>
              </tr>
              <tr>
                <td>Maliyet / lisans</td>
                <td>Ücretsiz</td>
                <td>Ücretsiz, açık kaynak</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore goes further ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">SpecScore'un daha ileri gittiği alanlar.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">Belirsizlik yorumlanmaz, yakalanır</h3>
            <p class="diff-card__desc">
              Serbest biçimli spesifikasyonlarda, bir ajanla her etkileşim
              yorumlamayla başlar — "giriş çalışmalı" ifadesi, doğru ile
              akla yatkın ama yanlış arasında bir yazı-turadır. SpecScore'un <code>lint</code>
              komutu, bir ajan harekete geçmeden önce muğlak fiili ve eksik kabul kriterini işaretler.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint auth/login.md
  <span class="mark-fail">✗</span> R1  <span class="dim">"should work" — ölçülebilir değil</span>
  <span class="mark-fail">✗</span> R1  no acceptance criteria</pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Yanlış yorumlamalar birikmeyi durdurur</h3>
            <p class="diff-card__desc">
              Bir ajan bir gereksinimi yanlış yorumlar, ikincisi bunun üzerine inşa eder,
              üçüncüsü her ikisine de bağımlı olur — ve bunu üç ajan sonra fark edersiniz.
              Yapılandırılmış kabul kriterleri her ajana aynı başarılı/başarısız koşullarını verir;
              böylece yorumlama aralarında sapmaz.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Kod, spesifikasyona geri izlenir</h3>
            <p class="diff-card__desc">
              Düz dokümanların uyguladıkları kodla hiçbir bağlantısı yoktur. SpecScore kaynakta
              <code>specscore:</code> açıklamaları ve commit'te <code>Verifies:</code> fragmanları
              ekler — <code>specscore code refs</code> "bu gereksinimi hangi kod uyguluyor?"
              sorusunu deterministik olarak yanıtlar.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Kırk bilet yerine tek bir spesifikasyon</h3>
            <p class="diff-card__desc">
              Yeni bir ekip arkadaşı (veya taze bir ajan), niyeti kırk Jira biletinden ve bir
              Slack dizisinden yeniden oluşturmak yerine, tüm bağlamıyla birlikte bir özellik
              spesifikasyonunu okur.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Ajanlar yeniden okumak yerine sorgular</h3>
            <p class="diff-card__desc">
              Bir doküman klasöründe "ne devam ediyor?" sorusunu bulmak dosyaları açmak anlamına gelir.
              SpecScore'da ise bu <code>specscore feature list</code> komutudur — spesifikasyon grafiği
              CLI'dan yanıt verir; böylece ajanlar depoyu yeniden okuyarak bağlamı tüketmez.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Kalite CI'da uygulanır</h3>
            <p class="diff-card__desc">
              Serbest biçimli spesifikasyonların bir kapısı yoktur — yarım yazılmış olanı da
              tam olanı kadar kolay birleştirilir. <code>specscore lint</code>, tıpkı ESLint veya
              <code>go vet</code>'in kodu koruması gibi, sorunlarda sıfır olmayan bir kodla çıkar.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Hangisi ne zaman kullanılmalı?</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Şu durumlarda düz Markdown uygundur…</h3>
            <ul class="when-card__list">
              <li>Tek seferlik bir not, bir deneme veya yapıya ihtiyaç duymayacak kadar küçük bir proje ise.</li>
              <li>Dokümandan hiçbir yapay zeka ajanı kod üretmeyecekse — bir insan okuyup doğrudan anlayabiliyorsa.</li>
              <li>Birinin uygulayacağı bir gereksinimi değil, kaba bir fikri yakalıyorsanız.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Şu durumlarda SpecScore'a başvurun…</h3>
            <ul class="when-card__list">
              <li>Bir yapay zeka ajanı spesifikasyondan kod üretiyorsa — belirsizlik hatalı koda dönüşür.</li>
              <li>Birden fazla ajan veya insan aynı gereksinimlere bağımlıysa.</li>
              <li>Hangi kodun hangi gereksinimi uyguladığını bilmeniz gerekiyorsa.</li>
              <li>"Bu spesifikasyon bitti mi?" sorusunu bir toplantı değil, bir araç yanıtlamalıysa.</li>
              <li>Proje her şeyi yeniden okumanın ölçeklenemeyeceği kadar büyükse.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── The adoption path ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">Halihazırda sahip olduğunuz spesifikasyonları geliştirin.</h2>
        <p class="prose-p">
          Birikiminizi dönüştürmez veya araçlarınızı değiştirmezsiniz. Bir sonraki özelliğinizi seçin,
          onun için bir SpecScore spesifikasyonu yazın ve <code>specscore lint</code> çalıştırın — biletinizin
          gözden kaçırdığı bir şeyi yakalayıp yakalamadığına bakın. Uyguladığınızda <code>specscore:</code>
          açıklamaları ekleyin. Yalnızca faydalı olduysa bir sonraki sprinte genişletin.
        </p>
        <p class="prose-p">
          Düz Markdown giriş rampasıdır. SpecScore ise onun evrildiği haldir.
        </p>
      </div>
    </section>

    <MoreComparisons />
    <ComparisonFeedback page="plain-markdown" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Geçen spesifikasyonlar.</h2>
      <div class="final-cta__buttons">
        <a href="/tr/cli/install/" class="btn btn--primary">CLI'ı kurun</a>
        <a href="/tr/ai/specstudio-skills/" class="btn btn--secondary">Ajanınız için yapay zeka becerilerini edinin</a>
        <a
          href="https://github.com/specscore/specscore"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          GitHub'da Açık Kaynak
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterTr />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__breadcrumb {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Shared list ── */
  .shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shared-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }
  .shared-list li::before {
    content: '=';
    position: absolute;
    left: 0;
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pale-ink);
  }

  /* ── Section note ── */
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }

  /* ── Credit cards ── */
  .credit-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .credit-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .credit-card__desc {
    color: var(--mid-ink);
    line-height: 1.6;
    font-size: var(--fs-body);
  }
  .credit-card__desc code {
    font-size: 0.9em;
    background: var(--cream);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Feature comparison table ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .compare-table td:nth-child(2),
  .compare-table td:nth-child(3) {
    min-width: 200px;
  }
  .compare-table td code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .compare-table strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* ── Diff grid ── */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .diff-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .diff-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .diff-card__desc {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .diff-card__desc code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .diff-card__example {
    margin-top: var(--space-2);
  }
  .diff-card__example .terminal {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .diff-grid { grid-template-columns: 1fr; }
  }

  /* ── When to use which ── */
  .when-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .when-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .when-card--primary {
    border-color: var(--validator-green);
    border-width: 2px;
  }
  .when-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .when-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .when-card__list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
    font-size: var(--fs-small);
  }
  .when-card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--pale-ink);
    font-family: var(--font-code);
  }
  .when-card--primary .when-card__list li::before {
    color: var(--validator-green);
  }
  .when-card__list code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; }
  }

  /* ── Adoption section ── */
  .prose-p {
