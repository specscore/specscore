---
// /tr/vs/spec-kit/ — SpecScore vs GitHub Spec Kit comparison.
// Honest, factual, side-by-side. Spec Kit is a workflow/methodology;
// SpecScore is the artifact format it can target. They compose.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterTr from '../../../../components/SiteFooterTr.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="tr"
  title="SpecScore vs Spec Kit — Dürüst Karşılaştırma."
  description="SpecScore ve GitHub Spec Kit'in objektif ve yan yana karşılaştırması: iş akışı vs format, linting, yaşam döngüsü, izlenebilirlik ve CLI. Birlikte çalışırlar — işte nasıl."
  canonical="https://specscore.md/tr/vs/spec-kit/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/tr/vs/" class="xref">Karşılaştırmalar</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs Spec Kit
        </h1>
        <p class="hero__sub">
          Farklı katmanlarda çalışırlar. Spec Kit bir <strong>iş akışıdır</strong> —
          bir ajanı fikirden uygulamaya taşıyan rehberli bir süreçtir.
          SpecScore ise spesifikasyonların yazıldığı <strong>formattır</strong>; ayrıca onları
          lint eden, sorgulayan ve izleyen bir CLI'dır. Spec Kit, SpecScore dosyaları üretebilir.
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Ortak noktaları.</h2>
        <ul class="shared-list">
          <li>Aynı kutup yıldızı — koddan önce spesifikasyonlar, birinci sınıf okuyucu olarak yapay zeka ajanları.</li>
          <li>Spesifikasyonlar deponuzda Markdown olarak yaşar — sürüm kontrollü ve PR'larda incelenebilir.</li>
          <li>Her ikisi de MIT lisansı altında açık kaynaklıdır.</li>
          <li>Her ikisi de Claude Code, Cursor, Copilot ve diğer yapay zeka kodlama ajanlarını hedefler.</li>
        </ul>
      </div>
    </section>

    {/* ── What Spec Kit does well ── */}
    <section class="section" aria-labelledby="speckit-title">
      <div class="section-inner section-inner--prose">
        <h2 id="speckit-title" class="section-title">Spec Kit'in iyi yaptığı şeyler.</h2>
        <p class="section-note">
          <a href="https://github.com/github/spec-kit" rel="nofollow noopener" target="_blank" class="xref">Spec Kit</a>,
          GitHub Next'in spesifikasyon odaklı geliştirme iş akışıdır.
        </p>

        <div class="credit-card">
          <h3 class="credit-card__title">Eksiksiz ve kararlı bir süreç</h3>
          <p class="credit-card__desc">
            Spec Kit size tüm süreci sunar:
            <code>constitution → specify → plan → tasks → implement</code>.
            Her adım, ajanı raylarda tutmak için tasarlanmış bir eğik çizgi komutuna ve bir prompt'a sahiptir.
            Bir süreç istiyorsanız, Spec Kit size bir tane sunar.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Güçlü dağıtım ve bilinirlik</h3>
          <p class="credit-card__desc">
            GitHub Next tarafından desteklenen geniş bir topluluk ve büyüyen bir uzantı kütüphanesi.
            Birçok geliştirici için Spec Kit, karşılaştıkları ilk spesifikasyon odaklı iş akışıdır.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Ajandan bağımsız komutlar</h3>
          <p class="credit-card__desc">
            Spec Kit komutları Claude Code, Cursor, Copilot ve daha fazlasında çalışır —
            hangisini çalıştırırsanız çalıştırın iş akışı ajanı yönlendirir.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Özellik karşılaştırması.</h2>
        <p class="section-note">
          Bu araçlar farklı soruları yanıtlar; bu yüzden tablo kazananları değil, rolleri karşılaştırır.
        </p>

        <div class="table-wrap">
          <table class="compare-table" aria-label="SpecScore vs Spec Kit özellik karşılaştırması">
            <thead>
              <tr>
                <th scope="col">Yetenek</th>
                <th scope="col">Spec Kit</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Ana rol</td>
                <td>İş akışı / metodoloji</td>
                <td><strong>Depolama formatı + CLI</strong></td>
              </tr>
              <tr>
                <td>Spesifikasyon çıktısı</td>
                <td>Serbest biçimli Markdown</td>
                <td><strong>Markdown + YAML frontmatter</strong> (yapılandırılmış)</td>
              </tr>
              <tr>
                <td>Spesifikasyon linting</td>
                <td>Yok</td>
                <td><strong>İçerik kalitesi</strong> — belirsiz fiiller, eksik AC'ler, askıda referanslar</td>
              </tr>
              <tr>
                <td>Gereksinim / AC kimlikleri</td>
                <td>Yok</td>
                <td><strong>Makine tarafından adreslenebilir kimlikler</strong> (<code>REQ: slug</code>)</td>
              </tr>
              <tr>
                <td>Yaşam döngüsü durumu</td>
                <td>Örtük (iş akışı adımı)</td>
                <td><strong>Uygulanan</strong> — Draft → Approved → Implementing → Stable → Deprecated</td>
              </tr>
              <tr>
                <td>Koddan spesifikasyona izlenebilirlik</td>
                <td>Yok</td>
                <td><strong><code>specscore:</code> açıklamaları</strong> + <code>Verifies:</code> commit fragmanları</td>
              </tr>
              <tr>
                <td>CLI'dan spesifikasyon sorgulama</td>
                <td>İskele oluşturma (<code>specify</code>, <code>plan</code>, <code>tasks</code>)</td>
                <td><strong>Sorgu API'si</strong> — <code>feature list / show / deps</code>, <code>lint</code>, <code>code refs</code></td>
              </tr>
              <tr>
                <td>Çalışma zamanı bağımlılığı</td>
                <td>Python</td>
                <td><strong>Yok</strong> — tek bir Go ikili dosyası</td>
              </tr>
              <tr>
                <td>CI entegrasyonu</td>
                <td>İş akışını çalıştırma</td>
                <td><strong><code>specscore lint</code></strong> sıfır olmayan kodla çıkar, pre-commit kancaları</td>
              </tr>
              <tr>
                <td>İlişki</td>
                <td colspan="2"><strong>Birlikte çalışırlar</strong> — Spec Kit, SpecScore dosyaları üretebilir</td>
              </tr>
              <tr>
                <td>Lisans</td>
                <td>MIT</td>
                <td>MIT</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore goes further ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">SpecScore'un ekledikleri.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">Çıktı lint edilebilir</h3>
            <p class="diff-card__desc">
              Spec Kit serbest biçimli Markdown üretir — iyi ya da kötü, teslim edilir.
              SpecScore sonucu iki katmanda denetler: <code>lint</code>, her gereksinimin kabul
              kriterlerine sahip olduğunu, çapraz referansların çözümlendiğini ve durum geçişlerinin
              geçerli olduğunu deterministik olarak doğrular — bir yapay zeka denetçisi
              (<code>/review</code>, <code>/score</code>) ise belirsiz kriterleri ve muğlak fiilleri yakalar.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> link  <span class="dim">"Related Feature: discount-tiers" not found</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Çıktı sorgulanabilir</h3>
            <p class="diff-card__desc">
              Spec Kit dosyaları yazar; onları geri okumak dosyaları açmak demektir. SpecScore
              spesifikasyonları soruları CLI'dan yanıtlar: <code>specscore feature list</code>,
              <code>feature deps</code>, <code>code refs</code> — böylece bir ajan depodaki her
              dosyayı okumadan spesifikasyon grafiğinde gezinir.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Her gereksinimin bir kimliği vardır</h3>
            <p class="diff-card__desc">
              Spec Kit gereksinimlere düzyazı ile referans verir. SpecScore yeniden adlandırmalara,
              yeniden düzenlemelere ve ajanlar arası devirlere karşı hayatta kalan slug tabanlı kimlikler
              (<code>REQ: slug-format</code>) ve AC kimlikleri atar.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Yaşam döngüsü uygulanır</h3>
            <p class="diff-card__desc">
              Spec Kit'te bir spesifikasyonun aşaması, iş akışında nerede olduğunuzdur.
              SpecScore'da ise yaşam döngüsü zorunlu bir durum alanıdır — Draft → Approved
              → Implementing → Stable → Deprecated — lint tarafından doğrulanır ve git kancalarından
              veya CI'dan <code>specscore change-status</code> ile geçişi yapılır.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Kod, spesifikasyonlara geri izlenir</h3>
            <p class="diff-card__desc">
              Spec Kit'in izlenebilirlik mekanizması yoktur. SpecScore kaynakta
              <code>specscore:</code> açıklamalarına ve commit'te <code>Verifies:</code> fragmanlarına
              sahiptir — "bu gereksinimi hangi kod uyguluyor?" sorusuna deterministik bir yanıt için
              <code>specscore code refs</code> komutunu çalıştırın.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Çalışma zamanı bağımlılığı yok</h3>
            <p class="diff-card__desc">
              SpecScore tek bir Go ikili dosyasıdır — kurulacak bir çalışma zamanı yoktur.
              Araç zincirine hiçbir şey eklemeden Go, Rust, Python, Java veya JavaScript projelerinde çalışır.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Hangisi ne zaman kullanılmalı?</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Şu durumlarda Spec Kit'e başvurun…</h3>
            <ul class="when-card__list">
              <li>Fikirden uygulamaya rehberli ve kararlı bir süreç istiyorsanız.</li>
              <li>Ekibiniz açıkça specify / plan / tasks adımlarının disiplinine ihtiyaç duyuyorsa.</li>
              <li>Bir ekip genelinde ajanların nasıl yönlendirildiğini standartlaştırıyorsanız.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Şu durumlarda SpecScore'u kullanın…</h3>
            <ul class="when-card__list">
              <li>Ajanların her dosyayı okumadan lint edebileceği, sorgulayabileceği ve değiştirebileceği spesifikasyonlara ihtiyacınız varsa.</li>
              <li>Deterministik bir yanıtla koddan spesifikasyona izlenebilirliğe ihtiyacınız varsa.</li>
              <li>Birçok özellik ve yaşam döngüsü geçişi içeren büyük bir sistem inşa ediyorsanız.</li>
              <li>Sıfır çalışma zamanı bağımlılığı istiyorsanız — tek bir ikili dosya, dil araç zinciri gerekmez.</li>
              <li>CI'da ESLint veya <code>go vet</code> gibi sıfır olmayan kodla çıkan spesifikasyon kalite kapılarına ihtiyacınız varsa.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── The integration opportunity ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">SpecScore, Spec Kit'i genişletir — onun yerine geçmez.</h2>
        <p class="prose-p">
          Spec Kit bir spesifikasyon üretme sürecidir; SpecScore ise bu spesifikasyonun yazılabileceği formattır.
          SpecScore formatı çıktısı veren bir SpecKit uzantısı yoldadır — Spec Kit iş akışını çalıştırın ve
          diğer taraftan lint edilen, sorgulanan ve izlenen spesifikasyonlar elde edin.
        </p>
        <p class="prose-p">
          Süreç için Spec Kit'i seçin. Yapay nesne için SpecScore'u seçin. Her ikisini de istediğinizde her ikisini birden çalıştırın.
        </p>
      </div>
    </section>

    <ComparisonFeedback page="spec-kit" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Geçen spesifikasyonlar.</h2>
      <div class="final-cta__buttons">
        <a href="/tr/cli/install/" class="btn btn--primary">CLI'ı kurun</a>
        <a href="/tr/ai/specstudio-skills/" class="btn btn--secondary">Ajanınız için yapay zeka becerilerini edinin</a>
        <a
          href="https://github.com/specscore/specscore"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          GitHub'da Açık Kaynak
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterTr />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__breadcrumb {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Shared list ── */
  .shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shared-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }
  .shared-list li::before {
    content: '=';
    position: absolute;
    left: 0;
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pale-ink);
  }

  /* ── Section note ── */
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }

  /* ── Credit cards ── */
  .credit-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .credit-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .credit-card__desc {
    color: var(--mid-ink);
    line-height: 1.6;
    font-size: var(--fs-body);
  }
  .credit-card__desc code {
    font-size: 0.9em;
    background: var(--cream);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Feature comparison table ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .compare-table td:nth-child(2),
  .compare-table td:nth-child(3) {
    min-width: 200px;
  }
  .compare-table td code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .compare-table strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* ── Diff grid ── */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .diff-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .diff-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .diff-card__desc {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .diff-card__desc code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .diff-card__example {
    margin-top: var(--space-2);
  }
  .diff-card__example .terminal {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .diff-grid { grid-template-columns: 1fr; }
  }

  /* ── When to use which ── */
  .when-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .when-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .when-card--primary {
    border-color: var(--validator-green);
    border-width: 2px;
  }
  .when-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .when-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .when-card__list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
    font-size: var(--fs-small);
  }
  .when-card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--pale-ink);
    font-family: var(--font-code);
  }
  .when-card--primary .when-card__list li::before {
    color: var(--validator-green);
  }
  .when-card__list code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; }
  }

