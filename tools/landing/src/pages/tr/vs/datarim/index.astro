---
// /tr/vs/datarim/ — SpecScore vs Datarim comparison.
// Datarim is a Claude Code workflow pack; SpecScore is the open format
// a workflow can target. No public attack — two packs, one open format.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterTr from '../../../../components/SiteFooterTr.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="tr"
  title="SpecScore vs Datarim — Dürüst Karşılaştırma."
  description="SpecScore ve Datarim'in objektif bir karşılaştırması: Claude Code için bir iş akışı paketi ile açık ve taşınabilir bir spesifikasyon formatı. Farklı katmanlar — ve birlikte çalışabilirler."
  canonical="https://specscore.md/tr/vs/datarim/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/tr/vs/" class="xref">Karşılaştırmalar</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs Datarim
        </h1>
        <p class="hero__sub">
          Farklı katmanlar. Datarim, Claude Code için kararlı bir <strong>iş akışı paketidir</strong> —
          bir projeyi gereksinimlerden tamamlanmaya kadar taşıyan eğik çizgi komutlarıdır (slash commands).
          SpecScore ise spesifikasyonların yazıldığı <strong>açık format</strong> ile bunları lint eden,
          sorgulayan ve izleyen bir CLI'dır. Bir iş akışı bu formatı hedefleyebilir.
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Ortak noktaları.</h2>
        <ul class="shared-list">
          <li>Her ikisi de yapay zeka destekli geliştirmeye yapılandırılmış metodoloji getirir.</li>
          <li>Her ikisi de MIT lisansı altında açık kaynaklıdır.</li>
          <li>Her ikisi de Claude Code içinde çalışır — Datarim komutlar olarak, SpecScore ise SpecStudio Skills aracılığıyla.</li>
          <li>Her ikisi de durumlarını depoda Markdown olarak sürüm kontrolünde tutar.</li>
        </ul>
      </div>
    </section>

    {/* ── What Datarim does well ── */}
    <section class="section" aria-labelledby="datarim-title">
      <div class="section-inner section-inner--prose">
        <h2 id="datarim-title" class="section-title">Datarim'in iyi yaptığı şeyler.</h2>
        <p class="section-note">
          <a href="https://github.com/Arcanada-one/datarim" rel="nofollow noopener" target="_blank" class="xref">Datarim</a>,
          Claude Code için geliştirilmiş evrensel bir yinelemeli iş akışı framework'üdür.
        </p>

        <div class="credit-card">
          <h3 class="credit-card__title">Yerel eğik çizgi komutları deneyimi</h3>
          <p class="credit-card__desc">
            Komutlar olarak tam bir işlem hattı — <code>/dr-prd</code>, <code>/dr-plan</code>,
            <code>/dr-design</code>, <code>/dr-do</code>, <code>/dr-qa</code> — Claude Code içinde
            tamamen yerel hissettirir. <code>~/.claude/</code> dizinine bir <code>install.sh</code>
            çalıştırırsınız ve hazırsınız.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Karmaşıklığa duyarlı yönlendirme (L1–L4)</h3>
          <p class="credit-card__desc">
            Datarim işi boyutlandırır ve buna göre yönlendirir: L1 hızlı bir düzeltme planlamayı atlar,
            L4 büyük bir değişiklik ise birden fazla inceleme döngüsüne sahip aşamalı bir işlem hattı yürütür.
            Töreni kapsama göre ayarlamak gerçekten iyi bir fikirdir.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Consilium ve çok alanlı kapsam</h3>
          <p class="credit-card__desc">
            "Consilium" mekanizması, bir kararı önermeden önce ödünleşimleri tartışmak üzere bir ajan paneli
            toplar. Ve yalnızca yazılımla sınırlı değildir — Datarim ayrıca araştırma, hukuk ve içerik iş akışlarını da hedefler.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Özellik karşılaştırması.</h2>
        <p class="section-note">
          Biri iş akışı, diğeri formattır — tablo kazananları değil, rolleri karşılaştırır.
        </p>

        <div class="table-wrap">
          <table class="compare-table" aria-label="SpecScore vs Datarim özellik karşılaştırması">
            <thead>
              <tr>
                <th scope="col">Yetenek</th>
                <th scope="col">Datarim</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Ana rol</td>
                <td>Claude Code için iş akışı paketi</td>
                <td><strong>Açık spesifikasyon formatı + CLI</strong></td>
              </tr>
              <tr>
                <td>Çalışma şekli</td>
                <td>Eğik çizgi komutları (<code>/dr-*</code>)</td>
                <td>Format dosyaları + CLI <span class="dim">(+ Claude Code'da SpecStudio Skills)</span></td>
              </tr>
              <tr>
                <td>Durum depolama</td>
                <td><code>backlog.md</code> + <code>CLAUDE.md</code> (iş akışı biçimli)</td>
                <td><strong>Taşınabilir <code>spec/</code> ağacı</strong> (Markdown + YAML)</td>
              </tr>
              <tr>
                <td>Araç olmadan hayatta kalma</td>
                <td>Datarim çalışma zamanına bağlı</td>
                <td><strong>Evet</strong> — tasarım gereği taşınabilir</td>
              </tr>
              <tr>
                <td>Spesifikasyon linting</td>
                <td>Yok</td>
                <td><strong>İçerik kalitesi</strong> — belirsiz fiiller, eksik AC'ler, askıda referanslar</td>
              </tr>
              <tr>
                <td>Gereksinim / AC kimlikleri</td>
                <td>Yok</td>
                <td><strong>Makine tarafından adreslenebilir kimlikler</strong> (<code>REQ: slug</code>)</td>
              </tr>
              <tr>
                <td>Koddan spesifikasyona izlenebilirlik</td>
                <td>Yok</td>
                <td><strong><code>specscore:</code> ek açıklamaları</strong> + <code>Verifies:</code> fragmanları</td>
              </tr>
              <tr>
                <td>Karmaşıklık yönlendirmesi (L1–L4)</td>
                <td><strong>Evet</strong></td>
                <td>Hayır (iş akışı değil, formattır)</td>
              </tr>
              <tr>
                <td>Sorgulanabilir spesifikasyon grafiği</td>
                <td>Hayır</td>
                <td><strong>Evet</strong> — <code>feature list / show / deps</code></td>
              </tr>
              <tr>
                <td>Claude Code'a bağımlılık</td>
                <td>Onun için inşa edildi</td>
                <td><strong>Hayır</strong> — herhangi bir ajan veya hiçbiri</td>
              </tr>
              <tr>
                <td>Lisans</td>
                <td>MIT</td>
                <td>MIT / CC BY 4.0</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore goes further ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">SpecScore'un daha ileri gittiği alanlar.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">Çıktı, iş akışından daha uzun yaşar</h3>
            <p class="diff-card__desc">
              Datarim'in durumu kendi birikiminde ve <code>CLAUDE.md</code> biçiminde yaşar —
              Datarim'i çalıştırdığınız sürece değerlidir. SpecScore spesifikasyonları, hiçbir SpecScore aracı
              yüklü olmasa bile okunabilir, lint edilebilir ve sorgulanabilir kalan taşınabilir bir formattır.
              İş akışı değişebilir; spesifikasyonlar sizinle kalır.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Spesifikasyonlar lint edilebilir</h3>
            <p class="diff-card__desc">
              Bir iş akışı yazmaya rehberlik eder ancak sonucu denetlemez. SpecScore'un
              <code>lint</code> komutu, her gereksinimin kabul kriterlerine sahip olduğunu,
              çapraz referansların çözümlendiğini ve durum geçişlerinin geçerli olduğunu doğrular.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> link  <span class="dim">"Related Feature: discount-tiers" not found</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Kod, spesifikasyonlara geri izlenir</h3>
            <p class="diff-card__desc">
              SpecScore kaynakta <code>specscore:</code> açıklamaları ve commit'te
              <code>Verifies:</code> fragmanları ekler — <code>specscore code refs</code>
              spesifikasyonu hangi iş akışının ürettiğinden bağımsız olarak
              "bu gereksinimi hangi kod uyguluyor?" sorusunu deterministik şekilde yanıtlar.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Tek bir ajana bağlı değildir</h3>
            <p class="diff-card__desc">
              Datarim, Claude Code için inşa edilmiştir. SpecScore ise herhangi bir ajanın okuyabileceği bir format
              ve herhangi bir CI'ın çalıştırabileceği tek bir Go ikili dosyasıdır — Claude Code veya
              <code>~/.claude/</code> kurulumu gerektirmez.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Hangisi ne zaman kullanılmalı?</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Şu durumlarda Datarim'i tercih edin…</h3>
            <ul class="when-card__list">
              <li>Bugün Claude Code içinde eksiksiz ve kararlı bir işlem hattı istiyorsanız.</li>
              <li>Karmaşıklığa duyarlı yönlendirmeye ve çok ajanlı karar ritüeline değer veriyorsanız.</li>
              <li>Çalışmanız yalnızca kodu değil; araştırma, hukuk veya içerik gibi alanları da kapsıyorsa.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Şu durumlarda SpecScore'u kullanın…</h3>
            <ul class="when-card__list">
              <li>Herhangi bir bireysel iş akışından veya araçtan daha uzun yaşayan spesifikasyonlar istiyorsanız.</li>
              <li>Linting, kimlikler, yaşam döngüsü ve koddan spesifikasyona izlenebilirliğe ihtiyacınız varsa.</li>
              <li>Yalnızca Claude Code ile değil; farklı ajanlar arasında veya ajansız çalışıyorsanız.</li>
              <li>Ajanların depoyu tekrar tekrar okumak yerine doğrudan sorgulayabileceği bir CLI istiyorsanız.</li>
              <li>CI ortamında sıfır olmayan çıkış koduyla başarısız olan spesifikasyon kalite denetimleri istiyorsanız.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── Two packs, one format ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">İki iş akışı paketi, bir açık format.</h2>
        <p class="prose-p">
          Datarim ve SpecStudio Skills, Claude Code üzerinde çalışan iki kararlı iş akışıdır.
          SpecScore ise temel açık formattır — bir iş akışının üretebileceği yapay nesnedir; böylece
          işlem hattı bittikten sonra da spesifikasyonlar taşınabilir, lint edilebilir ve izlenebilir kalır.
          SpecScore çıktısı veren bir Datarim, kendi kullanım kolaylığını korurken kalıcı bir çıktı kazanır.
        </p>
        <p class="prose-p">
          İşlem hattı için Datarim'i seçin. Arkasında bıraktığı kalıcı yapay nesne için SpecScore'u kullanın.
        </p>
      </div>
    </section>

    <ComparisonFeedback page="datarim" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Geçen spesifikasyonlar.</h2>
      <div class="final-cta__buttons">
        <a href="/tr/cli/install/" class="btn btn--primary">CLI'ı kurun</a>
        <a href="/tr/ai/specstudio-skills/" class="btn btn--secondary">Ajanınız için yapay zeka becerilerini edinin</a>
        <a
          href="https://github.com/specscore/specscore"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          GitHub'da Açık Kaynak
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterTr />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__breadcrumb {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Shared list ── */
  .shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shared-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }
  .shared-list li::before {
    content: '=';
    position: absolute;
    left: 0;
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pale-ink);
  }

  /* ── Section note ── */
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }

  /* ── Credit cards ── */
  .credit-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .credit-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .credit-card__desc {
    color: var(--mid-ink);
    line-height: 1.6;
    font-size: var(--fs-body);
  }
  .credit-card__desc code {
    font-size: 0.9em;
    background: var(--cream);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Feature comparison table ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .compare-table td:nth-child(2),
  .compare-table td:nth-child(3) {
    min-width: 200px;
  }
  .compare-table td code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .compare-table strong {
    font-weight: 600;
    color: var(--ink);
  }
  .compare-table .dim {
    color: var(--pale-ink);
  }

  /* ── Diff grid ── */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .diff-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .diff-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .diff-card__desc {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .diff-card__desc code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .diff-card__example {
    margin-top: var(--space-2);
  }
  .diff-card__example .terminal {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .diff-grid { grid-template-columns: 1fr; }
  }

  /* ── When to use which ── */
  .when-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .when-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .when-card--primary {
    border-color: var(--validator-green);
    border-width: 2px;
  }
  .when-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .when-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .when-card__list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
    font-size: var(--fs-small);
  }
  .when-card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--pale-ink);
    font-family: var(--font-code);
  }
  .when-card--primary .when-card__list li::before {
    color: var(--validator-green);
  }
  .when-card__list code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; }
  }

  /* ── Bridge section ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-2);
  }
  .prose-p:last-child {
    margin-bottom: 0;
    font-weight: 500;
    color: var(--ink);
  }
  .prose-p code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Final CTA ── */
