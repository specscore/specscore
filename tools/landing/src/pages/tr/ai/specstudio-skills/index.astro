---
// SpecStudio Skills — Turkish translation.
// Canonical campaign URL: specscore.md/tr/ai/specstudio-skills/
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterTr from '../../../../components/SiteFooterTr.astro';
import QsTabsScript from '../../../../components/QsTabsScript.astro';
---

<BaseLayout
  lang="tr"
  title="SpecStudio Skills — Yapay Zeka Ajanınızın Gerçekten Takip Edebileceği Spesifikasyonlar."
  description="Doğaçlama promptları, ajanın tek bir satır kod yazmadan önce okuduğu yapılandırılmış ve puanlanmış spesifikasyonlara dönüştüren ücretsiz Claude Code eklentisi. Açık SpecScore protokolü üzerine inşa edilmiştir."
  canonical="https://specscore.md/tr/ai/specstudio-skills/"
>
  <SiteHeader />

  <main>
    {/* ── Bölüm 1: Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 id="hero-title" class="hero__headline">
          Yapay zeka ajanınızın<br />gerçekten takip edebileceği spesifikasyonlar.
        </h1>
        <p class="hero__sub">
          SpecStudio Skills, doğaçlama promptları, ajanın tek bir satır kod yazmadan
          önce okuduğu yapılandırılmış ve puanlanmış spesifikasyonlara dönüştüren ücretsiz bir
          Claude Code eklentisidir. Açık
          <a class="xref" href="/tr/">SpecScore</a> protokolü üzerine inşa edilmiştir.
        </p>
        <div class="hero__install" id="install">
          <div class="qs-tabs" role="tablist" aria-label="Kurulum yöntemi">
            <button type="button" role="tab" id="qs-tab-claude" aria-controls="qs-panel-claude" aria-selected="true" tabindex="0" class="qs-tab is-active" data-tab="claude">Claude Code</button>
            <button type="button" role="tab" id="qs-tab-setup" aria-controls="qs-panel-setup" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="setup">Diğer yapay zeka ajanları</button>
            <button type="button" role="tab" id="qs-tab-manual" aria-controls="qs-panel-manual" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="manual">Manuel</button>
          </div>

          <div id="qs-panel-claude" role="tabpanel" aria-labelledby="qs-tab-claude" class="qs-panel is-active" data-panel="claude">
<pre class="terminal"><span class="prompt">$</span> /plugin marketplace add specscore/ai-marketplace
<span class="prompt">$</span> /plugin install specstudio@specscore</pre>
          </div>
          <div id="qs-panel-setup" role="tabpanel" aria-labelledby="qs-tab-setup" class="qs-panel" data-panel="setup" hidden>
<pre class="terminal"><span class="prompt">$</span> specscore agent setup &lt;ajan-adı&gt;</pre>
            <p class="qs-note">
              Ajanınız için doğru talimat dosyasını yazar —
              <code>claude</code>, <code>copilot</code>, <code>cursor</code>, <code>codex</code>,
              <code>antigravity.google</code>, <code>pi.dev</code> veya <code>opencode</code>.
              SpecScore tarafından yönetilen bir proje içinde çalıştırın. Requiere la
              <a class="xref" href="/tr/cli/">SpecScore CLI</a>.
            </p>
          </div>
          <div id="qs-panel-manual" role="tabpanel" aria-labelledby="qs-tab-manual" class="qs-panel" data-panel="manual" hidden>
<pre class="terminal"><span class="prompt">$</span> git clone https://github.com/specscore/specstudio-skills
<span class="prompt">$</span> cp -r specstudio-skills/commands /yol/ajan/commands/
<span class="prompt">$</span> cp -r specstudio-skills/skills /yol/ajan/skills/</pre>
            <p class="qs-note">
              Eklenti reposunu klonlayın ve <code>commands/</code> ile <code>skills/</code>
              dizinlerini ajanınızın komut ve beceri dosyalarını yüklediği konuma kopyalayın.
            </p>
          </div>
        </div>
        <p class="hero__demo-link">
          <a href="#demo" class="xref">60 saniyelik demoyu izleyin ↓</a>
        </p>
      </div>
    </section>

    {/* ── Bölüm 2: Demo ── */}
    <section class="section" id="demo" aria-labelledby="demo-title">
      <div class="section-inner">
        <h2 id="demo-title" class="section-title">
          Belirsiz fikirden puanlanmış spesifikasyona, 60 saniyede.
        </h2>

        <div class="demo-placeholder">
          <div class="terminal-frame">
            <div class="terminal-frame__head">
              <span class="terminal-frame__title">Claude Code</span>
              <span class="terminal-frame__hint">demo</span>
            </div>
<pre class="terminal terminal-frame__body"><span class="prompt">&gt;</span> /specstudio:ideate A password reset flow for our SaaS app.

<span class="dim">Refining idea...</span>
<span class="dim">Producing spec/ideas/password-reset.md</span>

<span class="prompt">&gt;</span> /specstudio:specify spec/ideas/password-reset.md

<span class="dim">Writing Feature spec...</span>
<span class="dim">spec/features/password-reset/README.md</span>

<span class="prompt">$</span> specscore lint spec/features/password-reset/
<span class="mark-pass">PASS</span>  Feature: password-reset
  <span class="mark-pass">PASS</span>  has title, status, and description
  <span class="mark-pass">PASS</span>  requirements have acceptance criteria
  <span class="mark-pass">PASS</span>  all AC IDs are unique
  <span class="mark-pass">PASS</span>  no orphan cross-references

<span class="mark-pass">Score: 92 / 100</span></pre>
          </div>
          <p class="demo-caption">
            Düzenleme yok. Kesinti yok. Temiz Claude Code → eklentiyi yükleyin →
            gerçek bir spesifikasyonu puanlayın → ajanınız doğru olanı inşa etsin.
          </p>
        </div>
      </div>
    </section>

    {/* ── Bölüm 3: Sorun ── */}
    <section class="section" aria-labelledby="wedge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="wedge-title" class="section-title">
          Ajanınız neden sürekli yanlış şeyi inşa ediyor?
        </h2>
        <p class="prose-p">
          Doğaçlama promptlar bir yere kadar çalışır. Ajan özelliğin yarısını inşa
          eder. Gereksinimi yanlış yorumlar. Var olmayan bir API çağrısı uydurur.
          Yanlış kütüphaneyi seçer. Siz promptu yeniden yazarsınız. Bir kez daha baştan
          yazarsınız. Üçüncü turda artık sohbette tüm spesifikasyonu elle yazıyor hale gelirsiniz.
        </p>
        <p class="prose-p">
          Sorun ajanda değil. Sorun, «bana bir özellik inşa et» ifadesinin bir
          spesifikasyon olmamasıdır — bu sadece bir dilektir. Ajanlar stokastiktir.
          Dilekler stokastik yaklaşımlara uygundur. Spesifikasyonlar ise değildir.
        </p>
        <p class="prose-p">
          SpecStudio Skills, ajanınızın gerçekten yorumlayabileceği spesifikasyonlar
          yazmanız için size bir iş akışı sunar: yapılandırılmış özellikler,
          gereksinimler, kabul kriterleri ve ajan bunları görmeden önce eksiksizlik
          açısından puanlanması. Vibe-coding ile aynı hız, sonuçta ise önemli ölçüde
          daha az sapma.
        </p>
      </div>
    </section>

    {/* ── Bölüm 4: Hat (Pipeline) ── */}
    <section class="section pipeline-section" aria-labelledby="pipeline-title">
      <div class="section-inner">
        <h2 id="pipeline-title" class="section-title">
          Dört komut. Tek bir hat.
        </h2>
        <p class="pipeline-intro">
          Bir kez yükleyin, ardından sırayla çalıştırın — ham fikirden yürütülebilir bir plana kadar.
        </p>

        <div class="pipeline-grid">
          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/ideate</span>
            </div>
            <p class="pipeline-card__desc">
              Yapılandırılmış ıraksak ve yakınsak düşünme ile ham bir fikri hassaslaştırır.
              Linter ile denetlenebilir, spesifikasyon öncesi tek sayfalık bir özet üretir.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/specify</span>
            </div>
            <p class="pipeline-card__desc">
              Onaylanmış bir fikri gereksinimler, kabul kriterleri ve Given/When/Then
              bloklarıyla bir SpecScore Feature'ına dönüştürür.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/plan</span>
            </div>
            <p class="pipeline-card__desc">
              Bir özelliği sıralı bir görev listesine böler. Her görev bir veya
              daha fazla kabul kriteriyle eşleşir.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/implement</span>
            </div>
            <p class="pipeline-card__desc">
              Planın bir sonraki görevini yürütür. Görev başına bir alt ajan,
              kabul kriterlerine kadar izlenebilir commit'ler ve onayınız için staged edilmiş diff.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── Bölüm 5: Neler dahil ── */}
    <section class="section" aria-labelledby="box-title">
      <div class="section-inner section-inner--prose">
        <h2 id="box-title" class="section-title">
          Neler dahil.
        </h2>

        <h3 class="list-heading">Yapar:</h3>
        <ul class="feature-list feature-list--does">
          <li>Tam SDD akışı için eğik çizgi komutları ekler: <code>/ideate</code>, <code>/specify</code>, <code>/plan</code>, <code>/implement</code>.</li>
          <li>Ajan görmeden önce spesifikasyonun eksiksizliğini ve belirsizliğini puanlar.</li>
          <li>Spesifikasyonları açık SpecScore formatında yazar — tescilli uzantılar yoktur.</li>
        </ul>

        <h3 class="list-heading">Yapmaz:</h3>
        <ul class="feature-list feature-list--doesnt">
          <li>Ajanı sizin yerinize çalıştırmaz. Eklenti bir iş akışı katmanıdır; ajan Claude olarak kalır.</li>
          <li>Verileri hiçbir yere göndermez. Spesifikasyonlar ve puanlar yerelinizde kalır.</li>
          <li>Sizi sisteme hapsetmez. Kaldırırsanız spesifikasyonlarınız geçerli Markdown olarak kalır ve <a class="xref" href="https://github.com/specscore/specscore">specscore</a> CLI ile puanlanabilir.</li>
        </ul>

        <p class="sibling-callout">
          Tarafsız CLI arayüzünü mü arıyorsunuz?
          <a class="xref" href="https://github.com/specscore/ai-plugin-specscore">ai-plugin-specscore</a>
          hafif sarmalayıcıdır. SpecStudio Skills ise onun üzerine kurulmuş görüş bildiren iş akışıdır.
        </p>
      </div>
    </section>

    {/* ── Bölüm 6: Açık standart ── */}
    <section class="section" aria-labelledby="open-title">
      <div class="section-inner section-inner--prose">
        <h2 id="open-title" class="section-title">
          Açık SpecScore protokolü üzerine inşa edilmiştir.
        </h2>
        <p class="prose-p">
          SpecStudio Skills, spesifikasyonları açık bir standart olan
          <a class="xref" href="/tr/">SpecScore</a> formatında yazar.
          Format insanlar tarafından okunabilir Markdown'dır. Şema yayınlanmıştır.
          CLI açık kaynaklıdır. Tedarikçi bağımlılığı (vendor lock-in) yoktur. Bir gün
          SpecStudio'dan ayrılsanız bile spesifikasyonlarınız sizinle kalır.
        </p>
      </div>
    </section>
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Deneyin.</h2>
      <div class="final-cta__install">
        <div class="qs-tabs" role="tablist" aria-label="Kurulum yöntemi">
          <button type="button" role="tab" id="qs-tab-claude-b" aria-controls="qs-panel-claude-b" aria-selected="true" tabindex="0" class="qs-tab is-active" data-tab="claude">Claude Code</button>
          <button type="button" role="tab" id="qs-tab-setup-b" aria-controls="qs-panel-setup-b" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="setup">Diğer yapay zeka ajanları</button>
          <button type="button" role="tab" id="qs-tab-manual-b" aria-controls="qs-panel-manual-b" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="manual">Manuel</button>
        </div>

        <div id="qs-panel-claude-b" role="tabpanel" aria-labelledby="qs-tab-claude-b" class="qs-panel is-active" data-panel="claude">
<pre class="terminal"><span class="prompt">$</span> /plugin marketplace add specscore/ai-marketplace
<span class="prompt">$</span> /plugin install specstudio@specscore</pre>
        </div>
        <div id="qs-panel-setup-b" role="tabpanel" aria-labelledby="qs-tab-setup-b" class="qs-panel" data-panel="setup" hidden>
<pre class="terminal"><span class="prompt">$</span> specscore agent setup &lt;ajan-adı&gt;</pre>
          <p class="qs-note">
            Ajanınız için doğru talimat dosyasını yazar —
            <code>claude</code>, <code>copilot</code>, <code>cursor</code>, <code>codex</code>,
            <code>antigravity.google</code>, <code>pi.dev</code> veya <code>opencode</code>.
            SpecScore tarafından yönetilen bir proje içinde çalıştırın.
            <a class="xref" href="/tr/cli/">SpecScore CLI</a> gerektirir.
          </p>
        </div>
        <div id="qs-panel-manual-b" role="tabpanel" aria-labelledby="qs-tab-manual-b" class="qs-panel" data-panel="manual" hidden>
<pre class="terminal"><span class="prompt">$</span> git clone https://github.com/specscore/specstudio-skills
<span class="prompt">$</span> cp -r specstudio-skills/commands /yol/ajan/commands/
<span class="prompt">$</span> cp -r specstudio-skills/skills /yol/ajan/skills/</pre>
          <p class="qs-note">
            Eklenti reposunu klonlayın ve <code>commands/</code> ile <code>skills/</code>
            dizinlerini ajanınızın komut ve beceri dosyalarını yüklediği konuma kopyalayın.
          </p>
        </div>
      </div>
      <p class="final-cta__note">
        Açık kaynaklı ve herkese açık depolar için ücretsizdir. MIT lisansı.
      </p>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterTr />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-7) var(--space-3) var(--space-6);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    margin-bottom: var(--space-4);
    line-height: 1.55;
  }
  .hero__install {
    margin-bottom: var(--space-3);
  }
  .hero__demo-link {
    font-size: var(--fs-small);
    color: var(--mid-ink);
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Demo ── */
  .demo-placeholder {
    margin-top: var(--space-3);
  }
  .demo-caption {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    color: var(--mid-ink);
  }

  /* Terminal frame (shared with homepage AiSkills pattern) */
  .terminal-frame {
    border: 1px solid var(--hairline);
    background: var(--surface);
  }
  .terminal-frame__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--hairline);
    background: var(--cream-2);
    font-family: var(--font-code);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .terminal-frame__title { color: var(--graphite); font-weight: 700; }
  .terminal-frame__hint  { color: var(--mid-ink); }
  .terminal-frame__body  { border: none !important; }

  /* ── Wedge (prose sections) ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-3);
  }
  .prose-p:last-child {
    margin-bottom: 0;
  }

  /* ── Pipeline grid ── */
  .pipeline-section {
    background: var(--cream-2);
  }
  .pipeline-intro {
    color: var(--mid-ink);
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }
  .pipeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }
  .pipeline-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .pipeline-card__head {
    margin-bottom: var(--space-2);
  }
  .pipeline-card__cmd {
    font-family: var(--font-code);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .pipeline-card__desc {
    font-size: var(--fs-small);
    color: var(--mid-ink);
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .pipeline-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .pipeline-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── What's in the box ── */
  .list-heading {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .list-heading:first-of-type {
    margin-top: 0;
  }
  .feature-list {
    margin: 0 0 var(--space-3) 0;
    padding-left: 1.25rem;
    color: var(--mid-ink);
    line-height: 1.65;
  }
  .feature-list li {
    margin-bottom: 0.5rem;
  }
  .feature-list li:last-child {
    margin-bottom: 0;
  }
  .feature-list code {
    font-size: 0.9em;
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }
  .sibling-callout {
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid var(--hairline);
    font-size: var(--fs-small);
    color: var(--mid-ink);
    line-height: 1.55;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    text-align: center;
  }
  .final-cta__title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .final-cta__install {
    display: inline-block;
    text-align: left;
    margin-bottom: var(--space-3);
  }
  .final-cta__note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
  }
</style>

<QsTabsScript />
