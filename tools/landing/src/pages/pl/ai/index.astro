---
// /ai/ index — Polish translation.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooterPl from '../../../components/SiteFooterPl.astro';
---

<BaseLayout
  lang="pl"
  title="Skille AI dla rozwoju sterowanego specyfikacją | SpecScore"
  description="Skille AI dla SpecScore wprowadzają rozwój sterowany specyfikacją do Twojego agenta AI. Zainstaluj SpecStudio Skills, aby uzyskać prowadzony proces, lub CLI Skills dla bezpośredniego dostępu do lintera."
  canonical="https://specscore.md/pl/ai/"
>
  <SiteHeader />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 id="hero-title" class="hero__headline">
          Skille AI dla SpecScore.
        </h1>
        <p class="hero__sub">
          Skille AI dla SpecScore wprowadzają proces oparty na specyfikacji do
          Twojego agenta AI. Stanowią nakładkę na <a class="xref" href="/pl/cli/">CLI
          SpecScore</a>, dzięki czemu agent może natywnie odczytywać, zapisywać
          i walidować specyfikacje — wybierz ten, który najlepiej pasuje do Twojego stylu pracy.
        </p>
      </div>
    </section>

    <section class="section" aria-labelledby="plugins-title">
      <div class="section-inner">
        <h2 id="plugins-title" class="sr-only">Dostępne wtyczki</h2>

        <div class="plugin-grid">
          <div class="plugin-card plugin-card--primary">
            <span class="plugin-card__badge">★ Rekomendowane</span>
            <h3 class="plugin-card__name">
              <a href="/pl/ai/specstudio-skills/">SpecStudio Skills</a>
            </h3>
            <p class="plugin-card__repo">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
              </svg>
              <a href="https://github.com/specscore/specstudio-skills" target="_blank"><span class="plugin-card__repo-host">github.com/</span>specscore/specstudio-skills</a>
            </p>
            <p class="plugin-card__desc">
              Przemyślany, kompletny proces rozwoju opartego na specyfikacji.
              Cztery polecenia slash — <code>/ideate</code>, <code>/specify</code>,
              <code>/plan</code>, <code>/implement</code> — które prowadzą Cię
              od surowego pomysłu aż po działający kod z ocenioną specyfikacją na każdym etapie.
            </p>
            <p class="plugin-card__pitch">
              Najprostszy i najbardziej efektywny sposób na start ze SpecScore.
            </p>
            <a href="/pl/ai/specstudio-skills/" class="plugin-card__cta">Dowiedz się więcej →</a>
          </div>

          <div class="plugin-card">
            <h3 class="plugin-card__name">
              <a href="/pl/ai/cli-skills/">CLI Skills</a>
            </h3>
            <p class="plugin-card__repo">
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
              </svg>
              <a href="https://github.com/specscore/ai-plugin-specscore" target="_blank"><span class="plugin-card__repo-host">github.com/</span>specscore/ai-plugin-specscore</a>
            </p>
            <p class="plugin-card__desc">
              Lekki wrapper wokół narzędzia CLI SpecScore. Udostępnia
              <code>specscore lint</code>, <code>specscore feature</code>,
              <code>specscore task</code> oraz <code>specscore change-status</code>
              jako natywne polecenia w Claude Code.
            </p>
            <p class="plugin-card__audience">
              Dla zaawansowanych użytkowników znających już SpecScore oraz dla twórców
              narzędzi budujących własne procesy.
            </p>
            <a href="/pl/ai/cli-skills/" class="plugin-card__cta">Dowiedz się więcej →</a>
          </div>
        </div>

        <p class="community-note">
          Budujesz własną wtyczkę do SpecScore? Gdy powstaną wtyczki
          społeczności, zostaną one umieszczone tutaj.
          <a class="xref" href="https://github.com/specscore/specscore/blob/main/CONTRIBUTING.md">Przewodnik dla współtwórców →</a>
        </p>
      </div>
    </section>
  </main>

  <SiteFooterPl />
</BaseLayout>

<style>
  .hero { padding: var(--space-6) var(--space-3) var(--space-5); background: var(--cream); }
  .hero__inner { max-width: var(--max-prose); margin: 0 auto; animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms; }
  .hero__headline { font-size: var(--fs-h2); font-weight: 700; letter-spacing: -0.01em; margin-bottom: var(--space-3); }
  .hero__sub { font-size: 1.125rem; color: var(--mid-ink); line-height: 1.55; }
  @keyframes fade-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
</style>
