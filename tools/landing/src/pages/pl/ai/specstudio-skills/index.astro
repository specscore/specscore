---
// SpecStudio Skills — Polish landing page.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterPl from '../../../../components/SiteFooterPl.astro';
import QsTabsScript from '../../../../components/QsTabsScript.astro';
---

<BaseLayout
  lang="pl"
  title="SpecStudio Skills — Specyfikacje, za którymi Twój agent AI naprawdę może podążać."
  description="Bezpłatna wtyczka do Claude Code, która zamienia improwizowane prompty w ustrukturyzowane, ocenione specyfikacje czytane przez agenta przed napisaniem choćby linijki kodu. Zbudowana na otwartym protokole SpecScore."
  canonical="https://specscore.md/pl/ai/specstudio-skills/"
>
  <SiteHeader />

  <main>
    {/* ── Sekcja 1: Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 id="hero-title" class="hero__headline">
          Specyfikacje, za którymi Twój agent AI<br />naprawdę może podążać.
        </h1>
        <p class="hero__sub">
          SpecStudio Skills to bezpłatna wtyczka do Claude Code, która przekształca
          improwizowane prompty w ustrukturyzowane, ocenione specyfikacje czytane przez
          Twojego agenta przed napisaniem pojedynczej linijki kodu. Zbudowana na
          otwartym protokole
          <a class="xref" href="/pl/">SpecScore</a>.
        </p>
        <div class="hero__install" id="install">
          <div class="qs-tabs" role="tablist" aria-label="Metoda instalacji">
            <button type="button" role="tab" id="qs-tab-claude" aria-controls="qs-panel-claude" aria-selected="true" tabindex="0" class="qs-tab is-active" data-tab="claude">Claude Code</button>
            <button type="button" role="tab" id="qs-tab-setup" aria-controls="qs-panel-setup" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="setup">Inne agenty AI</button>
            <button type="button" role="tab" id="qs-tab-manual" aria-controls="qs-panel-manual" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="manual">Ręcznie</button>
          </div>

          <div id="qs-panel-claude" role="tabpanel" aria-labelledby="qs-tab-claude" class="qs-panel is-active" data-panel="claude">
<pre class="terminal"><span class="prompt">$</span> /plugin marketplace add specscore/ai-marketplace
<span class="prompt">$</span> /plugin install specstudio@specscore</pre>
          </div>
          <div id="qs-panel-setup" role="tabpanel" aria-labelledby="qs-tab-setup" class="qs-panel" data-panel="setup" hidden>
<pre class="terminal"><span class="prompt">$</span> specscore agent setup &lt;nazwa-agenta&gt;</pre>
            <p class="qs-note">
              Zapisuje właściwy plik instrukcji dla Twojego agenta —
              <code>claude</code>, <code>copilot</code>, <code>cursor</code>, <code>codex</code>,
              <code>antigravity.google</code>, <code>pi.dev</code> lub <code>opencode</code>.
              Uruchamiaj wewnątrz projektu ze SpecScore. Wymaga
              <a class="xref" href="/pl/cli/">SpecScore CLI</a>.
            </p>
          </div>
          <div id="qs-panel-manual" role="tabpanel" aria-labelledby="qs-tab-manual" class="qs-panel" data-panel="manual" hidden>
<pre class="terminal"><span class="prompt">$</span> git clone https://github.com/specscore/specstudio-skills
<span class="prompt">$</span> cp -r specstudio-skills/commands /sciezka/do/twojego/agenta/commands/
<span class="prompt">$</span> cp -r specstudio-skills/skills /sciezka/do/twojego/agenta/skills/</pre>
            <p class="qs-note">
              Sklonuj repozytorium wtyczki i skopiuj katalogi
              <code>commands/</code> oraz <code>skills/</code> tam, gdzie Twój agent ładuje
              pliki poleceń i umiejętności.
            </p>
          </div>
        </div>
        <p class="hero__demo-link">
          <a href="#demo" class="xref">Zobacz 60-sekundowe demo ↓</a>
        </p>
      </div>
    </section>

    {/* ── Sekcja 2: Demo ── */}
    <section class="section" id="demo" aria-labelledby="demo-title">
      <div class="section-inner">
        <h2 id="demo-title" class="section-title">
          Od mglistego pomysłu do ocenionej specyfikacji w 60 sekund.
        </h2>

        <div class="demo-placeholder">
          <div class="terminal-frame">
            <div class="terminal-frame__head">
              <span class="terminal-frame__title">Claude Code</span>
              <span class="terminal-frame__hint">demo</span>
            </div>
<pre class="terminal terminal-frame__body"><span class="prompt">&gt;</span> /specstudio:ideate A password reset flow for our SaaS app.

<span class="dim">Refining idea...</span>
<span class="dim">Producing spec/ideas/password-reset.md</span>

<span class="prompt">&gt;</span> /specstudio:specify spec/ideas/password-reset.md

<span class="dim">Writing Feature spec...</span>
<span class="dim">spec/features/password-reset/README.md</span>

<span class="prompt">$</span> specscore lint spec/features/password-reset/
<span class="mark-pass">PASS</span>  Feature: password-reset
  <span class="mark-pass">PASS</span>  has title, status, and description
  <span class="mark-pass">PASS</span>  requirements have acceptance criteria
  <span class="mark-pass">PASS</span>  all AC IDs are unique
  <span class="mark-pass">PASS</span>  no orphan cross-references

<span class="mark-pass">Score: 92 / 100</span></pre>
          </div>
          <p class="demo-caption">
            Bez edycji. Bez cięć. Czysty Claude Code → instalacja wtyczki →
            ocena realnej specyfikacji → Twój agent buduje dokładnie to, co trzeba.
          </p>
        </div>
      </div>
    </section>

    {/* ── Sekcja 3: Problem ── */}
    <section class="section" aria-labelledby="wedge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="wedge-title" class="section-title">
          Dlaczego Twój agent wciąż buduje nie to, co trzeba.
        </h2>
        <p class="prose-p">
          Improwizowane prompty działają, dopóki nie przestaną. Agent
          zbudował połowę funkcji. Źle zrozumiał wymaganie. Wymyślił
          nieistniejące wywołanie API. Wybrał złą bibliotekę. Przepisujesz
          prompt. Przepisujesz jeszcze raz. W trzeciej rundzie piszesz
          już całą kompletną specyfikację ręcznie w oknie czatu.
        </p>
        <p class="prose-p">
          Problem nie leży w agencie. Chodzi o to, że „zbuduj mi funkcję”
          to nie specyfikacja — to życzenie. Agenci są stochastyczni. Życzenia
          sprzyjają stochastyczności. Specyfikacje — wręcz przeciwnie.
        </p>
        <p class="prose-p">
          SpecStudio Skills daje Ci uporządkowany proces tworzenia specyfikacji,
          które Twój agent naprawdę potrafi zinterpretować: ustrukturyzowane funkcje,
          wymagania, kryteria akceptacji ocenione pod kątem kompletności, zanim
          agent w ogóle je zobaczy. Ta sama prędkość co „vibe-coding”, drastycznie
          mniejsza losowość wyników.
        </p>
      </div>
    </section>

    {/* ── Sekcja 4: Potok zadań ── */}
    <section class="section pipeline-section" aria-labelledby="pipeline-title">
      <div class="section-inner">
        <h2 id="pipeline-title" class="section-title">
          Cztery polecenia. Jeden proces.
        </h2>
        <p class="pipeline-intro">
          Zainstaluj raz, wywołuj po kolei — od surowego pomysłu po wykonywalny plan.
        </p>

        <div class="pipeline-grid">
          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/ideate</span>
            </div>
            <p class="pipeline-card__desc">
              Dopracowuje surowy pomysł poprzez uporządkowane myślenie rozbieżne
              i zbieżne. Tworzy weryfikowalny linterem zarys koncepcji (one-pager).
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/specify</span>
            </div>
            <p class="pipeline-card__desc">
              Przekształca zatwierdzony pomysł w Feature SpecScore z wymaganiami,
              kryteriami akceptacji i blokami Given/When/Then.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/plan</span>
            </div>
            <p class="pipeline-card__desc">
              Dzieli funkcję na uporządkowaną listę zadań. Każde zadanie
              mapuje się na jedno lub więcej kryteriów akceptacji.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/implement</span>
            </div>
            <p class="pipeline-card__desc">
              Wykonuje kolejne zadanie z planu. Jeden subagent na zadanie,
              commity powiązane z AC, przygotowany diff do Twojej akceptacji.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── Sekcja 5: Co zawiera ── */}
    <section class="section" aria-labelledby="box-title">
      <div class="section-inner section-inner--prose">
        <h2 id="box-title" class="section-title">
          Co zawiera.
        </h2>

        <h3 class="list-heading">Robi:</h3>
        <ul class="feature-list feature-list--does">
          <li>Dodaje komendy slash dla pełnego przepływu SDD: <code>/ideate</code>, <code>/specify</code>, <code>/plan</code>, <code>/implement</code>.</li>
          <li>Ocenia kompletność i brak niejednoznaczności specyfikacji, zanim agent przystąpi do pracy.</li>
          <li>Zapisuje specyfikacje w otwartym formacie SpecScore — bez własnościowych rozszerzeń.</li>
        </ul>

        <h3 class="list-heading">Nie robi:</h3>
        <ul class="feature-list feature-list--doesnt">
          <li>Nie wykonuje zadań za Ciebie bez Twojej wiedzy. Wtyczka to warstwa procesu; agentem pozostaje Claude.</li>
          <li>Nie wysyła danych na zewnątrz. Wszystkie specyfikacje i oceny pozostają lokalnie na dysku.</li>
          <li>Nie uzależnia Cię od dostawcy. Po odinstalowaniu specyfikacje pozostają poprawnym Markdownem weryfikowalnym za pomocą CLI <a class="xref" href="https://github.com/specscore/specscore">specscore</a>.</li>
        </ul>

        <p class="sibling-callout">
          Szukasz neutralnego interfejsu CLI?
          <a class="xref" href="https://github.com/specscore/ai-plugin-specscore">ai-plugin-specscore</a>
          to lekki wrapper. SpecStudio Skills to kompletny proces zbudowany na jego fundamencie.
        </p>
      </div>
    </section>

    {/* ── Sekcja 6: Otwarty standard ── */}
    <section class="section" aria-labelledby="open-title">
      <div class="section-inner section-inner--prose">
        <h2 id="open-title" class="section-title">
          Zbudowane na otwartym protokole SpecScore.
        </h2>
        <p class="prose-p">
          SpecStudio Skills zapisuje specyfikacje w otwartym standardzie
          <a class="xref" href="/pl/">SpecScore</a>. Format to czytelny dla
          ludzi Markdown. Schemat jest w pełni publiczny. CLI to oprogramowanie
          open source. Zero vendor lock-in. Jeśli kiedykolwiek zdecydujesz się
          zrezygnować ze SpecStudio, Twoje specyfikacje idą razem z Tobą.
        </p>
      </div>
    </section>
  </main>

  {/* ── CTA final ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Wypróbuj.</h2>
      <div class="final-cta__install">
        <div class="qs-tabs" role="tablist" aria-label="Metoda instalacji">
          <button type="button" role="tab" id="qs-tab-claude-b" aria-controls="qs-panel-claude-b" aria-selected="true" tabindex="0" class="qs-tab is-active" data-tab="claude">Claude Code</button>
          <button type="button" role="tab" id="qs-tab-setup-b" aria-controls="qs-panel-setup-b" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="setup">Inne agenty AI</button>
          <button type="button" role="tab" id="qs-tab-manual-b" aria-controls="qs-panel-manual-b" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="manual">Ręcznie</button>
        </div>

        <div id="qs-panel-claude-b" role="tabpanel" aria-labelledby="qs-tab-claude-b" class="qs-panel is-active" data-panel="claude">
<pre class="terminal"><span class="prompt">$</span> /plugin marketplace add specscore/ai-marketplace
<span class="prompt">$</span> /plugin install specstudio@specscore</pre>
        </div>
        <div id="qs-panel-setup-b" role="tabpanel" aria-labelledby="qs-tab-setup-b" class="qs-panel" data-panel="setup" hidden>
<pre class="terminal"><span class="prompt">$</span> specscore agent setup &lt;nazwa-agenta&gt;</pre>
          <p class="qs-note">
            Zapisuje właściwy plik instrukcji dla Twojego agenta —
            <code>claude</code>, <code>copilot</code>, <code>cursor</code>, <code>codex</code>,
            <code>antigravity.google</code>, <code>pi.dev</code> lub <code>opencode</code>.
            Uruchamiaj wewnątrz projektu ze SpecScore. Wymaga
            <a class="xref" href="/pl/cli/">SpecScore CLI</a>.
          </p>
        </div>
        <div id="qs-panel-manual-b" role="tabpanel" aria-labelledby="qs-tab-manual-b" class="qs-panel" data-panel="manual" hidden>
<pre class="terminal"><span class="prompt">$</span> git clone https://github.com/specscore/specstudio-skills
<span class="prompt">$</span> cp -r specstudio-skills/commands /sciezka/do/twojego/agenta/commands/
<span class="prompt">$</span> cp -r specstudio-skills/skills /sciezka/do/twojego/agenta/skills/</pre>
          <p class="qs-note">
            Sklonuj repozytorium wtyczki i skopiuj katalogi
            <code>commands/</code> oraz <code>skills/</code> tam, gdzie Twój agent ładuje
            pliki poleceń i umiejętności.
          </p>
        </div>
      </div>
      <p class="final-cta__note">
        Bezpłatne dla repozytoriów publicznych i open source. Licencja MIT.
      </p>
    </div>
  </section>

  <SiteFooterPl />
</BaseLayout>

<style>
  .hero {
    padding: var(--space-7) var(--space-3) var(--space-6);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    margin-bottom: var(--space-4);
    line-height: 1.55;
  }
  .hero__install {
    margin-bottom: var(--space-3);
  }
  .hero__demo-link {
    font-size: var(--fs-small);
    color: var(--mid-ink);
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  .demo-placeholder {
    margin-top: var(--space-3);
  }
  .demo-caption {
    margin-top: var(--space-2);
    font-size: var(--fs-small);
    color: var(--mid-ink);
  }

  .terminal-frame {
    border: 1px solid var(--hairline);
    background: var(--surface);
  }
  .terminal-frame__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--hairline);
    background: var(--cream-2);
    font-family: var(--font-code);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .terminal-frame__title { color: var(--graphite); font-weight: 700; }
  .terminal-frame__hint  { color: var(--mid-ink); }
  .terminal-frame__body  { border: none !important; }

  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-3);
  }
  .prose-p:last-child {
    margin-bottom: 0;
  }

  .pipeline-section {
    background: var(--cream-2);
  }
  .pipeline-intro {
    color: var(--mid-ink);
    margin-bottom: var(--space-4);
    line-height: 1.6;
  }
  .pipeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }
  .pipeline-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .pipeline-card__head {
    margin-bottom: var(--space-2);
  }
  .pipeline-card__cmd {
    font-family: var(--font-code);
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
  }
  .pipeline-card__desc {
    font-size: var(--fs-small);
    color: var(--mid-ink);
    line-height: 1.55;
  }

  @media (max-width: 860px) {
    .pipeline-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .pipeline-grid {
      grid-template-columns: 1fr;
    }
  }

  .list-heading {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-top: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .list-heading:first-of-type {
    margin-top: 0;
  }
  .feature-list {
    margin: 0 0 var(--space-3) 0;
    padding-left: 1.25rem;
    color: var(--mid-ink);
    line-height: 1.65;
  }
  .feature-list li {
    margin-bottom: 0.5rem;
  }
  .feature-list li:last-child {
    margin-bottom: 0;
  }
  .feature-list code {
    font-size: 0.9em;
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: 0.1em 0.35em;
    border-radius: 2px;
  }
  .sibling-callout {
    margin-top: var(--space-4);
    padding: var(--space-2) var(--space-3);
    border-left: 3px solid var(--hairline);
    font-size: var(--fs-small);
    color: var(--mid-ink);
    line-height: 1.55;
  }

  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    text-align: center;
  }
  .final-cta__title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .final-cta__install {
    display: inline-block;
    text-align: left;
    margin-bottom: var(--space-3);
  }
  .final-cta__note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
  }
</style>

<QsTabsScript />
