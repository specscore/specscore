---
// /pl/vs/spec-kit/ — Porównanie SpecScore i GitHub Spec Kit.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterPl from '../../../../components/SiteFooterPl.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="pl"
  title="SpecScore vs Spec Kit — Uczciwe porównanie."
  description="Rzetelne i bezpośrednie porównanie SpecScore i GitHub Spec Kit: przepływ pracy kontra format, linting, cykl życia, identyfikowalność i CLI. Uzupełniają się — oto jak."
  canonical="https://specscore.md/pl/vs/spec-kit/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/pl/vs/" class="xref">Porównania</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs Spec Kit
        </h1>
        <p class="hero__sub">
          Działają na różnych warstwach. Spec Kit to <strong>przepływ pracy (workflow)</strong> —
          proces z przewodnikiem, który prowadzi agenta od pomysłu do implementacji.
          SpecScore to <strong>format</strong>, w którym zapisywane są specyfikacje, oraz CLI,
          które je lintuje, odpytuje i śledzi. Spec Kit może generować pliki SpecScore.
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Co je łączy.</h2>
        <ul class="shared-list">
          <li>Ten sam drogowskaz — specyfikacje przed kodem, z agentami AI jako pierwszorzędnymi czytelnikami.</li>
          <li>Specyfikacje żyją w Twoim repozytorium jako Markdown — pod kontrolą wersji, sprawdzane w pull requestach.</li>
          <li>Oba są open source na licencji MIT.</li>
          <li>Oba są przeznaczone dla Claude Code, Cursora, Copilota i innych agentów kodujących AI.</li>
        </ul>
      </div>
    </section>

    {/* ── What Spec Kit does well ── */}
    <section class="section" aria-labelledby="speckit-title">
      <div class="section-inner section-inner--prose">
        <h2 id="speckit-title" class="section-title">Co Spec Kit robi dobrze.</h2>
        <p class="section-note">
          <a href="https://github.com/github/spec-kit" rel="nofollow noopener" target="_blank" class="xref">Spec Kit</a>
          to oparty na specyfikacjach workflow programistyczny od GitHub Next.
        </p>

        <div class="credit-card">
          <h3 class="credit-card__title">Kompletny, ustrukturyzowany proces</h3>
          <p class="credit-card__desc">
            Spec Kit daje Ci pełną ścieżkę:
            <code>constitution → specify → plan → tasks → implement</code>.
            Każdy krok ma dedykowany slash command i prompt zaprojektowany tak, by utrzymać agenta
            w ryzach. Jeśli szukasz gotowego procesu, Spec Kit dostarcza go od ręki.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Silna dystrybucja i rozpoznawalność</h3>
          <p class="credit-card__desc">
            Wspierany przez GitHub Next, z dużą społecznością i rosnącą biblioteką
            rozszerzeń. Dla wielu programistów Spec Kit jest pierwszym procesem
            opartym na specyfikacjach, z jakim się stykają.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Polecenia niezależne od agenta</h3>
          <p class="credit-card__desc">
            Polecenia Spec Kit działają w Claude Code, Cursorze, Copilocie i innych —
            workflow kieruje agentem bez względu na to, którego używasz.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Porównanie możliwości.</h2>
        <p class="section-note">
          Narzędzia te odpowiadają na różne pytania, więc tabela porównuje ich role, a nie wyłania zwycięzców.
        </p>

        <div class="table-wrap">
          <table class="compare-table" aria-label="Porównanie możliwości SpecScore vs Spec Kit">
            <thead>
              <tr>
                <th scope="col">Możliwość</th>
                <th scope="col">Spec Kit</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Główna rola</td>
                <td>Przepływ pracy / metodologia</td>
                <td><strong>Format przechowywania + CLI</strong></td>
              </tr>
              <tr>
                <td>Format specyfikacji</td>
                <td>Dowolny Markdown</td>
                <td><strong>Markdown + YAML frontmatter</strong> (strukturalny)</td>
              </tr>
              <tr>
                <td>Linting specyfikacji</td>
                <td>Brak</td>
                <td><strong>Jakość treści</strong> — nieprecyzyjne czasowniki, brakujące AC, wiszące referencje</td>
              </tr>
              <tr>
                <td>ID wymagań / AC</td>
                <td>Brak</td>
                <td><strong>Adresowalne maszynowo ID</strong> (<code>REQ: slug</code>)</td>
              </tr>
              <tr>
                <td>Status cyklu życia</td>
                <td>Domniemany (krok w procesie)</td>
                <td><strong>Egzekwowany</strong> — Draft → Approved → Implementing → Stable → Deprecated</td>
              </tr>
              <tr>
                <td>Śledzenie kod-do-specyfikacji</td>
                <td>Brak</td>
                <td><strong>Adnotacje <code>specscore:</code></strong> + trailery <code>Verifies:</code> w commitach</td>
              </tr>
              <tr>
                <td>Odpytywanie specyfikacji z CLI</td>
                <td>Rusztowanie (<code>specify</code>, <code>plan</code>, <code>tasks</code>)</td>
                <td><strong>API do zapytań</strong> — <code>feature list / show / deps</code>, <code>lint</code>, <code>code refs</code></td>
              </tr>
              <tr>
                <td>Zależność runtime</td>
                <td>Python</td>
                <td><strong>Brak</strong> — pojedynczy plik binarny w Go</td>
              </tr>
              <tr>
                <td>Integracja CI</td>
                <td>Uruchomienie przepływu pracy</td>
                <td><strong><code>specscore lint</code></strong> kończy się kodem niezerowym, hooki pre-commit</td>
              </tr>
              <tr>
                <td>Wzajemna relacja</td>
                <td colspan="2"><strong>Uzupełniają się</strong> — Spec Kit może generować pliki SpecScore</td>
              </tr>
              <tr>
                <td>Licencja</td>
                <td>MIT</td>
                <td>MIT</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore goes further ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">Co dodaje SpecScore.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">Wynik pracy podlega lintowaniu</h3>
            <p class="diff-card__desc">
              Spec Kit generuje swobodny Markdown — dobry lub zły, po prostu trafia do repozytorium.
              SpecScore weryfikuje wynik na dwóch poziomach: <code>lint</code> sprawdza deterministycznie,
              że każde wymaganie ma kryteria akceptacji, że referencje się rozwiązują i że transycje
              stanów są poprawne — a recenzent AI (<code>/review</code>, <code>/score</code>) wykrywa
              wieloznaczne kryteria i nieprecyzyjne czasowniki.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> link  <span class="dim">"Related Feature: discount-tiers" not found</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Wynik pracy jest odpytywalny</h3>
            <p class="diff-card__desc">
              Spec Kit zapisuje pliki; ich odczytanie oznacza konieczność ich otwarcia. Specyfikacje SpecScore
              odpowiadają na pytania z poziomu CLI: <code>specscore feature list</code>,
              <code>feature deps</code>, <code>code refs</code> — dzięki czemu agent nawiguje
              po grafie specyfikacji bez czytania każdego pliku w repozytorium.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Każde wymaganie ma swoje ID</h3>
            <p class="diff-card__desc">
              Spec Kit odwołuje się do wymagań tekstem. SpecScore przypisuje ID oparte na slugach
              (<code>REQ: slug-format</code>) oraz identyfikatory AC, które przetrwają zmiany nazw,
              refaktoryzację i przekazywanie zadań między agentami.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Cykl życia jest egzekwowany</h3>
            <p class="diff-card__desc">
              W Spec Kit etap specyfikacji to po prostu bieżący krok w workflow.
              W SpecScore cykl życia jest egzekwowanym polem statusu — Draft → Approved
              → Implementing → Stable → Deprecated — weryfikowanym przez linter i zmienianym
              poleceniem <code>specscore change-status</code> z hooków git lub CI.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Kod odsyła bezpośrednio do specyfikacji</h3>
            <p class="diff-card__desc">
              Spec Kit nie ma mechanizmu śledzenia. SpecScore posiada
              adnotacje <code>specscore:</code> w kodzie i trailery <code>Verifies:</code>
              w commitach — uruchom <code>specscore code refs</code>, aby uzyskać deterministyczną odpowiedź
              na pytanie „jaki kod implementuje to wymaganie?”.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Brak zależności runtime</h3>
            <p class="diff-card__desc">
              SpecScore to pojedynczy plik binarny w Go — nie wymaga instalowania środowiska
              uruchomieniowego. Działa w projektach w Go, Rust, Pythonie, Javie czy
              JavaScript bez dodawania czegokolwiek do toolchaina.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Kiedy wybrać które rozwiązanie.</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Wybierz Spec Kit, gdy…</h3>
            <ul class="when-card__list">
              <li>Chcesz ustrukturyzowanego procesu z przewodnikiem od pomysłu do wdrożenia.</li>
              <li>Twój zespół potrzebuje dyscypliny jawnych kroków specify / plan / tasks.</li>
              <li>Standaryzujesz sposób kierowania agentami w zespole.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Wybierz SpecScore, gdy…</h3>
            <ul class="when-card__list">
              <li>Potrzebujesz specyfikacji, które agenci mogą lintować, odpytywać i modyfikować bez konieczności czytania każdego pliku.</li>
              <li>Wymagasz powiązania kod-do-specyfikacji z deterministyczną odpowiedzią.</li>
              <li>Budujesz duży system z wieloma funkcjami i przejściami cyklu życia.</li>
              <li>Zależy Ci na braku zależności runtime — jeden plik binarny, bez wymagań co do toolchaina językowego.</li>
              <li>Potrzebujesz bramek jakości specyfikacji w CI kończących się kodem niezerowym, jak ESLint lub <code>go vet</code>.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── The integration opportunity ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">SpecScore rozszerza Spec Kit — nie zastępuje go.</h2>
        <p class="prose-p">
          Spec Kit to proces tworzenia specyfikacji; SpecScore to format, w którym ta specyfikacja
          może zostać zapisana. Rozszerzenie Spec Kit generujące format SpecScore jest w drodze —
          uruchom workflow Spec Kit i uzyskaj specyfikacje, które można lintować, odpytywać
          i śledzić na kolejnych etapach.
        </p>
        <p class="prose-p">
          Wybierz Spec Kit dla procesu. Wybierz SpecScore dla trwałego artefaktu. Używaj obu,
          gdy potrzebujesz obu.
        </p>
      </div>
    </section>

    <ComparisonFeedback page="spec-kit" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Specyfikacje, które przechodzą testy.</h2>
      <div class="final-cta__buttons">
        <a href="/pl/cli/install/" class="btn btn--primary">Zainstaluj CLI</a>
        <a href="/pl/ai/specstudio-skills/" class="btn btn--secondary">Pobierz skille AI dla swojego agenta</a>
        <a
          href="https://github.com/specscore/specscore"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          Open-source na GitHubie
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterPl />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__breadcrumb {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Shared list ── */
  .shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shared-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }
  .shared-list li::before {
    content: '=';
    position: absolute;
    left: 0;
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pale-ink);
  }

  /* ── Section note ── */
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }

  /* ── Credit cards ── */
  .credit-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .credit-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .credit-card__desc {
    color: var(--mid-ink);
    line-height: 1.6;
    font-size: var(--fs-body);
  }
  .credit-card__desc code {
    font-size: 0.9em;
    background: var(--cream);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Feature comparison table ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .compare-table td:nth-child(2),
  .compare-table td:nth-child(3) {
    min-width: 200px;
  }
  .compare-table td code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .compare-table strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* ── Diff grid ── */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .diff-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .diff-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .diff-card__desc {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .diff-card__desc code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .diff-card__example {
    margin-top: var(--space-2);
  }
  .diff-card__example .terminal {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .diff-grid { grid-template-columns: 1fr; }
  }

  /* ── When to use which ── */
  .when-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .when-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .when-card--primary {
    border-color: var(--validator-green);
    border-width: 2px;
  }
  .when-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .when-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .when-card__list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
    font-size: var(--fs-small);
  }
  .when-card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--pale-ink);
    font-family: var(--font-code);
  }
  .when-card--primary .when-card__list li::before {
    color: var(--validator-green);
  }
  .when-card__list code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; }
  }

  /* ── Bridge section ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-2);
  }
  .prose-p:last-child {
    margin-bottom: 0;
    font-weight: 500;
    color: var(--ink);
  }
  .prose-p code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-content);
