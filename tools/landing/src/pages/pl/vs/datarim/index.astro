---
// /pl/vs/datarim/ — Porównanie SpecScore i Datarim.
// Datarim to workflow pack dla Claude Code; SpecScore to otwarty format,
// do którego może prowadzić przepływ pracy.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterPl from '../../../../components/SiteFooterPl.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="pl"
  title="SpecScore vs Datarim — Uczciwe porównanie."
  description="Rzetelne porównanie SpecScore i Datarim: workflow pack dla Claude Code kontra otwarty, przenośny format specyfikacji. Różne warstwy — i można je łączyć."
  canonical="https://specscore.md/pl/vs/datarim/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/pl/vs/" class="xref">Porównania</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs Datarim
        </h1>
        <p class="hero__sub">
          Różne warstwy. Datarim to <strong>opinionowany workflow pack</strong> dla
          Claude Code — slash commands prowadzące projekt od wymagań do jego
          ukończenia. SpecScore to <strong>otwarty format</strong>, w którym zapisywane są specyfikacje,
          oraz CLI do ich lintowania, odpytywania i śledzenia. Workflow może na niego wskazywać.
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Co je łączy.</h2>
        <ul class="shared-list">
          <li>Oba wprowadzają ustrukturyzowaną metodologię do programowania wspomaganego przez AI.</li>
          <li>Oba są open source na licencji MIT.</li>
          <li>Oba działają wewnątrz Claude Code — Datarim jako polecenia, SpecScore poprzez SpecStudio Skills.</li>
          <li>Oba przechowują swój stan jako Markdown w repozytorium, pod kontrolą wersji.</li>
        </ul>
      </div>
    </section>

    {/* ── What Datarim does well ── */}
    <section class="section" aria-labelledby="datarim-title">
      <div class="section-inner section-inner--prose">
        <h2 id="datarim-title" class="section-title">Co Datarim robi dobrze.</h2>
        <p class="section-note">
          <a href="https://github.com/Arcanada-one/datarim" rel="nofollow noopener" target="_blank" class="xref">Datarim</a>
          to uniwersalny framework iteracyjnych przepływów pracy zbudowany dla Claude Code.
        </p>

        <div class="credit-card">
          <h3 class="credit-card__title">Natywny UX slash commands</h3>
          <p class="credit-card__desc">
            Kompletny pipeline w postaci poleceń — <code>/dr-prd</code>, <code>/dr-plan</code>,
            <code>/dr-design</code>, <code>/dr-do</code>, <code>/dr-qa</code> — które czują się
            jak w domu w Claude Code. Jeden <code>install.sh</code> do <code>~/.claude/</code>
            i gotowe do działania.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Routing świadomy złożoności (L1–L4)</h3>
          <p class="credit-card__desc">
            Datarim ocenia rozmiar pracy i odpowiednio kieruje przepływem: szybka poprawka L1 pomija
            planowanie, podczas gdy duża zmiana L4 uruchamia fazowy pipeline z wieloma
            pętlami przeglądu. Dopasowanie ceremonii do zakresu to znakomity pomysł.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Consilium i zasięg wielodomenowy</h3>
          <p class="credit-card__desc">
            Jego „consilium” zbiera panel agentów w celu omówienia kompromisów przed
            rekomendacją decyzji. I nie dotyczy to tylko oprogramowania — Datarim obsługuje także
            przepływy pracy badawcze, prawne i tworzenia treści.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Porównanie możliwości.</h2>
        <p class="section-note">
          Jedno to przepływ pracy, drugie to format — tabela porównuje role, a nie wyłania zwycięzców.
        </p>

        <div class="table-wrap">
          <table class="compare-table" aria-label="Porównanie możliwości SpecScore vs Datarim">
            <thead>
              <tr>
                <th scope="col">Możliwość</th>
                <th scope="col">Datarim</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Główna rola</td>
                <td>Workflow pack dla Claude Code</td>
                <td><strong>Otwarty format specyfikacji + CLI</strong></td>
              </tr>
              <tr>
                <td>Działa jako</td>
                <td>Slash commands (<code>/dr-*</code>)</td>
                <td>Pliki formatu + CLI <span class="dim">(+ SpecStudio Skills w Claude Code)</span></td>
              </tr>
              <tr>
                <td>Przechowywanie stanu</td>
                <td><code>backlog.md</code> + <code>CLAUDE.md</code> (ukierunkowane na workflow)</td>
                <td><strong>Przenośne drzewo <code>spec/</code></strong> (Markdown + YAML)</td>
              </tr>
              <tr>
                <td>Przetrwa bez narzędzia</td>
                <td>Związane ze środowiskiem Datarim</td>
                <td><strong>Tak</strong> — przenośne z założenia</td>
              </tr>
              <tr>
                <td>Linting specyfikacji</td>
                <td>Brak</td>
                <td><strong>Jakość treści</strong> — nieprecyzyjne czasowniki, brakujące AC, wiszące referencje</td>
              </tr>
              <tr>
                <td>Identyfikatory wymagań / AC</td>
                <td>Brak</td>
                <td><strong>Adresowalne maszynowo ID</strong> (<code>REQ: slug</code>)</td>
              </tr>
              <tr>
                <td>Śledzenie kod-do-specyfikacji</td>
                <td>Brak</td>
                <td><strong>Adnotacje <code>specscore:</code></strong> + trailery <code>Verifies:</code></td>
              </tr>
              <tr>
                <td>Routing wg złożoności (L1–L4)</td>
                <td><strong>Tak</strong></td>
                <td>Nie (format, a nie workflow)</td>
              </tr>
              <tr>
                <td>Przeszukiwalny graf specyfikacji</td>
                <td>Nie</td>
                <td><strong>Tak</strong> — <code>feature list / show / deps</code></td>
              </tr>
              <tr>
                <td>Przywiązanie do Claude Code</td>
                <td>Zbudowany z myślą o nim</td>
                <td><strong>Nie</strong> — dowolny agent lub żaden</td>
              </tr>
              <tr>
                <td>Licencja</td>
                <td>MIT</td>
                <td>MIT / CC BY 4.0</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore goes further ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">Co dodaje SpecScore.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">Wynik pracy przetrwa zmianę workflow</h3>
            <p class="diff-card__desc">
              Stan Datarim żyje we własnym backlogu i strukturze <code>CLAUDE.md</code> —
              wartościowe, dopóki używasz Datarim. Specyfikacje SpecScore to przenośny format, który
              pozostaje czytelny, lintowalny i przeszukiwalny bez jakichkolwiek zainstalowanych narzędzi SpecScore.
              Workflow może się zmienić; specyfikacje zostają z Tobą.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Specyfikacje podlegają lintowaniu</h3>
            <p class="diff-card__desc">
              Workflow prowadzi przez proces pisania, ale nie weryfikuje wyniku.
              <code>lint</code> w SpecScore sprawdza, czy każde wymaganie ma kryteria akceptacji,
              czy powiązania się rozwiązują i czy przejścia stanów są poprawne.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> link  <span class="dim">"Related Feature: discount-tiers" not found</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Kod odsyła bezpośrednio do specyfikacji</h3>
            <p class="diff-card__desc">
              SpecScore wprowadza adnotacje w kodzie źródłowym <code>specscore:</code> oraz
              trailery w commitach <code>Verifies:</code> — polecenie <code>specscore code refs</code>
              odpowiada deterministycznie na pytanie „jaki kod implementuje to wymaganie?”,
              niezależnie od tego, jaki workflow wygenerował specyfikację.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Brak przywiązania do jednego agenta</h3>
            <p class="diff-card__desc">
              Datarim jest zbudowany dla Claude Code. SpecScore to format, który może czytać każdy agent,
              oraz pojedynczy plik binarny w Go, który może uruchomić dowolne CI — bez
              wymogu Claude Code czy instalacji w <code>~/.claude/</code>.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Kiedy wybrać które rozwiązanie.</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Wybierz Datarim, gdy…</h3>
            <ul class="when-card__list">
              <li>Chcesz kompletnego, gotowego pipeline'u w Claude Code już dziś.</li>
              <li>Cenisz routing świadomy złożoności oraz wieloagentowy rytuał podejmowania decyzji.</li>
              <li>Twoja praca obejmuje różne domeny — badania, prawo, treści, a nie tylko kod.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Wybierz SpecScore, gdy…</h3>
            <ul class="when-card__list">
              <li>Chcesz specyfikacji, które przetrwają każdy pojedynczy workflow czy narzędzie.</li>
              <li>Potrzebujesz lintowania, identyfikatorów, cyklu życia i śledzenia powiązań między kodem a specyfikacją.</li>
              <li>Pracujesz z różnymi agentami — lub bez nich — a nie wyłącznie z Claude Code.</li>
              <li>Chcesz CLI, które agenci mogą odpytywać zamiast czytać repozytorium na nowo.</li>
              <li>Potrzebujesz bramek jakości specyfikacji w CI kończących się niezerowym kodem wyjścia.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── Two packs, one format ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">Dwa pakiety workflow, jeden otwarty format.</h2>
        <p class="prose-p">
          Datarim i SpecStudio Skills to zdefiniowane przepływy pracy oparte na Claude
          Code. SpecScore to otwarty format bazowy — artefakt, który dany workflow może
          generować, aby specyfikacje pozostały przenośne, weryfikowalne i powiązane z kodem po zakończeniu działania
          pipeline'u. Datarim generujący SpecScore zachowałby swój intuicyjny UX, zyskując trwały rezultat.
        </p>
        <p class="prose-p">
          Wybierz Datarim dla pipeline'u. Użyj SpecScore dla artefaktu, który po sobie zostawia.
        </p>
      </div>
    </section>

    <ComparisonFeedback page="datarim" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Specyfikacje, które przechodzą testy.</h2>
      <div class="final-cta__buttons">
        <a href="/pl/cli/install/" class="btn btn--primary">Zainstaluj CLI</a>
        <a href="/pl/ai/specstudio-skills/" class="btn btn--secondary">Pobierz skille AI dla swojego agenta</a>
        <a
          href="https://github.com/specscore/specscore"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          Open-source na GitHubie
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterPl />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__breadcrumb {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Shared list ── */
  .shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shared-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }
  .shared-list li::before {
    content: '=';
    position: absolute;
    left: 0;
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pale-ink);
  }

  /* ── Section note ── */
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }

  /* ── Credit cards ── */
  .credit-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .credit-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .credit-card__desc {
    color: var(--mid-ink);
    line-height: 1.6;
    font-size: var(--fs-body);
  }
  .credit-card__desc code {
    font-size: 0.9em;
    background: var(--cream);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Feature comparison table ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .compare-table td:nth-child(2),
  .compare-table td:nth-child(3) {
    min-width: 200px;
  }
  .compare-table td code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .compare-table strong {
    font-weight: 600;
    color: var(--ink);
  }
  .compare-table .dim {
    color: var(--pale-ink);
  }

  /* ── Diff grid ── */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .diff-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .diff-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .diff-card__desc {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .diff-card__desc code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .diff-card__example {
    margin-top: var(--space-2);
  }
  .diff-card__example .terminal {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .diff-grid { grid-template-columns: 1fr; }
  }

  /* ── When to use which ── */
  .when-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .when-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .when-card--primary {
    border-color: var(--validator-green);
    border-width: 2px;
  }
  .when-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .when-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .when-card__list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
    font-size: var(--fs-small);
  }
  .when-card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--pale-ink);
    font-family: var(--font-code);
  }
  .when-card--primary .when-card__list li::before {
    color: var(--validator-green);
  }
  .when-card__list code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; }
  }

  /* ── Bridge section ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-2);
  }
  .prose-p:last-child {
    margin-bottom: 0;
    font-weight: 500;
    color: var(--ink);
  }
  .prose-p code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    text-align: center;
  }
  .final-cta__title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .final-cta__buttons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
