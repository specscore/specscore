---
// Traditional Chinese variant of /validators.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooterZhTw from '../../../components/SiteFooterZhTw.astro';
import LintExample from '../../../components/LintExample.astro';
import ScoreExample from '../../../components/ScoreExample.astro';
---

<BaseLayout
  lang="zh-TW"
  title="SpecScore 校驗什麼 — 又有什麼是它做不到的。"
  description="SpecScore 用兩個校驗器檢查你的規格：確定性的程式碼檢查器和 AI 審查器。看看每一個究竟能捕捉什麼 — 以及自動校驗在哪裡止步，從此交給你的判斷。"
  canonical="https://specscore.md/zh-tw/validators/"
>
  <SiteHeader />

  <main>
    {/* ── Hero: orient the cold reader, then show lint passing ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 id="hero-title" class="hero__headline">
          SpecScore<br />校驗什麼。
        </h1>
        <div class="hero__copy">
          <p class="hero__sub">
            SpecScore 是一種用於功能、需求和驗收標準的開放式 Markdown
            格式 — 由兩個校驗器檢查：確定性的<strong>程式碼檢查器</strong>和
            <strong>AI 審查器</strong>。下面就是每一個能捕捉什麼，以及自動檢查在哪裡止步。
          </p>
          <p class="hero__context">
            初次了解 SpecScore？<a class="xref" href="/zh-tw/">從這裡開始</a> ·
            <a class="xref" href="/zh-tw/cli/">CLI</a> ·
            <a class="xref" href="/zh-tw/ai/">AI 技能</a>
          </p>
        </div>

        <div
          class="hero__art"
          role="img"
          aria-label="終端機輸出：specscore lint 在 checkout 規格上通過全部 24 個需求 — 結構、引用、ID 均合法，無索引漂移、無失效連結、無 slug 衝突。0 個問題，exit 0。"
        >
<pre class="terminal terminal--window"><span class="prompt">$</span> specscore lint checkout/

  <span class="mark-pass">✓</span> 24 requirements — structure, references, IDs valid
  <span class="mark-pass">✓</span> no index drift · no broken links · no slug collisions

  <span class="dim">0 problems   exit 0</span></pre>
        </div>
      </div>
    </section>

    {/* ── The three layers ── */}
    <section class="section" aria-labelledby="layers-title">
      <div class="section-inner section-inner--prose">
        <h2 id="layers-title" class="section-title">三層，而非一層。</h2>
        <p class="prose-p">
          SpecScore 分層校驗，最廉價、最確定的優先。<strong>程式碼檢查器</strong>是確定性的 —
          快速、免費，每次提交都執行。<strong>AI 審查</strong>是機率性的 —
          更深入，消耗 token，能捕捉程式碼檢查器夠不著的東西。<strong>人的判斷</strong>是第三層：
          前兩層無法彌合的縫隙仍然需要人 — 因為目前還沒有工具能可靠地彌合它們。
          這兩個自動層是互補的，而非冗餘的：程式碼檢查器捕捉 AI 無法佐證的問題，AI 捕捉程式碼檢查器夠不著的問題。
        </p>
      </div>
    </section>

    {/* ── What each validator checks (the positive half) ── */}
    <section class="section validators-section" aria-labelledby="checks-title">
      <div class="section-inner">
        <h2 id="checks-title" class="section-title">每個校驗器檢查什麼。</h2>
        <div class="vcols">
          <div class="vcol">
            <div class="validator__head">
              <span class="validator__layer">Layer 1</span>
              <h3 class="validator__title">CLI 程式碼檢查器</h3>
              <span class="validator__kind">deterministic</span>
            </div>
            <p class="validator__lead">
              每次執行結果相同，不用 LLM，零成本。如果在這裡通過了，那就是事實 — 而非意見。
            </p>
            <div
              class="checks-terminal"
              role="img"
              aria-label="specscore lint 的輸出：R1 和 R2 具有驗收標準；R3 沒有，一個 Related Feature 連結無法解析，缺少必需的 Open Questions 章節。3 個問題，exit 1。"
            >
              <LintExample />
            </div>
            <ul class="vlist">
              <li><span class="mark mark--pass" aria-hidden="true">✓</span> 引用完整性 — 連結可解析、ID 唯一</li>
              <li><span class="mark mark--pass" aria-hidden="true">✓</span> 結構約定 — 必需的章節、frontmatter 的形態</li>
              <li><span class="mark mark--pass" aria-hidden="true">✓</span> 狀態衛生與索引漂移</li>
              <li><span class="mark mark--pass" aria-hidden="true">✓</span> slug 衝突</li>
              <li><span class="mark mark--pass" aria-hidden="true">✓</span> 元資料欄位上的前綴合法性（例如 <code>Related Ideas:</code>）</li>
            </ul>
          </div>
          <div class="vcol">
            <div class="validator__head">
              <span class="validator__layer">Layer 2</span>
              <h3 class="validator__title">AI 審查與評分</h3>
              <span class="validator__kind">non-deterministic</span>
            </div>
            <p class="validator__lead">
              像人類審查者那樣按含義閱讀 — 也和人一樣，並非完全可重複。
            </p>
            <div
              class="checks-terminal"
              role="img"
              aria-label="/score 的輸出：該規格獲得 B 等級，並附有兩條可操作的提示 — AC-2 上的觸發條件含糊，AC-3 缺少錯誤處理路徑。"
            >
              <ScoreExample />
            </div>
            <ul class="vlist">
              <li><span class="mark mark--pass" aria-hidden="true">✓</span> 驗收標準是否寫成可驗證的 Given/When/Then</li>
              <li><span class="mark mark--pass" aria-hidden="true">✓</span> 單個產物內部的一致性</li>
              <li><span class="mark mark--pass" aria-hidden="true">✓</span> 含糊或占位性的內容</li>
              <li><span class="mark mark--pass" aria-hidden="true">✓</span> 對人類審查者而言的可讀性</li>
              <li><span class="mark mark--pass" aria-hidden="true">✓</span> 作者可操作、標註了嚴重級別的回饋</li>
              <li><span class="mark mark--pass" aria-hidden="true">✓</span> A–F 的就緒度評級</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── #limits — what they don't catch (the honest half) ── */}
    <section class="section limits-section" id="limits" aria-labelledby="limits-title">
      <div class="section-inner">
        <h2 id="limits-title" class="section-title">它們捕捉不到什麼。</h2>
        <p class="section-lead">
          沒有哪個校驗器是魔法。下面就是每一個止步之處 — 好讓你清楚地知道，哪裡仍然需要你自己的判斷來完成工作。
        </p>
        <div class="vcols">
          <div class="vcol">
            <div class="validator__head">
              <span class="validator__layer">Layer 1</span>
              <h3 class="validator__title">CLI 程式碼檢查器</h3>
            </div>
            <ul class="vlist">
              <li><span class="mark mark--fail" aria-hidden="true">✗</span> 跨深階層的隱式矛盾</li>
              <li><span class="mark mark--fail" aria-hidden="true">✗</span> 規格與程式碼之間的漂移 <span class="vnote">（隨著 <code>specstudio:recap</code> 上線而改善）</span></li>
              <li><span class="mark mark--fail" aria-hidden="true">✗</span> 驗收標準在語意上的正確性</li>
              <li><span class="mark mark--fail" aria-hidden="true">✗</span> 一個名稱是否真的講得通</li>
              <li><span class="mark mark--fail" aria-hidden="true">✗</span> 這些需求是否解決了所陳述的問題</li>
            </ul>
          </div>
          <div class="vcol">
            <div class="validator__head">
              <span class="validator__layer">Layer 2</span>
              <h3 class="validator__title">AI 審查與評分</h3>
              <span class="validator__kind">捕捉並不穩定</span>
            </div>
            <ul class="vlist">
              <li><span class="mark mark--fail" aria-hidden="true">✗</span> 完全的逐次可重現性 — 在容差範圍內裁決可能會變化</li>
              <li><span class="mark mark--fail" aria-hidden="true">✗</span> 沒有顯式交叉檢查時，大型樹中跨產物的矛盾</li>
              <li><span class="mark mark--fail" aria-hidden="true">✗</span> 需求是否真正解決了問題 — 能標出明顯的缺口，會漏掉特定領域的缺口</li>
              <li><span class="mark mark--fail" aria-hidden="true">✗</span> 從底層 LLM 繼承而來的偏見</li>
              <li><span class="mark mark--fail" aria-hidden="true">✗</span> 以絕對的把握保證語意正確性</li>
              <li><span class="mark mark--fail" aria-hidden="true">✗</span> 任何評分細則沒有納入權重的東西</li>
            </ul>
          </div>
        </div>

        <ol class="bands" aria-label="校驗的三個層次，按覆蓋深度排列">
          <li class="band">
            <span class="band__step">1</span>
            <h3 class="band__title">程式碼檢查器夠到這裡</h3>
            <p class="band__desc">
              結構、引用、衛生。廉價又確定 — 但對含義視而不見。
            </p>
          </li>
          <li class="band band--mid">
            <span class="band__step">2</span>
            <h3 class="band__title">AI 夠到這裡</h3>
            <p class="band__desc">
              含義、清晰度、單個產物內部的一致性。更深入 — 但是機率性的，在大型樹上較弱。
            </p>
          </li>
          <li class="band band--human">
            <span class="band__step">3</span>
            <h3 class="band__title">仍然要靠你</h3>
            <p class="band__desc">
              對整個系統的貫穿式判斷 — 這是目前沒有工具能可靠完成的工作，所以仍然需要一位人類審查者。
            </p>
          </li>
        </ol>

        <div class="worked">
          <h3 class="worked__title">兩個工具都救不了你的那種情形</h3>
          <p class="worked__body">
            想像一棵真實而深的規格樹。功能&nbsp;A 要求 <em>X</em>。功能&nbsp;B 要求
            <em>Y</em>。功能&nbsp;C 要求 <em>Z</em>。然後功能&nbsp;D 悄悄要求了某個與 B
            矛盾的東西 — 但只在 A 同時生效時才矛盾。程式碼檢查器看到的是四份合法、彼此連結良好的文件，於是通過了。
            AI 審查器逐個閱讀產物，沒有理由把這四份一起載入進來，從而注意到這種三方互動。
          </p>
          <p class="worked__body">
            <strong>這兩層都無法可靠地捕捉它 — 我們也不會假裝不是這樣。</strong>
            正是這一類矛盾，才是第三層存在的理由。SpecScore 的職責是把這棵樹做得足夠易於導覽，
            讓一位審查縫隙的人能夠<em>找到</em>衝突 — 開放問題沿階層向上傳播、相關需求只需一次查詢即達 —
            而不是聲稱某個工具已經替你找到了它。
          </p>
        </div>
      </div>
    </section>
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">誠實的工具，誠實的規格。</h2>
      <div class="final-cta__buttons">
        <a href="/zh-tw/cli/install/" class="btn btn--primary">安裝 CLI</a>
        <a href="/zh-tw/ai/specstudio-skills/" class="btn btn--secondary">為你的代理取得 AI 技能</a>
        <a
          href="https://github.com/specscore/specscore-cli"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          在 GitHub 上開源
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterZhTw />
</BaseLayout>

<style>
  /* ── Hero (mirrors /cli two-column rhythm) ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-7);
    background: var(--cream);
    overflow: hidden;
  }
  .hero__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    display: grid;
    grid-template-columns: 38fr 62fr;
    gap: var(--space-3) var(--space-6);
    align-items: center;
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
  }
  .hero__inner > .hero__headline {
    grid-column: 1 / -1;
    margin-bottom: 0;
  }
  .hero__copy {
    animation: hero-copy-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 280ms;
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }
  .hero__sub strong { color: var(--ink); }
  .hero__context {
    margin-top: var(--space-3);
    font-size: var(--fs-small);
    color: var(--pale-ink);
  }
  .hero__art {
    animation: hero-art-in 700ms cubic-bezier(0.22, 0.61, 0.36, 1) both 100ms;
    min-width: 0;
  }
  .hero__art pre.terminal {
    margin: 0;
    font-size: 0.78rem;
    line-height: 1.65;
  }

  @keyframes hero-copy-in {
    from { opacity: 0; transform: translateY(12px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes hero-art-in {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 860px) {
    .hero { padding: var(--space-5) var(--space-3) var(--space-6); }
    .hero__inner { grid-template-columns: 1fr; gap: var(--space-4); }
    .hero__copy { order: 1; }
    .hero__art  { order: 2; }
  }

  /* ── Section scaffolding ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }
  .section-lead {
    color: var(--mid-ink);
    line-height: 1.6;
    max-width: 60ch;
    margin-bottom: var(--space-4);
  }
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
  }
  .prose-p strong { color: var(--ink); }

  /* ── Validator columns (used by both "checks" and "#limits") ── */
  .validators-section { background: var(--cream); }
  .limits-section {
    background: var(--cream-2);
    scroll-margin-top: var(--space-5);
  }

  .validator__head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  .validator__layer {
    font-family: var(--font-display);
    font-size: var(--fs-tiny);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--pale-ink);
  }
  .validator__title {
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .validator__kind {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--mid-ink);
  }
  .validator__lead {
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-3);
  }

  .checks-terminal {
    margin-bottom: var(--space-3);
  }
  .checks-terminal pre.terminal {
    margin: 0;
    font-size: 0.72rem;
    line-height: 1.65;
  }

  .vcols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-5);
  }
  .vlist {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .vlist li {
    position: relative;
    padding-left: 1.6rem;
    color: var(--ink);
    line-height: 1.5;
    font-size: var(--fs-small);
  }
  .vlist code {
    font-size: 0.9em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .mark {
    position: absolute;
    left: 0;
    font-weight: 700;
    font-family: var(--font-code);
  }
  .mark--pass { color: var(--validator-green); }
  .mark--fail { color: var(--mark-red); }
  .vnote { color: var(--pale-ink); }

  @media (max-width: 640px) {
    .vcols { grid-template-columns: 1fr; gap: var(--space-4); }
  }

  /* ── Synthesis bands ── */
  .bands {
    list-style: none;
    margin: var(--space-5) 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-3);
  }
  .band {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-top: 3px solid var(--validator-green);
    padding: var(--space-3);
  }
  .band--mid { border-top-color: var(--ink-blue); }
  .band--human { border-top-color: var(--mark-red); }
  .band__step {
    font-family: var(--font-display);
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--pale-ink);
  }
  .band__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin: var(--space-1) 0;
  }
  .band__desc {
    font-size: var(--fs-small);
    color: var(--mid-ink);
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .bands { grid-template-columns: 1fr; }
  }

  /* ── Worked example ── */
  .worked {
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-left: 3px solid var(--ink);
    padding: var(--space-4);
  }
  .worked__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .worked__body {
    color: var(--mid-ink);
    line-height: 1.65;
  }
  .worked__body + .worked__body { margin-top: var(--space-2); }
  .worked__body strong { color: var(--ink); }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    text-align: center;
  }
  .final-cta__title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .final-cta__buttons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
