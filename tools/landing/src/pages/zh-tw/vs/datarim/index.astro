---
// /zh-tw/vs/datarim/ — SpecScore vs Datarim comparison (zh-TW).
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterZhTw from '../../../../components/SiteFooterZhTw.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="zh-TW"
  title="SpecScore vs Datarim — 客觀對比"
  description="SpecScore 與 Datarim 基於事實的對比：一個 Claude Code 工作流程套件 vs 一種開放、可攜的規範格式。處於不同層面——而且它們可以組合。"
  canonical="https://specscore.md/zh-tw/vs/datarim/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/zh-tw/vs/" class="xref">對比列表</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs Datarim
        </h1>
        <p class="hero__sub">
          不同的層面。Datarim 是一套面向 Claude Code 的、有主見的<strong>工作流程套件</strong>——
          一組斜線命令，把專案從需求一路執行到完成。SpecScore 是規範書寫所用的<strong>開放格式</strong>，
          外加一個用於 lint、查詢和追溯它們的 CLI。一個工作流程可以以它為目標。
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">兩者的共同點。</h2>
        <ul class="shared-list">
          <li>兩者都為 AI 輔助開發帶來結構化的方法論。</li>
          <li>兩者均基於 MIT 授權條款開源。</li>
          <li>兩者都在 Claude Code 內執行——Datarim 以命令形式，SpecScore 透過 SpecStudio Skills。</li>
          <li>兩者都將其狀態以 Markdown 形式保存在儲存庫中，受版本控制。</li>
        </ul>
      </div>
    </section>

    {/* ── What Datarim does well ── */}
    <section class="section" aria-labelledby="datarim-title">
      <div class="section-inner section-inner--prose">
        <h2 id="datarim-title" class="section-title">Datarim 的優勢。</h2>
        <p class="section-note">
          <a href="https://github.com/Arcanada-one/datarim" rel="nofollow noopener" target="_blank" class="xref">Datarim</a>
          是一個為 Claude Code 打造的通用反覆運算式工作流程框架。
        </p>

        <div class="credit-card">
          <h3 class="credit-card__title">原生的斜線命令體驗</h3>
          <p class="credit-card__desc">
            一條以命令形式呈現的完整管線——<code>/dr-prd</code>、<code>/dr-plan</code>、
            <code>/dr-design</code>、<code>/dr-do</code>、<code>/dr-qa</code>——
            在 Claude Code 中宛如歸家。一次 <code>install.sh</code> 到 <code>~/.claude/</code>
            你就開始執行了。
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">複雜度感知的路由（L1–L4）</h3>
          <p class="credit-card__desc">
            Datarim 會評估工作的規模並據此路由：一個 L1 快速修復跳過
            規劃，而一個 L4 重大變更則執行一條帶多輪審查的分階段管線。
            讓儀式與範圍相匹配是一個真正出色的構想。
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Consilium 與多領域覆蓋</h3>
          <p class="credit-card__desc">
            它的 "consilium" 會組建一個代理專家組，在給出建議之前先就權衡展開辯論。
            而且它不限於軟體——Datarim 還面向研究、法律和內容類工作流程。
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">功能對比。</h2>
        <p class="section-note">
          一個是工作流程，另一個是格式——這張表對比的是角色，而非勝負。
        </p>

        <div class="table-wrap">
          <table class="compare-table" aria-label="SpecScore 與 Datarim 功能對比">
            <thead>
              <tr>
                <th scope="col">能力</th>
                <th scope="col">Datarim</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>主要角色</td>
                <td>Claude Code 工作流程套件</td>
                <td><strong>開放規範格式 + CLI</strong></td>
              </tr>
              <tr>
                <td>執行方式</td>
                <td>斜線命令（<code>/dr-*</code>）</td>
                <td>格式檔案 + CLI <span class="dim">（+ Claude Code 中的 SpecStudio Skills）</span></td>
              </tr>
              <tr>
                <td>狀態儲存</td>
                <td><code>backlog.md</code> + <code>CLAUDE.md</code>（工作流程形態）</td>
                <td><strong>可攜的 <code>spec/</code> 樹</strong>（Markdown + YAML）</td>
              </tr>
              <tr>
                <td>脫離工具仍可存續</td>
                <td>綁定於 Datarim 執行階段</td>
                <td><strong>可以</strong> — 在構造上即可攜</td>
              </tr>
              <tr>
                <td>規範 linting</td>
                <td>無</td>
                <td><strong>內容品質</strong> — 模糊動詞、缺失驗收標準、懸空引用</td>
              </tr>
              <tr>
                <td>需求 / 驗收標準 ID</td>
                <td>無</td>
                <td><strong>機器可定址的 ID</strong>（<code>REQ: slug</code>）</td>
              </tr>
              <tr>
                <td>程式碼到規範的可追溯性</td>
                <td>無</td>
                <td><strong><code>specscore:</code> 註解</strong> + <code>Verifies:</code> 尾註</td>
              </tr>
              <tr>
                <td>複雜度路由（L1–L4）</td>
                <td><strong>支援</strong></td>
                <td>不支援（格式，而非工作流程）</td>
              </tr>
              <tr>
                <td>可查詢的規範圖譜</td>
                <td>不支援</td>
                <td><strong>支援</strong> — <code>feature list / show / deps</code></td>
              </tr>
              <tr>
                <td>綁定 Claude Code</td>
                <td>為它而生</td>
                <td><strong>否</strong> — 任意代理，或不用代理</td>
              </tr>
              <tr>
                <td>授權條款</td>
                <td>MIT</td>
                <td>MIT / CC BY 4.0</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore goes further ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">SpecScore 增添了什麼。</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">產出比工作流程更長久</h3>
            <p class="diff-card__desc">
              Datarim 的狀態存在於它自己的 backlog 和 <code>CLAUDE.md</code> 形態中——
              當你執行 Datarim 時它很有價值。SpecScore 的規範是一種可攜的格式，
              即便完全沒有安裝任何 SpecScore 工具，也依然可讀、可 lint、可查詢。
              工作流程可以更換；規範跟著你走。
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">規範是可 lint 的</h3>
            <p class="diff-card__desc">
              工作流程引導編寫，但並不為結果設門檻。SpecScore 的
              <code>lint</code> 校驗每個需求都有驗收標準、
              交叉引用可解析、狀態轉換合法。
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> link  <span class="dim">"Related Feature: discount-tiers" not found</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">程式碼可追溯回規範</h3>
            <p class="diff-card__desc">
              SpecScore 新增了 <code>specscore:</code> 源註解和
              <code>Verifies:</code> 提交尾註——<code>specscore code refs</code>
              能確定性地回答「哪些程式碼實現了這個需求？」，
              與產出該規範的工作流程無關。
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">不綁定單一代理</h3>
            <p class="diff-card__desc">
              Datarim 為 Claude Code 而生。SpecScore 是任何代理都能讀取的格式，
              也是任何 CI 都能執行的單一 Go 二進位檔案——無需 Claude Code，無需
              <code>~/.claude/</code> 安裝。
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">何時使用哪一個。</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">以下場景適合使用 Datarim……</h3>
            <ul class="when-card__list">
              <li>你想要在 Claude Code 中立刻擁有一條完整、有主見的管線。</li>
              <li>你看重複雜度感知的路由和多代理決策儀式。</li>
              <li>你的工作橫跨多個領域——研究、法律、內容，而不僅僅是程式碼。</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">以下場景適合使用 SpecScore……</h3>
            <ul class="when-card__list">
              <li>你想要比任何單一工作流程或工具都更長久的規範。</li>
              <li>你需要 lint、ID、生命週期，以及程式碼到規範的可追溯性。</li>
              <li>你跨多個代理工作——或不用代理——而不只是 Claude Code。</li>
              <li>你想要一個代理可以查詢、而非反覆閱讀儲存庫的 CLI。</li>
              <li>你需要在 CI 中設定返回非零結束代碼的規範品質門檻。</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── Two packs, one format ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">兩個工作流程套件，一種開放格式。</h2>
        <p class="prose-p">
          Datarim 和 SpecStudio Skills 都是構建在 Claude
          Code 之上、有主見的工作流程。SpecScore 是底層的開放格式——一個工作流程可以
          產出的產物，讓規範在管線結束之後依然可攜、可 lint、可追溯。一個能輸出
          SpecScore 的 Datarim 既能保留它的體驗，又能獲得持久的產出。
        </p>
        <p class="prose-p">
          為管線選擇 Datarim。為它留下的產物使用 SpecScore。
        </p>
      </div>
    </section>

    <ComparisonFeedback page="datarim" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">通過檢查的規範。</h2>
      <div class="final-cta__buttons">
        <a href="/zh-tw/cli/install/" class="btn btn--primary">安裝 CLI</a>
        <a href="/zh-tw/ai/specstudio-skills/" class="btn btn--secondary">取得 AI 代理技能</a>
        <a
          href="https://github.com/specscore/specscore"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          在 GitHub 上開源
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterZhTw />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__breadcrumb {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Shared list ── */
  .shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shared-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }
  .shared-list li::before {
    content: '=';
    position: absolute;
    left: 0;
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pale-ink);
  }

  /* ── Section note ── */
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }

  /* ── Credit cards ── */
  .credit-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .credit-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .credit-card__desc {
    color: var(--mid-ink);
    line-height: 1.6;
    font-size: var(--fs-body);
  }
  .credit-card__desc code {
    font-size: 0.9em;
    background: var(--cream);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Feature comparison table ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .compare-table td:nth-child(2),
  .compare-table td:nth-child(3) {
    min-width: 200px;
  }
  .compare-table td code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .compare-table strong {
    font-weight: 600;
    color: var(--ink);
  }
  .compare-table .dim {
    color: var(--pale-ink);
  }

  /* ── Diff grid ── */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .diff-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .diff-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .diff-card__desc {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .diff-card__desc code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .diff-card__example {
    margin-top: var(--space-2);
  }
  .diff-card__example .terminal {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .diff-grid { grid-template-columns: 1fr; }
  }

  /* ── When to use which ── */
  .when-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .when-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .when-card--primary {
    border-color: var(--validator-green);
    border-width: 2px;
  }
  .when-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .when-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .when-card__list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
    font-size: var(--fs-small);
  }
  .when-card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--pale-ink);
    font-family: var(--font-code);
  }
  .when-card--primary .when-card__list li::before {
    color: var(--validator-green);
  }
  .when-card__list code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; }
  }

  /* ── Bridge section ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-2);
  }
  .prose-p:last-child {
    margin-bottom: 0;
    font-weight: 500;
    color: var(--ink);
  }
  .prose-p code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    text-align: center;
  }
  .final-cta__title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .final-cta__buttons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
