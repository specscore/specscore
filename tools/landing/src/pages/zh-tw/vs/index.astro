---
// /zh-tw/vs/ — Comparison index page (zh-TW).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooterZhTw from '../../../components/SiteFooterZhTw.astro';
import ComparisonFeedback from '../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="zh-TW"
  title="SpecScore 對比 — SpecScore 與其他工具的比較"
  description="SpecScore 與其他規範驅動開發工具之間客觀、詳細的對比。功能對照表、架構差異，以及各自的適用場景。"
  canonical="https://specscore.md/zh-tw/vs/"
  markdownHref="/zh-tw/vs.md"
>
  <SiteHeader />

  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 id="hero-title" class="hero__headline">
          SpecScore 與其他工具的比較
        </h1>
        <p class="hero__sub">
          規範驅動開發是一個快速發展的領域。以下對比基於事實、逐項並列，並坦誠地指出每個工具的優勢所在。
        </p>
        <p class="hero__sub">
          <a href="/zh-tw/spec-driven-development/tools/" class="xref">2026 年最佳規範驅動開發工具</a>
          把同樣的工具放在一頁上。
        </p>
      </div>
    </section>

    <section class="section minis-section" aria-labelledby="comparisons-title">
      <div class="section-inner">
        <h2 id="comparisons-title" class="sr-only">對比列表</h2>

        <p class="minis__lead">
          <span class="minis__brand">SpecScore</span>
          <span class="minis__vs">vs</span>
        </p>

        <div class="minis">
          <a href="/zh-tw/vs/plain-markdown/" class="mini">
            <span class="mini__name">Plain Markdown</span>
            <span class="mini__line">預設選擇。SpecScore 是你的 Markdown 進階後的樣子。</span>
          </a>
          <a href="/zh-tw/vs/openspec/" class="mini">
            <span class="mini__name">OpenSpec</span>
            <span class="mini__line">一個可靠的入門通道。SpecScore 是品質護欄。</span>
          </a>
          <a href="/zh-tw/vs/spec-kit/" class="mini">
            <span class="mini__name">Spec Kit</span>
            <span class="mini__line">Spec Kit 是工作流程。SpecScore 是產物。</span>
          </a>
          <a href="/zh-tw/vs/datarim/" class="mini">
            <span class="mini__name">Datarim</span>
            <span class="mini__line">Datarim 執行管線。SpecScore 是它留下的成果。</span>
          </a>
          <a href="/zh-tw/vs/codespeak/" class="mini">
            <span class="mini__name">CodeSpeak</span>
            <span class="mini__line">CodeSpeak 押注於編譯器。SpecScore 押注於格式。</span>
          </a>
          <a href="/zh-tw/vs/kiro/" class="mini">
            <span class="mini__name">Kiro</span>
            <span class="mini__line">Kiro 在 IDE 裡起草規格。SpecScore 是 CI 可以檢查的格式。</span>
          </a>
          <a href="/zh-tw/vs/tessl/" class="mini">
            <span class="mini__name">Tessl</span>
            <span class="mini__line">Tessl 主張規格即源頭。SpecScore 檢查放在程式碼旁邊的規格。</span>
          </a>
          <a href="/zh-tw/vs/bmad-method/" class="mini">
            <span class="mini__name">BMAD Method</span>
            <span class="mini__line">BMAD 跑敏捷循環。SpecScore 是拉取請求可以檢查的產物。</span>
          </a>
          <a href="/zh-tw/vs/task-master-ai/" class="mini">
            <span class="mini__name">Task Master AI</span>
            <span class="mini__line">Task Master 把 PRD 拆成任務。SpecScore 是這些任務可以引用的規格。</span>
          </a>
        </div>
      </div>
    </section>

    {/* ── Cross-comparison matrix ── */}
    <section class="section table-section" aria-labelledby="matrix-title">
      <div class="section-inner">
        <h2 id="matrix-title" class="section-title">SpecScore 一覽。</h2>
        <p class="section-note">
          與最接近的幾款工具的高層對照檢視。每款工具都有真正的優勢 —
          點擊上方的對比，查看坦誠而詳細的版本。
        </p>

        <div class="table-wrap">
          <table class="matrix-table" aria-label="SpecScore 與 Plain Markdown、OpenSpec、Spec Kit、Datarim 和 CodeSpeak 的對比, Kiro, Tessl, BMAD Method, Task Master AI">
            <thead>
              <tr>
                <th scope="col">能力</th>
                <th scope="col" class="matrix-table__own">SpecScore</th>
                <th scope="col"><a href="/zh-tw/vs/plain-markdown/" class="matrix-table__link">Plain Markdown</a></th>
                <th scope="col"><a href="/zh-tw/vs/openspec/" class="matrix-table__link">OpenSpec</a></th>
                <th scope="col"><a href="/zh-tw/vs/spec-kit/" class="matrix-table__link">Spec Kit</a></th>
                <th scope="col"><a href="/zh-tw/vs/datarim/" class="matrix-table__link">Datarim</a></th>
                <th scope="col"><a href="/zh-tw/vs/codespeak/" class="matrix-table__link">CodeSpeak</a></th>
                <th scope="col"><a href="/zh-tw/vs/kiro/" class="matrix-table__link">Kiro</a></th>
                <th scope="col"><a href="/zh-tw/vs/tessl/" class="matrix-table__link">Tessl</a></th>
                <th scope="col"><a href="/zh-tw/vs/bmad-method/" class="matrix-table__link">BMAD Method</a></th>
                <th scope="col"><a href="/zh-tw/vs/task-master-ai/" class="matrix-table__link">Task Master AI</a></th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>主要角色</td>
                <td class="matrix-table__own">可 lint 的規範格式 + CLI</td>
                <td>自由格式文件（預設）</td>
                <td>規範組織框架</td>
                <td>工作流程 / 方法論</td>
                <td>Claude Code 工作流程套裝</td>
                <td>LLM 編譯器（規範 → 程式碼）</td>
                              <td>起草規格的代理 IDE</td>
                <td>技能平台 + 規格 tile</td>
                <td>敏捷的 AI 方法</td>
                <td>給代理用的任務列表</td>
</tr>
              <tr>
                <td>規範格式</td>
                <td class="matrix-table__own">Markdown + YAML（結構化）</td>
                <td>自由格式 Markdown</td>
                <td>Markdown</td>
                <td>自由格式 Markdown</td>
                <td>Markdown（工作流程形態）</td>
                <td>純英文</td>
                              <td>EARS 的 requirements.md</td>
                <td>.spec.md（tile）</td>
                <td>PRD、架構、故事</td>
                <td>散文 PRD，然後是任務</td>
</tr>
              <tr>
                <td>程式碼歸你所有</td>
                <td class="matrix-table__own"><span class="yes">支援</span></td>
                <td><span class="yes">支援</span></td>
                <td><span class="yes">支援</span></td>
                <td><span class="yes">支援</span></td>
                <td><span class="yes">支援</span></td>
                <td><span class="no">程式碼是產生的</span></td>
                              <td><span class="yes">是</span></td>
                <td><span class="yes">是</span></td>
                <td><span class="yes">是</span></td>
                <td><span class="yes">是</span></td>
</tr>
              <tr>
                <td>開源 / 免費</td>
                <td class="matrix-table__own"><span class="yes">支援</span>（<a href="https://github.com/specscore/specscore/blob/main/LICENSE">CC BY 4.0</a> / <a href="https://github.com/specscore/specscore-cli/blob/main/LICENSE">Apache-2.0</a>）</td>
                <td><span class="yes">免費</span></td>
                <td><span class="yes">支援</span>（MIT）</td>
                <td><span class="yes">支援</span>（MIT）</td>
                <td><span class="yes">支援</span>（MIT）</td>
                <td><span class="no">專有系統</span></td>
                              <td>專有 IDE，有免費档</td>
                <td>tile 為 MIT；平台是產品</td>
                <td>是（MIT）</td>
                <td>MIT + Commons Clause</td>
</tr>
              <tr>
                <td>規範內容 linting</td>
                <td class="matrix-table__own"><span class="yes">支援</span></td>
                <td><span class="no">不支援</span></td>
                <td>僅檔案結構</td>
                <td><span class="no">不支援</span></td>
                <td><span class="no">不支援</span></td>
                <td>無文件說明</td>
                              <td>產品內分析</td>
                <td>tile 裡的 shell 檢查</td>
                <td>流程中的就緒門</td>
                <td><span class="no">否</span></td>
</tr>
              <tr>
                <td>需求 / 驗收標準 ID</td>
                <td class="matrix-table__own"><span class="yes">支援</span></td>
                <td><span class="no">不支援</span></td>
                <td><span class="no">不支援</span></td>
                <td><span class="no">不支援</span></td>
                <td><span class="no">不支援</span></td>
                <td><span class="no">不支援</span></td>
                              <td>文件未說明</td>
                <td>[@test] 連結</td>
                <td>故事檔案</td>
                <td>數字任務 id</td>
</tr>
              <tr>
                <td>強制執行的生命週期</td>
                <td class="matrix-table__own"><span class="yes">支援</span></td>
                <td><span class="no">不支援</span></td>
                <td><span class="no">不支援</span></td>
                <td><span class="no">不支援</span></td>
                <td><span class="no">不支援</span></td>
                <td><span class="no">不支援</span></td>
                              <td>任務狀態</td>
                <td>tile 中的批准</td>
                <td>迭代 / 故事狀態</td>
                <td>狀態和標籤</td>
</tr>
              <tr>
                <td>程式碼到規範的可追溯性</td>
                <td class="matrix-table__own"><span class="yes">支援</span></td>
                <td><span class="no">不支援</span></td>
                <td><span class="no">不支援</span></td>
                <td><span class="no">不支援</span></td>
                <td><span class="no">不支援</span></td>
                <td>透過重新產生</td>
                              <td>經由任務</td>
                <td>targets 與 [@test]</td>
                <td>故事攜帶上下文</td>
                <td>任務依賴</td>
</tr>
              <tr>
                <td>執行階段相依性</td>
                <td class="matrix-table__own">無（Go 二進位檔案）</td>
                <td>無</td>
                <td>Node.js</td>
                <td>Python</td>
                <td>Claude Code</td>
                <td>廠商編譯器</td>
                              <td>Kiro 應用</td>
                <td>Tessl CLI + 代理</td>
                <td>Node.js 與 Python</td>
                <td>Node.js</td>
</tr>
              <tr>
                <td>適用於任意代理，或不用代理</td>
                <td class="matrix-table__own"><span class="yes">支援</span></td>
                <td>讀取每個檔案</td>
                <td>多種代理</td>
                <td>多種代理</td>
                <td>Claude Code</td>
                <td>透過 CodeSpeak</td>
                              <td>Kiro 的代理</td>
                <td>多種代理</td>
                <td>多種編碼代理</td>
                <td>透過 MCP</td>
</tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <ComparisonFeedback />
  </main>

  <SiteFooterZhTw />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-4) var(--space-3) var(--space-2);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__headline {
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-1);
  }
  .hero__sub {
    font-size: 1rem;
    color: var(--mid-ink);
    line-height: 1.5;
  }

  /* Pull the mini-cards up tight under the hero */
  .minis-section {
    padding-top: var(--space-3);
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Screen-reader only ── */
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* ── Mini comparison cards ── */
  .minis__lead {
    text-align: center;
    line-height: 1.05;
    margin-bottom: var(--space-3);
  }
  .minis__brand {
    display: block;
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .minis__vs {
    display: block;
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
  }
  .minis {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-2);
  }
  .mini {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    background: var(--surface);
    border: 1px solid var(--hairline);
    border-top: 2px solid var(--validator-green);
    padding: var(--space-3);
    text-decoration: none;
    color: inherit;
    transition: border-color 160ms ease, box-shadow 160ms ease;
  }
  .mini:hover {
    border-color: var(--graphite);
    box-shadow: 0 2px 8px rgba(26, 26, 26, 0.06);
  }
  .mini:focus-visible {
    outline: 2px solid var(--ink-blue);
    outline-offset: 2px;
  }
  .mini__name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
  }
  .mini__line {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.45;
  }

  @media (max-width: 980px) {
    .minis { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    .minis { grid-template-columns: repeat(2, 1fr); }
  }

  /* ── Section title / note (matrix) ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
    max-width: 60ch;
  }

  /* ── Cross-comparison matrix ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .matrix-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .matrix-table th,
  .matrix-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .matrix-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .matrix-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .matrix-table td,
  .matrix-table th {
    min-width: 130px;
  }
  /* Highlight the SpecScore column */
  .matrix-table__own {
    background: var(--surface);
    font-weight: 600;
    color: var(--ink);
    border-left: 2px solid var(--validator-green);
    border-right: 2px solid var(--validator-green);
  }
  thead .matrix-table__own {
    color: var(--validator-green);
    border-bottom-color: var(--validator-green);
  }
  /* Column-header links to each comparison */
  .matrix-table__link {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px dotted var(--pale-ink);
    transition: color 160ms ease, border-color 160ms ease;
  }
  .matrix-table__link:hover {
    color: var(--validator-green);
    border-bottom-color: var(--validator-green);
  }
  .matrix-table__link:focus-visible {
    outline: 2px solid var(--ink-blue);
    outline-offset: 2px;
  }
  .matrix-table .yes {
    color: var(--validator-green);
    font-weight: 600;
  }
  .matrix-table .no {
    color: var(--pale-ink);
  }
</style>
