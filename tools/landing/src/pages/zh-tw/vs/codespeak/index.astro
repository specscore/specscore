---
// /zh-tw/vs/codespeak/ — SpecScore vs CodeSpeak comparison (zh-TW).
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterZhTw from '../../../../components/SiteFooterZhTw.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
import MoreComparisons from '../../../../components/MoreComparisons.astro';
---

<BaseLayout
  lang="zh-TW"
  title="SpecScore vs CodeSpeak — 客觀對比"
  description="SpecScore 與 CodeSpeak 基於事實的逐項對比：規範即原始碼 vs 規範即契約、程式碼生成、可攜性、linting 和可追溯性。"
  canonical="https://specscore.md/zh-tw/vs/codespeak/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/zh-tw/vs/" class="xref">對比列表</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs CodeSpeak
        </h1>
        <p class="hero__sub">
          對於「規範應當用來做什麼」的兩種答案。CodeSpeak 把規範當作
          <strong>原始碼</strong>——由 LLM 編譯它，你維護規範而非程式碼。
          SpecScore 把規範當作一份<strong>持久、開放的契約</strong>——
          你保留你的程式碼，任何代理（或不用代理）都能讀取、lint 並追溯它。
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">兩者的共同點。</h2>
        <ul class="shared-list">
          <li>兩者都把規範置於軟體開發的中心。</li>
          <li>兩者都為 AI 輔助的世界而生——先有意圖，再有實現。</li>
          <li>兩者都致力於透過改變規範來讓軟體更易於變更。</li>
        </ul>
      </div>
    </section>

    {/* ── What CodeSpeak does well ── */}
    <section class="section" aria-labelledby="codespeak-title">
      <div class="section-inner section-inner--prose">
        <h2 id="codespeak-title" class="section-title">CodeSpeak 的優勢。</h2>
        <p class="section-note">
          <a href="https://codespeak.dev/" rel="nofollow noopener" target="_blank" class="xref">CodeSpeak</a>
          是一個由 LLM 驅動的程式設計系統，能把結構化英文規範編譯成程式碼。
        </p>

        <div class="credit-card">
          <h3 class="credit-card__title">大膽的論點，論證可信</h3>
          <p class="credit-card__desc">
            「維護規範，而非程式碼」是一次真正的重新定義，而非增量式的小修小補。
            它出自 Kotlin 語言的設計者，值得認真對待：如果規範才是原始碼，
            那麼產生的程式碼就成了一個實現細節。
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">程式碼到規範的接管</h3>
          <p class="credit-card__desc">
            <code>codespeak takeover</code> 讀取現有原始碼並產出一份
            捕捉其行為的規範——為存量程式碼提供低摩擦的入口匝道，
            據報導規範對程式碼的壓縮比約為 5–10×。
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">從代理對話中恢復意圖</h3>
          <p class="credit-card__desc">
            CodeSpeak 的 Intent Studio 從先前的代理對話中擷取需求——
            收穫你已經表達過的意圖，而不是讓你從一張白紙開始撰寫
            規範。
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">功能對比。</h2>
        <p class="section-note">
          兩者下的是不同的賭注，所以這張表對比的是理念與機制，而非勝負。
        </p>

        <div class="table-wrap">
          <table class="compare-table" aria-label="SpecScore 與 CodeSpeak 功能對比">
            <thead>
              <tr>
                <th scope="col">能力</th>
                <th scope="col">CodeSpeak</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>事實來源</td>
                <td>規範（編譯輸入）</td>
                <td><strong>規範是契約；程式碼是交付物</strong></td>
              </tr>
              <tr>
                <td>產生的程式碼</td>
                <td>由 LLM 產出，非手工維護</td>
                <td><strong>你和你的代理編寫並擁有程式碼</strong></td>
              </tr>
              <tr>
                <td>規範格式</td>
                <td>純英文，由 CodeSpeak 定義</td>
                <td><strong>開放的 Markdown + YAML 標準</strong>，已發布 schema</td>
              </tr>
              <tr>
                <td>規範 → 程式碼</td>
                <td>核心功能（專有 LLM 編譯器）</td>
                <td>不在範圍內 — 由任意代理實現</td>
              </tr>
              <tr>
                <td>脫離廠商仍可用</td>
                <td>規範需經 CodeSpeak 編譯</td>
                <td><strong>可以</strong> — 規範適用於任意代理，或不用代理</td>
              </tr>
              <tr>
                <td>規範 linting</td>
                <td>無文件說明</td>
                <td><strong>內容品質</strong> — 模糊動詞、缺失驗收標準、懸空引用</td>
              </tr>
              <tr>
                <td>程式碼到規範的可追溯性</td>
                <td>透過重新產生</td>
                <td><strong><code>specscore:</code> 註解</strong> + <code>Verifies:</code> 尾註</td>
              </tr>
              <tr>
                <td>確定性</td>
                <td>LLM 編譯（非確定性）</td>
                <td><strong>確定性的 CLI 查詢</strong>；程式碼照常編寫</td>
              </tr>
              <tr>
                <td>程式碼 → 規範</td>
                <td><strong><code>codespeak takeover</code></strong></td>
                <td><code>survey</code> + 撰寫</td>
              </tr>
              <tr>
                <td>開放性</td>
                <td>專有系統</td>
                <td><strong>開放</strong> — <a href="https://github.com/specscore/specscore/blob/main/LICENSE">CC BY 4.0</a> 格式，MIT / <a href="https://github.com/specscore/specscore-cli/blob/main/LICENSE">Apache-2.0</a> 工具</td>
              </tr>
              <tr>
                <td>階段</td>
                <td>Alpha 預覽</td>
                <td>已發布</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore differs ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">SpecScore 的不同之處。</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">你保留你的程式碼</h3>
            <p class="diff-card__desc">
              CodeSpeak 產生並重新產生實現；程式碼是一種輸出，而非一項資產。
              SpecScore 把程式碼留在它該在的地方——在你手中、用你的語言、
              可逐行審查。規範在不帶走程式碼的前提下，增添清晰度
              和可追溯性。
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">你的規範是可攜的</h3>
            <p class="diff-card__desc">
              一份 CodeSpeak 規範之所以有價值，是因為 CodeSpeak 編譯它。一份 SpecScore
              規範本身就有價值——它是結構良好的 Markdown，任何
              代理都能讀取，而且即便完全沒有安裝任何 SpecScore 工具，它依然有用。
              用任意工具採用它，或不用工具。隨時離開。
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">歧義在產生代價之前被捕捉</h3>
            <p class="diff-card__desc">
              使用 LLM 編譯器時，一份有歧義的規範會在構建時變成錯誤的程式碼。
              SpecScore 的 <code>lint</code> 會<em>在</em>代理據此行動<em>之前</em>，
              浮現出模糊動詞、缺失的驗收標準和懸空引用。
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> verb  <span class="dim">"handle gracefully" — unmeasurable</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">確定性與可追溯性</h3>
            <p class="diff-card__desc">
              CodeSpeak 對「哪些程式碼實現了這個？」的回答是「全部，重新產生」。
              SpecScore 的回答是一個具體的檔案和行號，透過
              <code>specscore code refs</code> 和 <code>Verifies:</code> 提交
              尾註——確定性、可稽核、可 diff。
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">結構化的產物圖譜</h3>
            <p class="diff-card__desc">
              CodeSpeak 的單元是一份散文形式的規範檔案。SpecScore 擁有具型別的
              階層結構——Idea 晉升為 Feature，Feature 攜帶帶 ID 的 Requirement 和
              Acceptance Criteria，Plan 引用 AC，Task 引用 Plan——
              所有這些都可機器導覽。
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">構建路徑中沒有廠商</h3>
            <p class="diff-card__desc">
              SpecScore 是單一 Go 二進位檔案。Lint 在 CI 和 pre-commit 鉤子中執行，
              無需帳號、無需服務呼叫、構建中沒有 LLM 往返。
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">何時使用哪一個。</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">以下場景適合使用 CodeSpeak……</h3>
            <ul class="when-card__list">
              <li>你想停止維護程式碼，讓規範成為原始碼。</li>
              <li>你樂於為那份槓桿而依賴某廠商的編譯器。</li>
              <li>你想把一個現有程式碼庫壓縮成一份短得多的規範。</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">以下場景適合使用 SpecScore……</h3>
            <ul class="when-card__list">
              <li>你想要比任何單一工具都更長久的規範——在構造上即可攜。</li>
              <li>你想保留你的程式碼，用你的語言，可審查、可擁有。</li>
              <li>你需要規範品質的強制執行——lint 儘早捕捉歧義。</li>
              <li>你需要確定性的程式碼到規範可追溯性。</li>
              <li>你想要構建路徑中沒有廠商、沒有 LLM 往返。</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── Two different bets ── */}
    <section class="section" aria-labelledby="bets-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bets-title" class="section-title">兩種不同的賭注。</h2>
        <p class="prose-p">
          CodeSpeak 押注於編譯器：把規範交給它，並信任它產出
          並重現程式碼。SpecScore 押注於格式：讓規範保持開放
          且可攜，讓程式碼歸你所有，並讓任何代理基於它工作。
        </p>
        <p class="prose-p">
          一方以可攜性換取槓桿。另一方讓你保持自由——而且可 lint。
        </p>
      </div>
    </section>

    <MoreComparisons />
    <ComparisonFeedback page="codespeak" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">通過檢查的規範。</h2>
      <div class="final-cta__buttons">
        <a href="/zh-tw/cli/install/" class="btn btn--primary">安裝 CLI</a>
        <a href="/zh-tw/ai/specstudio-skills/" class="btn btn--secondary">取得 AI 代理技能</a>
        <a
          href="https://github.com/specscore/specscore"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          在 GitHub 上開源
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterZhTw />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__breadcrumb {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Shared list ── */
  .shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shared-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }
  .shared-list li::before {
    content: '=';
    position: absolute;
    left: 0;
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pale-ink);
  }

  /* ── Section note ── */
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }

  /* ── Credit cards ── */
  .credit-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .credit-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .credit-card__desc {
    color: var(--mid-ink);
    line-height: 1.6;
    font-size: var(--fs-body);
  }
  .credit-card__desc code {
    font-size: 0.9em;
    background: var(--cream);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Feature comparison table ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .compare-table td:nth-child(2),
  .compare-table td:nth-child(3) {
    min-width: 200px;
  }
  .compare-table td code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .compare-table strong {
    font-weight: 600;
    color: var(--ink);
  }

  /* ── Diff grid ── */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .diff-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .diff-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .diff-card__desc {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .diff-card__desc code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .diff-card__example {
    margin-top: var(--space-2);
  }
  .diff-card__example .terminal {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .diff-grid { grid-template-columns: 1fr; }
  }

  /* ── When to use which ── */
  .when-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .when-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .when-card--primary {
    border-color: var(--validator-green);
    border-width: 2px;
  }
  .when-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .when-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .when-card__list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
    font-size: var(--fs-small);
  }
  .when-card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--pale-ink);
    font-family: var(--font-code);
  }
  .when-card--primary .when-card__list li::before {
    color: var(--validator-green);
  }
  .when-card__list code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; }
  }

  /* ── Bets section ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-2);
