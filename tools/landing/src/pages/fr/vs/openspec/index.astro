---
// /fr/vs/openspec/ — SpecScore vs OpenSpec comparison (French).
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterFr from '../../../../components/SiteFooterFr.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="fr"
  title="SpecScore vs OpenSpec — Comparatif honnête."
  description="Une comparaison objective et côte à côte de SpecScore et OpenSpec : format de spécification, linting, cycle de vie, traçabilité, CLI et support des agents. Honnête pour les deux."
  canonical="https://specscore.md/fr/vs/openspec/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/fr/vs/" class="xref">Comparaisons</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs OpenSpec
        </h1>
        <p class="hero__sub">
          Tous deux placent les spécifications en Markdown, aux côtés de votre code, lisibles par les agents d'IA. Ils répondent à des problématiques différentes : OpenSpec organise les spécifications et génère des commandes pour les agents. SpecScore valide le contenu des spécifications, applique le cycle de vie et relie le code aux exigences.
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Ce qu'ils ont en commun.</h2>
        <ul class="shared-list">
          <li>Les spécifications vivent dans votre dépôt sous forme de fichiers Markdown — versionnées, révisables dans les PRs.</li>
          <li>Tous deux sont open source sous licence MIT.</li>
          <li>Tous deux emploient des critères d'acceptation Given/When/Then.</li>
          <li>Tous deux traitent les agents d'IA comme des consommateurs de premier ordre des spécifications.</li>
        </ul>
      </div>
    </section>

    {/* ── What OpenSpec does well ── */}
    <section class="section" aria-labelledby="openspec-title">
      <div class="section-inner section-inner--prose">
        <h2 id="openspec-title" class="section-title">Ce qu'OpenSpec fait bien.</h2>

        <div class="credit-card">
          <h3 class="credit-card__title">Le support d'agents le plus large</h3>
          <p class="credit-card__desc">
            OpenSpec prend en charge 29 agents d'IA via des fichiers de skills générés — Claude, Cursor, Copilot, Gemini, Windsurf, Cline et bien d'autres. Si votre agent figure sur la liste, OpenSpec s'intègre immédiatement sans configuration.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Faible barrière à l'entrée</h3>
          <p class="credit-card__desc">
            <code>npm install -g @fission-ai/openspec &amp;&amp; openspec init</code> et vous rédigez déjà des spécifications. Aucun schéma à assimiler, aucun frontmatter obligatoire. Conçu pour être simple — particulièrement pour les projets existants.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Modèle propre de deltas de modifications</h3>
          <p class="credit-card__desc">
            Le format <code>ADDED / MODIFIED / REMOVED</code> d'OpenSpec pour faire évoluer les spécifications est bien conçu. Chaque modification est un dossier contenant une proposition, des deltas de spécification et des tâches — une approche structurée pour proposer des changements.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Comparaison des fonctionnalités.</h2>

        <div class="table-wrap">
          <table class="compare-table" aria-label="Comparaison des fonctionnalités SpecScore vs OpenSpec">
            <thead>
              <tr>
                <th scope="col">Capacité</th>
                <th scope="col">OpenSpec</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Format de spécification</td>
                <td>Markdown (sans frontmatter)</td>
                <td>Markdown + YAML frontmatter</td>
              </tr>
              <tr>
                <td>Linting de spécification</td>
                <td>Structure des fichiers uniquement</td>
                <td><strong>Qualité du contenu</strong> — verbes flous, AC manquants, références orphelines</td>
              </tr>
              <tr>
                <td>IDs d'exigences</td>
                <td>Aucun (référencés par titre)</td>
                <td><strong>Basés sur slug</strong> (<code>REQ: slug-format</code>)</td>
              </tr>
              <tr>
                <td>IDs de critères d'acceptation</td>
                <td>Aucun</td>
                <td><strong>IDs adressables par machine</strong></td>
              </tr>
              <tr>
                <td>État du cycle de vie</td>
                <td>Implicite (emplacement du fichier)</td>
                <td><strong>Appliqué</strong> — Draft → Under Review → Approved → Implementing → Stable → Deprecated</td>
              </tr>
              <tr>
                <td>Traçabilité code-vers-spécification</td>
                <td>Aucune</td>
                <td><strong>Annotations <code>specscore:</code></strong> + trailers de commit <code>Verifies:</code></td>
              </tr>
              <tr>
                <td>Sous-features</td>
                <td>Non</td>
                <td><strong>Oui</strong> (répertoires imbriqués)</td>
              </tr>
              <tr>
                <td>Références croisées</td>
                <td>Sans mécanisme formel</td>
                <td><strong>Dépendances, Ideas d'origine, références aux plans</strong></td>
              </tr>
              <tr>
                <td>Intégration CI</td>
                <td>Basique (<code>openspec validate</code>)</td>
                <td><strong><code>specscore lint</code></strong> avec sévérité configurable, hooks pre-commit</td>
              </tr>
              <tr>
                <td>Support des agents</td>
                <td><strong>29 agents</strong></td>
                <td>Claude Code comme cible principale + CLI pour tout agent</td>
              </tr>
              <tr>
                <td>Personnalisation du schéma</td>
                <td><strong>Oui</strong> (<code>schema.yaml</code>, fork/init)</td>
                <td>Schéma fixe (cohérence dès la conception)</td>
              </tr>
              <tr>
                <td>Propositions de changement</td>
                <td><strong>Modèle delta</strong> (ADDED/MODIFIED/REMOVED)</td>
                <td>Ideas de changement + propositions</td>
              </tr>
              <tr>
                <td>Dépendance de runtime</td>
                <td>Node.js 20.19+</td>
                <td><strong>Aucune</strong> — binaire Go unique</td>
              </tr>
              <tr>
                <td>Licence</td>
                <td>MIT</td>
                <td>MIT</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore goes further ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">Où SpecScore va plus loin.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">La validation dépasse la simple structure de fichiers</h3>
            <p class="diff-card__desc">
              La commande <code>validate</code> d'OpenSpec vérifie la structure
              des fichiers — si le fichier existe, s'il a les bonnes sections.
              SpecScore vérifie plus, en deux couches : <code>lint</code> vérifie
              de manière déterministe les relations de contenu — chaque exigence
              a des critères d'acceptation, les références croisées sont
              résolues, les transitions d'état sont valides — et un réviseur par
              IA (<code>/review</code>, <code>/score</code>) détecte ce qu'aucun
              linter ne peut voir : critères ambigus et verbes flous.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> link  <span class="dim">"Related Feature: discount-tiers" not found</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Chaque exigence a un ID lisible par machine</h3>
            <p class="diff-card__desc">
              OpenSpec référence les exigences par leur titre — fragile face aux renommages. SpecScore attribue des IDs basés sur le slug (<code>REQ: slug-format</code>) et des IDs d'AC qui résistent aux renommages, refactorisations et passages de relais entre agents.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Le cycle de vie est appliqué, non déduit</h3>
            <p class="diff-card__desc">
              Dans OpenSpec, le cycle de vie d'une spécification se résume à son emplacement : <code>specs/</code> (actuel), <code>changes/</code> (proposé), <code>archive/</code> (terminé). Dans SpecScore, le cycle de vie est un champ d'état appliqué — Draft → Under Review → Approved → Implementing → Stable → Deprecated — validé par le lint, transité via <code>specscore change-status</code> depuis les git hooks ou la CI.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Le code remonte jusqu'aux spécifications</h3>
            <p class="diff-card__desc">
              OpenSpec n'a aucun mécanisme de traçabilité. SpecScore propose des annotations <code>specscore:</code> dans les commentaires du code et des trailers <code>Verifies:</code> dans les commits. Exécutez <code>specscore code refs</code> et obtenez une réponse déterministe à « quel code implémente cette exigence ? »
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Aucune dépendance de runtime</h3>
            <p class="diff-card__desc">
              OpenSpec nécessite Node.js 20.19+. SpecScore est un binaire Go unique — sans runtime, sans <code>node_modules</code>. Fonctionne dans les projets Go, Rust, Python, Java sans ajouter Node à votre chaîne d'outils.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Hiérarchie d'artefacts composable</h3>
            <p class="diff-card__desc">
              Les spécifications d'OpenSpec sont plates par domaine. SpecScore propose une hiérarchie typée : les Ideas se promeuvent en Features, les Features contiennent des exigences et des AC, les Plans référencent les AC, les Tasks référencent les Plans. Toutes les relations sont navigables par machine via le CLI.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Quand utiliser chacun.</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Commencez avec OpenSpec quand…</h3>
            <ul class="when-card__list">
              <li>Vous utilisez Cursor, Copilot ou d'autres agents hors-Claude et souhaitez une intégration prête à l'emploi.</li>
              <li>Vous introduisez des spécifications dans un codebase existant pour la première fois et voulez zéro friction.</li>
              <li>Votre équipe privilégie la flexibilité de schéma par rapport à une rigueur stricte.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Utilisez SpecScore quand…</h3>
            <ul class="when-card__list">
              <li>Vous avez besoin d'un contrôle qualité des spécifications — le lint détecte les ambiguïtés avant que les agents ne gaspillent des tokens.</li>
              <li>Vous avez besoin de traçabilité code-vers-spécification — « quel code implémente cette exigence ? » renvoie une réponse déterministe.</li>
              <li>Vous construisez un vaste système avec de nombreuses features, sous-features et transitions de cycle de vie.</li>
              <li>Vous voulez zéro dépendance de runtime — un binaire unique, sans Node.js requis.</li>
              <li>Vous avez besoin de barrières de qualité en CI — <code>specscore lint</code> quitte avec un code non nul en cas d'échec, tout comme ESLint ou <code>go vet</code>.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── The integration opportunity ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">Ils ne s'excluent pas mutuellement.</h2>
        <p class="prose-p">
          SpecScore peut linter les fichiers <code>spec.md</code> d'OpenSpec. Les équipes qui démarrent avec OpenSpec peuvent ajouter la couche de qualité de SpecScore sans migrer — validez les spécifications que vous avez déjà, ajoutez la traçabilité quand vous en avez besoin, appliquez le cycle de vie quand votre équipe grandit.
        </p>
        <p class="prose-p">
          OpenSpec est une bonne rampe de lancement. SpecScore apporte les garde-fous.
        </p>
      </div>
    </section>

    <ComparisonFeedback page="openspec" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Des specs qui passent.</h2>
      <div class="final-cta__buttons">
        <a href="/fr/cli/install/" class="btn btn--primary">Installer le CLI</a>
        <a href="/fr/ai/specstudio-skills/" class="btn btn--secondary">Obtenir des skills IA pour votre agent</a>
        <a href="https://github.com/specscore/specscore" rel="noopener" class="btn btn--tertiary">
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" /></svg>
          Open source sur GitHub
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterFr />
</BaseLayout>

<style>
  .hero { padding: var(--space-6) var(--space-3) var(--space-5); background: var(--cream); }
  .hero__inner { max-width: var(--max-prose); margin: 0 auto; animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms; }
  .hero__breadcrumb { font-family: var(--font-code); font-size: var(--fs-small); color: var(--pale-ink); margin-bottom: var(--space-2); }
  .hero__headline { font-size: var(--fs-hero); font-weight: 700; line-height: 1.04; letter-spacing: -0.02em; margin-bottom: var(--space-3); }
  .hero__sub { font-size: 1.125rem; color: var(--mid-ink); line-height: 1.55; max-width: 52ch; }
  @keyframes fade-in { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
  .section-title { font-size: var(--fs-h2); font-weight: 700; letter-spacing: -0.01em; margin-bottom: var(--space-3); }
  .shared-list { list-style: none; margin: 0; padding: 0; }
  .shared-list li { position: relative; padding-left: 1.4rem; color: var(--mid-ink); line-height: 1.6; margin-bottom: var(--space-1); }
  .shared-list li::before { content: '='; position: absolute; left: 0; font-family: var(--font-code); font-weight: 700; color: var(--pale-ink); }
  .credit-card { background: var(--surface); border: 1px solid var(--hairline); padding: var(--space-3); margin-bottom: var(--space-2); }
  .credit-card__title { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-1); }
  .credit-card__desc { color: var(--mid-ink); line-height: 1.6; font-size: var(--fs-body); }
  .credit-card__desc code { font-size: 0.9em; background: var(--cream); padding: 0.05em 0.3em; border-radius: 2px; }
  .table-section { background: var(--cream-2); }
  .table-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .compare-table { width: 100%; border-collapse: collapse; font-size: var(--fs-small); line-height: 1.5; }
  .compare-table th, .compare-table td { text-align: left; padding: 0.65rem 0.85rem; border-bottom: 1px solid var(--hairline); vertical-align: top; }
  .compare-table thead th { font-family: var(--font-display); font-weight: 600; font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--mid-ink); border-bottom: 2px solid var(--graphite); white-space: nowrap; }
  .compare-table td:first-child { font-weight: 500; white-space: nowrap; min-width: 160px; }
  .compare-table td:nth-child(2), .compare-table td:nth-child(3) { min-width: 200px; }
  .compare-table td code { font-size: 0.88em; background: var(--surface); padding: 0.05em 0.3em; border-radius: 2px; }
  .compare-table strong { font-weight: 600; color: var(--ink); }
  .diff-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
  .diff-card { background: var(--surface); border: 1px solid var(--hairline); padding: var(--space-3); }
  .diff-card__title { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-1); }
  .diff-card__desc { color: var(--mid-ink); font-size: var(--fs-small); line-height: 1.6; }
  .diff-card__desc code { font-size: 0.9em; background: var(--cream-2); padding: 0.05em 0.3em; border-radius: 2px; }
  .diff-card__example { margin-top: var(--space-2); }
  .diff-card__example .terminal { font-size: 0.78rem; line-height: 1.6; }
  @media (max-width: 860px) { .diff-grid { grid-template-columns: 1fr; } }
  .when-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--space-3); }
  .when-card { background: var(--surface); border: 1px solid var(--hairline); padding: var(--space-4); }
  .when-card--primary { border-color: var(--validator-green); border-width: 2px; }
  .when-card__title { font-family: var(--font-display); font-size: var(--fs-h3); font-weight: 600; margin-bottom: var(--space-2); }
  .when-card__list { list-style: none; margin: 0; padding: 0; }
  .when-card__list li { position: relative; padding-left: 1.2rem; color: var(--mid-ink); line-height: 1.6; margin-bottom: var(--space-1); font-size: var(--fs-small); }
  .when-card__list li::before { content: '→'; position: absolute; left: 0; color: var(--pale-ink); font-family: var(--font-code); }
  .when-card--primary .when-card__list li::before { color: var(--validator-green); }
  .when-card__list code { font-size: 0.9em; background: var(--cream-2); padding: 0.05em 0.3em; border-radius: 2px; }
  @media (max-width: 860px) { .when-grid { grid-template-columns: 1fr; } }
  .prose-p { color: var(--mid-ink); line-height: 1.65; margin-bottom: var(--space-2); }
  .prose-p:last-child { margin-bottom: 0; font-weight: 500; color: var(--ink); }
  .prose-p code { font-size: 0.9em; background: var(--cream-2); padding: 0.05em 0.3em; border-radius: 2px; }
  .final-cta { background: var(--cream-2); padding: var(--space-7) var(--space-3); border-top: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .final-cta__inner { max-width: var(--max-content); margin: 0 auto; text-align: center; }
  .final-cta__title { font-size: clamp(2.2rem, 4.2vw, 3.2rem); margin-bottom: var(--space-4); letter-spacing: -0.02em; line-height: 1.05; }
  .final-cta__buttons { display: inline-flex; flex-wrap: wrap; gap: 0.75rem; justify-content: center; }
</style>
