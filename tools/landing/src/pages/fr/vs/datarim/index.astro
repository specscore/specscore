---
// /fr/vs/datarim/ — Comparaison SpecScore vs Datarim.
// Datarim est un pack de flux de travail pour Claude Code ; SpecScore est le format ouvert
// qu'un flux de travail peut cibler. Pas d'attaque publique — deux packs, un format ouvert.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterFr from '../../../../components/SiteFooterFr.astro';
import ComparisonFeedback from '../../../../components/ComparisonFeedback.astro';
---

<BaseLayout
  lang="fr"
  title="SpecScore vs Datarim — Comparaison honnête."
  description="Une comparaison objective de SpecScore et Datarim : un pack de flux de travail pour Claude Code vs un format de spécification ouvert et portable. Des couches distinctes — qui peuvent se composer."
  canonical="https://specscore.md/fr/vs/datarim/"
>
  <SiteHeader />

  <main>
    {/* ── Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <p class="hero__breadcrumb"><a href="/fr/vs/" class="xref">Comparaisons</a></p>
        <h1 id="hero-title" class="hero__headline">
          SpecScore vs Datarim
        </h1>
        <p class="hero__sub">
          Des couches distinctes. Datarim est un <strong>pack de flux de travail</strong> affirmé pour
          Claude Code — des commandes slash qui mènent un projet de l'expression des besoins à sa
          réalisation. SpecScore est le <strong>format ouvert</strong> dans lequel les spécifications sont rédigées,
          assorti d'un CLI pour les linter, les interroger et les tracer. Un flux de travail peut le cibler.
        </p>
      </div>
    </section>

    {/* ── What they share ── */}
    <section class="section" aria-labelledby="shared-title">
      <div class="section-inner section-inner--prose">
        <h2 id="shared-title" class="section-title">Ce qu'ils partagent.</h2>
        <ul class="shared-list">
          <li>Tous deux apportent une méthodologie structurée au développement assisté par IA.</li>
          <li>Tous deux sont open source sous licence MIT.</li>
          <li>Tous deux s'exécutent au sein de Claude Code — Datarim sous forme de commandes, SpecScore via les SpecStudio Skills.</li>
          <li>Tous deux conservent leur état en Markdown dans le dépôt, avec suivi de versions.</li>
        </ul>
      </div>
    </section>

    {/* ── What Datarim does well ── */}
    <section class="section" aria-labelledby="datarim-title">
      <div class="section-inner section-inner--prose">
        <h2 id="datarim-title" class="section-title">Ce que Datarim fait bien.</h2>
        <p class="section-note">
          <a href="https://github.com/Arcanada-one/datarim" rel="nofollow noopener" target="_blank" class="xref">Datarim</a>
          est un framework universel de flux de travail itératif conçu pour Claude Code.
        </p>

        <div class="credit-card">
          <h3 class="credit-card__title">UX native de commandes slash</h3>
          <p class="credit-card__desc">
            Un pipeline complet sous forme de commandes — <code>/dr-prd</code>, <code>/dr-plan</code>,
            <code>/dr-design</code>, <code>/dr-do</code>, <code>/dr-qa</code> — parfaitement intégrées
            à Claude Code. Un simple <code>install.sh</code> vers <code>~/.claude/</code>
            et vous êtes opérationnel.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Routage conscient de la complexité (L1–L4)</h3>
          <p class="credit-card__desc">
            Datarim évalue la charge de travail et route en conséquence : un correctif rapide L1 fait l'impasse sur
            la planification, tandis qu'un changement majeur L4 déclenche un pipeline par phases avec plusieurs
            cycles de révision. Adapter le formalisme à l'envergure est une excellente idée.
          </p>
        </div>

        <div class="credit-card">
          <h3 class="credit-card__title">Consilium et portée pluridisciplinaire</h3>
          <p class="credit-card__desc">
            Son « consilium » réunit un panel d'agents pour débattre des compromis avant de
            recommander une décision. Et cela ne concerne pas uniquement le logiciel — Datarim s'adresse également
            aux flux de travail de recherche, juridiques et éditoriaux.
          </p>
        </div>
      </div>
    </section>

    {/* ── Feature comparison table ── */}
    <section class="section table-section" aria-labelledby="table-title">
      <div class="section-inner">
        <h2 id="table-title" class="section-title">Comparaison des fonctionnalités.</h2>
        <p class="section-note">
          L'un est un flux de travail, l'autre un format — le tableau compare des rôles, pas des vainqueurs.
        </p>

        <div class="table-wrap">
          <table class="compare-table" aria-label="Comparaison des fonctionnalités SpecScore vs Datarim">
            <thead>
              <tr>
                <th scope="col">Capacité</th>
                <th scope="col">Datarim</th>
                <th scope="col">SpecScore</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Rôle principal</td>
                <td>Pack de flux de travail pour Claude Code</td>
                <td><strong>Format de spécification ouvert + CLI</strong></td>
              </tr>
              <tr>
                <td>S'exécute comme</td>
                <td>Commandes slash (<code>/dr-*</code>)</td>
                <td>Fichiers de format + CLI <span class="dim">(+ SpecStudio Skills dans Claude Code)</span></td>
              </tr>
              <tr>
                <td>Stockage de l'état</td>
                <td><code>backlog.md</code> + <code>CLAUDE.md</code> (format propre au flux)</td>
                <td><strong>Arborescence <code>spec/</code> portable</strong> (Markdown + YAML)</td>
              </tr>
              <tr>
                <td>Survit sans l'outil</td>
                <td>Lié au runtime Datarim</td>
                <td><strong>Oui</strong> — portable par conception</td>
              </tr>
              <tr>
                <td>Linting de spécifications</td>
                <td>Aucun</td>
                <td><strong>Qualité de contenu</strong> — verbes vagues, ACs manquants, références orphelines</td>
              </tr>
              <tr>
                <td>IDs d'exigences / ACs</td>
                <td>Aucun</td>
                <td><strong>IDs adressables par machine</strong> (<code>REQ: slug</code>)</td>
              </tr>
              <tr>
                <td>Traçabilité code-vers-spécification</td>
                <td>Aucune</td>
                <td><strong>Annotations <code>specscore:</code></strong> + remorques <code>Verifies:</code></td>
              </tr>
              <tr>
                <td>Routage par complexité (L1–L4)</td>
                <td><strong>Oui</strong></td>
                <td>Non (format, pas flux de travail)</td>
              </tr>
              <tr>
                <td>Graphe de spécifications interrogeable</td>
                <td>Non</td>
                <td><strong>Oui</strong> — <code>feature list / show / deps</code></td>
              </tr>
              <tr>
                <td>Lié à Claude Code</td>
                <td>Conçu pour lui</td>
                <td><strong>Non</strong> — tout agent, ou aucun</td>
              </tr>
              <tr>
                <td>Licence</td>
                <td>MIT</td>
                <td>MIT / CC BY 4.0</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    {/* ── Where SpecScore goes further ── */}
    <section class="section" aria-labelledby="further-title">
      <div class="section-inner">
        <h2 id="further-title" class="section-title">Ce que SpecScore apporte en plus.</h2>

        <div class="diff-grid">
          <div class="diff-card">
            <h3 class="diff-card__title">La sortie survit au flux de travail</h3>
            <p class="diff-card__desc">
              L'état de Datarim vit dans son propre backlog et sa structure de <code>CLAUDE.md</code> —
              utile tant que vous utilisez Datarim. Les spécifications SpecScore reposent sur un format portable qui
              reste lisible, vérifiable et interrogeable sans aucun outil SpecScore installé.
              Le flux de travail peut évoluer ; les spécifications vous accompagnent.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Les spécifications sont vérifiables par linter</h3>
            <p class="diff-card__desc">
              Un flux de travail guide la rédaction, mais ne contrôle pas le résultat. Le
              <code>lint</code> de SpecScore vérifie que chaque exigence comporte des critères d'acceptation,
              que les références croisées se résolvent et que les transitions d'état sont valides.
            </p>
            <div class="diff-card__example">
<pre class="terminal"><span class="prompt">$</span> specscore lint checkout/apply-discount.md
  <span class="mark-fail">✗</span> R3  no acceptance criteria
  <span class="mark-fail">✗</span> link  <span class="dim">"Related Feature: discount-tiers" not found</span></pre>
            </div>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Le code remonte jusqu'aux spécifications</h3>
            <p class="diff-card__desc">
              SpecScore ajoute les annotations source <code>specscore:</code> et les
              remorques de commit <code>Verifies:</code> — <code>specscore code refs</code>
              répond déterministement à la question « quel code implémente cette exigence ? »,
              quel que soit le flux de travail ayant produit la spécification.
            </p>
          </div>

          <div class="diff-card">
            <h3 class="diff-card__title">Aucune dépendance envers un seul agent</h3>
            <p class="diff-card__desc">
              Datarim est taillé pour Claude Code. SpecScore est un format que n'importe quel agent peut interpréter,
              et un binaire Go unique que n'importe quelle CI peut exécuter — aucun Claude Code ni
              installation dans <code>~/.claude/</code> requis.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── When to use which ── */}
    <section class="section" aria-labelledby="when-title">
      <div class="section-inner">
        <h2 id="when-title" class="section-title">Quand choisir l'un ou l'autre.</h2>

        <div class="when-grid">
          <div class="when-card">
            <h3 class="when-card__title">Tournez-vous vers Datarim quand…</h3>
            <ul class="when-card__list">
              <li>Vous voulez un pipeline complet et affirmé dès aujourd'hui dans Claude Code.</li>
              <li>Vous appréciez le routage selon la complexité et les rituels de décision multi-agents.</li>
              <li>Vos projets couvrent plusieurs domaines — recherche, juridique, contenu, pas seulement le code.</li>
            </ul>
          </div>

          <div class="when-card when-card--primary">
            <h3 class="when-card__title">Utilisez SpecScore quand…</h3>
            <ul class="when-card__list">
              <li>Vous voulez des spécifications qui survivent à n'importe quel outil ou flux de travail particulier.</li>
              <li>Vous avez besoin du linting, d'IDs stables, du suivi de cycle de vie et d'une traçabilité code-vers-spécification.</li>
              <li>Vous collaborez avec plusieurs agents — ou aucun — et pas seulement Claude Code.</li>
              <li>Vous cherchez un CLI que les agents peuvent interroger plutôt que de relire tout le dépôt.</li>
              <li>Vous voulez des barrières de qualité de spécifications en CI qui échouent avec un code non nul.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {/* ── Two packs, one format ── */}
    <section class="section" aria-labelledby="bridge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="bridge-title" class="section-title">Deux packs de flux de travail, un format ouvert.</h2>
        <p class="prose-p">
          Datarim et SpecStudio Skills sont deux packs de flux de travail affirmés au-dessus de Claude
          Code. SpecScore constitue le format ouvert sous-jacent — l'artefact qu'un flux de travail peut
          produire afin que les spécifications restent portables, lintables et traçables une fois le pipeline
          terminé. Une version de Datarim émettant du SpecScore conserverait toute son UX tout en bénéficiant d'une sortie pérenne.
        </p>
        <p class="prose-p">
          Choisissez Datarim pour le pipeline. Utilisez SpecScore pour l'artefact qu'il laisse derrière lui.
        </p>
      </div>
    </section>

    <ComparisonFeedback page="datarim" />
  </main>

  {/* ── Final CTA ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Des specs qui passent.</h2>
      <div class="final-cta__buttons">
        <a href="/fr/cli/install/" class="btn btn--primary">Installer le CLI</a>
        <a href="/fr/ai/specstudio-skills/" class="btn btn--secondary">Obtenir les skills IA pour votre agent</a>
        <a
          href="https://github.com/specscore/specscore"
          rel="noopener"
          class="btn btn--tertiary"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-2.16c-3.2.7-3.87-1.36-3.87-1.36-.52-1.34-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.37.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.51-1.46.11-3.05 0 0 .97-.31 3.18 1.18.92-.26 1.91-.39 2.89-.39.98 0 1.97.13 2.89.39 2.21-1.49 3.18-1.18 3.18-1.18.62 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.07.78 2.15v3.19c0 .31.21.67.8.55C20.71 21.39 24 17.08 24 12 24 5.65 18.85.5 12 .5z" />
          </svg>
          Open source sur GitHub
        </a>
      </div>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterFr />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-6) var(--space-3) var(--space-5);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__breadcrumb {
    font-family: var(--font-code);
    font-size: var(--fs-small);
    color: var(--pale-ink);
    margin-bottom: var(--space-2);
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    line-height: 1.55;
    max-width: 52ch;
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Section titles ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }

  /* ── Shared list ── */
  .shared-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .shared-list li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
  }
  .shared-list li::before {
    content: '=';
    position: absolute;
    left: 0;
    font-family: var(--font-code);
    font-weight: 700;
    color: var(--pale-ink);
  }

  /* ── Section note ── */
  .section-note {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    margin-bottom: var(--space-3);
  }

  /* ── Credit cards ── */
  .credit-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
    margin-bottom: var(--space-2);
  }
  .credit-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .credit-card__desc {
    color: var(--mid-ink);
    line-height: 1.6;
    font-size: var(--fs-body);
  }
  .credit-card__desc code {
    font-size: 0.9em;
    background: var(--cream);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Feature comparison table ── */
  .table-section { background: var(--cream-2); }
  .table-wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--fs-small);
    line-height: 1.5;
  }
  .compare-table th,
  .compare-table td {
    text-align: left;
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--hairline);
    vertical-align: top;
  }
  .compare-table thead th {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--mid-ink);
    border-bottom: 2px solid var(--graphite);
    white-space: nowrap;
  }
  .compare-table td:first-child {
    font-weight: 500;
    white-space: nowrap;
    min-width: 160px;
  }
  .compare-table td:nth-child(2),
  .compare-table td:nth-child(3) {
    min-width: 200px;
  }
  .compare-table td code {
    font-size: 0.88em;
    background: var(--surface);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .compare-table strong {
    font-weight: 600;
    color: var(--ink);
  }
  .compare-table .dim {
    color: var(--pale-ink);
  }

  /* ── Diff grid ── */
  .diff-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .diff-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-3);
  }
  .diff-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }
  .diff-card__desc {
    color: var(--mid-ink);
    font-size: var(--fs-small);
    line-height: 1.6;
  }
  .diff-card__desc code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }
  .diff-card__example {
    margin-top: var(--space-2);
  }
  .diff-card__example .terminal {
    font-size: 0.78rem;
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .diff-grid { grid-template-columns: 1fr; }
  }

  /* ── When to use which ── */
  .when-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-3);
  }
  .when-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .when-card--primary {
    border-color: var(--validator-green);
    border-width: 2px;
  }
  .when-card__title {
    font-family: var(--font-display);
    font-size: var(--fs-h3);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .when-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .when-card__list li {
    position: relative;
    padding-left: 1.2rem;
    color: var(--mid-ink);
    line-height: 1.6;
    margin-bottom: var(--space-1);
    font-size: var(--fs-small);
  }
  .when-card__list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--pale-ink);
    font-family: var(--font-code);
  }
  .when-card--primary .when-card__list li::before {
    color: var(--validator-green);
  }
  .when-card__list code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  @media (max-width: 860px) {
    .when-grid { grid-template-columns: 1fr; }
  }

  /* ── Bridge section ── */
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-2);
  }
  .prose-p:last-child {
    margin-bottom: 0;
    font-weight: 500;
    color: var(--ink);
  }
  .prose-p code {
    font-size: 0.9em;
    background: var(--cream-2);
    padding: 0.05em 0.3em;
    border-radius: 2px;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--cream-2);
    padding: var(--space-7) var(--space-3);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .final-cta__inner {
    max-width: var(--max-content);
    margin: 0 auto;
    text-align: center;
  }
  .final-cta__title {
    font-size: clamp(2.2rem, 4.2vw, 3.2rem);
    margin-bottom: var(--space-4);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .final-cta__buttons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
  }
</style>
