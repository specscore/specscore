---
// SpecStudio Skills — landing page en français.
// Canonical campaign URL: specscore.md/fr/ai/specstudio-skills/
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../../components/SiteHeader.astro';
import SiteFooterFr from '../../../../components/SiteFooterFr.astro';
import QsTabsScript from '../../../../components/QsTabsScript.astro';
---

<BaseLayout
  lang="fr"
  title="SpecStudio Skills — Des specs que votre agent d'IA peut vraiment suivre."
  description="Plugin gratuit pour Claude Code qui transforme des prompts improvisés en spécifications structurées et notées que votre agent lit avant d'écrire la moindre ligne de code. Bâti sur le protocole ouvert SpecScore."
  canonical="https://specscore.md/fr/ai/specstudio-skills/"
>
  <SiteHeader />

  <main>
    {/* ── Section 1: Hero ── */}
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__inner">
        <h1 id="hero-title" class="hero__headline">
          Des specs que votre agent d'IA<br />peut vraiment suivre.
        </h1>
        <p class="hero__sub">
          SpecStudio Skills est un plugin gratuit pour Claude Code qui transforme des
          prompts improvisés en spécifications structurées et évaluées que votre agent
          lit avant d'écrire la moindre ligne de code. Bâti sur le protocole ouvert
          <a class="xref" href="/fr/">SpecScore</a>.
        </p>
        <div class="hero__install" id="install">
          <div class="qs-tabs" role="tablist" aria-label="Méthode d'installation">
            <button type="button" role="tab" id="qs-tab-claude" aria-controls="qs-panel-claude" aria-selected="true" tabindex="0" class="qs-tab is-active" data-tab="claude">Claude Code</button>
            <button type="button" role="tab" id="qs-tab-setup" aria-controls="qs-panel-setup" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="setup">Autres agents d'IA</button>
            <button type="button" role="tab" id="qs-tab-manual" aria-controls="qs-panel-manual" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="manual">Manuel</button>
          </div>

          <div id="qs-panel-claude" role="tabpanel" aria-labelledby="qs-tab-claude" class="qs-panel is-active" data-panel="claude">
<pre class="terminal"><span class="prompt">$</span> /plugin marketplace add specscore/ai-marketplace
<span class="prompt">$</span> /plugin install specstudio@specscore</pre>
          </div>
          <div id="qs-panel-setup" role="tabpanel" aria-labelledby="qs-tab-setup" class="qs-panel" data-panel="setup" hidden>
<pre class="terminal"><span class="prompt">$</span> specscore agent setup &lt;nom-de-l-agent&gt;</pre>
            <p class="qs-note">
              Écrit le bon fichier d'instructions pour votre agent —
              <code>claude</code>, <code>copilot</code>, <code>cursor</code>, <code>codex</code>,
              <code>antigravity.google</code>, <code>pi.dev</code> ou <code>opencode</code>.
              S'exécute dans un projet géré par SpecScore. Nécessite le
              <a class="xref" href="/fr/cli/">CLI SpecScore</a>.
            </p>
          </div>
          <div id="qs-panel-manual" role="tabpanel" aria-labelledby="qs-tab-manual" class="qs-panel" data-panel="manual" hidden>
<pre class="terminal"><span class="prompt">$</span> git clone https://github.com/specscore/specstudio-skills
<span class="prompt">$</span> cp -r specstudio-skills/commands /chemin/vers/votre/agent/commands/
<span class="prompt">$</span> cp -r specstudio-skills/skills /chemin/vers/votre/agent/skills/</pre>
            <p class="qs-note">
              Clonez le dépôt du plugin et copiez les répertoires
              <code>commands/</code> et <code>skills/</code> là où votre agent charge
              les fichiers de commandes et de skills.
            </p>
          </div>
        </div>
        <p class="hero__demo-link">
          <a href="#demo" class="xref">Voir la démo de 60 secondes ↓</a>
        </p>
      </div>
    </section>

    {/* ── Section 2: Demo ── */}
    <section class="section" id="demo" aria-labelledby="demo-title">
      <div class="section-inner">
        <h2 id="demo-title" class="section-title">
          D'une idée floue à une spécification évaluée, en 60 secondes.
        </h2>

        <div class="demo-placeholder">
          <div class="terminal-frame">
            <div class="terminal-frame__head">
              <span class="terminal-frame__title">Claude Code</span>
              <span class="terminal-frame__hint">demo</span>
            </div>
<pre class="terminal terminal-frame__body"><span class="prompt">&gt;</span> /specstudio:ideate A password reset flow for our SaaS app.

<span class="dim">Refining idea...</span>
<span class="dim">Producing spec/ideas/password-reset.md</span>

<span class="prompt">&gt;</span> /specstudio:specify spec/ideas/password-reset.md

<span class="dim">Writing Feature spec...</span>
<span class="dim">spec/features/password-reset/README.md</span>

<span class="prompt">$</span> specscore lint spec/features/password-reset/
<span class="mark-pass">PASS</span>  Feature: password-reset
  <span class="mark-pass">PASS</span>  has title, status, and description
  <span class="mark-pass">PASS</span>  requirements have acceptance criteria
  <span class="mark-pass">PASS</span>  all AC IDs are unique
  <span class="mark-pass">PASS</span>  no orphan cross-references

<span class="mark-pass">Score: 92 / 100</span></pre>
          </div>
          <p class="demo-caption">
            Sans montage. Sans coupure. Claude Code vierge → installer le plugin →
            évaluer une vraie spécification → votre agent construit la bonne chose.
          </p>
        </div>
      </div>
    </section>

    {/* ── Section 3: Le problème ── */}
    <section class="section" aria-labelledby="wedge-title">
      <div class="section-inner section-inner--prose">
        <h2 id="wedge-title" class="section-title">
          Pourquoi votre agent continue de construire la mauvaise chose.
        </h2>
        <p class="prose-p">
          Les prompts improvisés fonctionnent jusqu'au jour où ce n'est plus le cas. L'agent
          a construit la moitié de la fonctionnalité. Il a mal interprété l'exigence.
          Il a inventé un appel d'API. Il a choisi la mauvaise bibliothèque. Vous
          réécrivez le prompt. Vous le réécrivez encore. Au troisième essai,
          vous êtes déjà en train de rédiger la spécification complète à la main dans le chat.
        </p>
        <p class="prose-p">
          Le problème ne vient pas de l'agent. C'est que « construis-moi une fonctionnalité »
          n'est pas une spécification — c'est un vœu. Les agents sont stochastiques. Les vœux s'accommodent
          du stochastique. Pas les spécifications.
        </p>
        <p class="prose-p">
          SpecStudio Skills vous donne un workflow pour rédiger des spécifications que votre
          agent peut réellement interpréter : features structurées, exigences,
          critères d'acceptation, notés pour leur complétude avant même que l'agent
          ne commence à coder. La même rapidité que le vibe-coding, avec
          infiniment moins de dispersion dans le résultat.
        </p>
      </div>
    </section>

    {/* ── Section 4: Le pipeline ── */}
    <section class="section pipeline-section" aria-labelledby="pipeline-title">
      <div class="section-inner">
        <h2 id="pipeline-title" class="section-title">
          Quatre commandes. Un pipeline.
        </h2>
        <p class="pipeline-intro">
          Installez-le une fois, puis exécutez-les dans l'ordre — de l'idée brute au plan exécutable.
        </p>

        <div class="pipeline-grid">
          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/ideate</span>
            </div>
            <p class="pipeline-card__desc">
              Ajuste une idée brute par une réflexion divergente puis convergente
              structurée. Produit un one-pager pré-spécification analysable par linter.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/specify</span>
            </div>
            <p class="pipeline-card__desc">
              Convertit une idée approuvée en Feature SpecScore avec
              exigences, critères d'acceptation et blocs Given/When/Then.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/plan</span>
            </div>
            <p class="pipeline-card__desc">
              Décompose une feature en une liste ordonnée de tâches. Chaque tâche
              est associée à un ou plusieurs critères d'acceptation.
            </p>
          </div>

          <div class="pipeline-card">
            <div class="pipeline-card__head">
              <span class="pipeline-card__cmd">/implement</span>
            </div>
            <p class="pipeline-card__desc">
              Exécute la tâche suivante du plan. Un sous-agent par tâche,
              commits traçables jusqu'aux AC, diff prêt pour votre validation.
            </p>
          </div>
        </div>
      </div>
    </section>

    {/* ── Section 5: Ce qui est inclus ── */}
    <section class="section" aria-labelledby="box-title">
      <div class="section-inner section-inner--prose">
        <h2 id="box-title" class="section-title">
          Ce qui est inclus.
        </h2>

        <h3 class="list-heading">Ce qu'il fait :</h3>
        <ul class="feature-list feature-list--does">
          <li>Ajoute des commandes slash pour l'ensemble du flux SDD : <code>/ideate</code>, <code>/specify</code>, <code>/plan</code>, <code>/implement</code>.</li>
          <li>Note la complétude et l'ambiguïté de la spécification avant que l'agent ne la voie.</li>
          <li>Rédige des spécifications au format ouvert SpecScore — sans extensions propriétaires.</li>
        </ul>

        <h3 class="list-heading">Ce qu'il ne fait pas :</h3>
        <ul class="feature-list feature-list--doesnt">
          <li>Exécuter l'agent à votre place. Le plugin est une couche de workflow ; l'agent reste Claude.</li>
          <li>Envoyer vos données où que ce soit. Les spécifications et les scores restent locaux.</li>
          <li>Vous enfermer. Si vous le désinstallez, vos spécifications restent du Markdown valide et analysable avec le CLI <a class="xref" href="https://github.com/specscore/specscore">specscore</a>.</li>
        </ul>

        <p class="sibling-callout">
          Vous cherchez l'interface CLI neutre ?
          <a class="xref" href="https://github.com/specscore/ai-plugin-specscore">ai-plugin-specscore</a>
          est le wrapper léger. SpecStudio Skills est le workflow pensé construit par-dessus.
        </p>
      </div>
    </section>

    {/* ── Section 6: Ouvert à la base ── */}
    <section class="section" aria-labelledby="open-title">
      <div class="section-inner section-inner--prose">
        <h2 id="open-title" class="section-title">
          Bâti sur le protocole ouvert SpecScore.
        </h2>
        <p class="prose-p">
          SpecStudio Skills écrit des spécifications dans
          <a class="xref" href="/fr/">SpecScore</a>, un standard
          ouvert. Le format est du Markdown lisible par les humains. Le schéma est
          publié. Le CLI est open source. Aucun enfermement propriétaire. Si un jour
          vous quittez SpecStudio, vos spécifications vous suivent.
        </p>
      </div>
    </section>
  </main>

  {/* ── CTA final ── */}
  <section class="final-cta" aria-labelledby="cta-title">
    <div class="final-cta__inner">
      <h2 id="cta-title" class="final-cta__title">Essayez-le.</h2>
      <div class="final-cta__install">
        <div class="qs-tabs" role="tablist" aria-label="Méthode d'installation">
          <button type="button" role="tab" id="qs-tab-claude-b" aria-controls="qs-panel-claude-b" aria-selected="true" tabindex="0" class="qs-tab is-active" data-tab="claude">Claude Code</button>
          <button type="button" role="tab" id="qs-tab-setup-b" aria-controls="qs-panel-setup-b" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="setup">Autres agents d'IA</button>
          <button type="button" role="tab" id="qs-tab-manual-b" aria-controls="qs-panel-manual-b" aria-selected="false" tabindex="-1" class="qs-tab" data-tab="manual">Manuel</button>
        </div>

        <div id="qs-panel-claude-b" role="tabpanel" aria-labelledby="qs-tab-claude-b" class="qs-panel is-active" data-panel="claude">
<pre class="terminal"><span class="prompt">$</span> /plugin marketplace add specscore/ai-marketplace
<span class="prompt">$</span> /plugin install specstudio@specscore</pre>
        </div>
        <div id="qs-panel-setup-b" role="tabpanel" aria-labelledby="qs-tab-setup-b" class="qs-panel" data-panel="setup" hidden>
<pre class="terminal"><span class="prompt">$</span> specscore agent setup &lt;nom-de-l-agent&gt;</pre>
          <p class="qs-note">
            Écrit le bon fichier d'instructions pour votre agent —
            <code>claude</code>, <code>copilot</code>, <code>cursor</code>, <code>codex</code>,
            <code>antigravity.google</code>, <code>pi.dev</code> ou <code>opencode</code>.
            S'exécute dans un projet géré par SpecScore. Nécessite le
            <a class="xref" href="/fr/cli/">CLI SpecScore</a>.
          </p>
        </div>
        <div id="qs-panel-manual-b" role="tabpanel" aria-labelledby="qs-tab-manual-b" class="qs-panel" data-panel="manual" hidden>
<pre class="terminal"><span class="prompt">$</span> git clone https://github.com/specscore/specstudio-skills
<span class="prompt">$</span> cp -r specstudio-skills/commands /chemin/vers/votre/agent/commands/
<span class="prompt">$</span> cp -r specstudio-skills/skills /chemin/vers/votre/agent/skills/</pre>
          <p class="qs-note">
            Clonez le dépôt du plugin et copiez les répertoires
            <code>commands/</code> et <code>skills/</code> là où votre agent charge
            les fichiers de commandes et de skills.
          </p>
        </div>
      </div>
      <p class="final-cta__note">
        Gratuit pour les dépôts publics et open source. Licence MIT.
      </p>
    </div>
  </section>

  {/* ── Footer ── */}
  <SiteFooterFr />
</BaseLayout>

<style>
  /* ── Hero ── */
  .hero {
    padding: var(--space-7) var(--space-3) var(--space-6);
    background: var(--cream);
  }
  .hero__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
    animation: fade-in 600ms cubic-bezier(0.22, 0.61, 0.36, 1) both 180ms;
  }
  .hero__headline {
    font-size: var(--fs-hero);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-3);
  }
  .hero__sub {
    font-size: 1.125rem;
    color: var(--mid-ink);
    margin-bottom: var(--space-4);
    line-height: 1.55;
  }
  .hero__install {
    margin-bottom: var(--space-3);
  }
  .hero__demo-link {
    font-size: var(--fs-small);
    color: var(--mid-ink);
  }

  @keyframes fade-in {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ── Sections ── */
  .section-title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }
  .prose-p {
    color: var(--mid-ink);
    line-height: 1.65;
    margin-bottom: var(--space-3);
  }
  .prose-p:last-child { margin-bottom: 0; }

  /* ── Demo ── */
  .demo-placeholder {
    max-width: var(--max-prose);
  }
  .demo-placeholder .terminal {
    margin: 0;
  }
  .demo-caption {
    font-size: var(--fs-small);
    color: var(--mid-ink);
    margin-top: var(--space-2);
    line-height: 1.5;
  }

  /* ── Pipeline ── */
  .pipeline-section { background: var(--cream-2); }
  .pipeline-intro {
    color: var(--mid-ink);
    margin-bottom: var(--space-4);
    line-height: 1.55;
  }
  .pipeline-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-3);
  }
  .pipeline-card {
    background: var(--surface);
    border: 1px solid var(--hairline);
    padding: var(--space-4);
  }
  .pipeline-card__head { margin-bottom: var(--space-2); }
  .pipeline-card__cmd {
    font-family: var(--font-code);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--ink);
  }
  .pipeline-card__desc {
    color: var(--mid-ink);
    font-size: 0.925rem;
    line-height: 1.55;
  }

  /* ── What's in the box ── */
  .list-heading {
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ink);
    margin-top: var(--space-4);
    margin-bottom: var(--space-2);
  }
  .feature-list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
  }
  .feature-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: var(--space-2);
    color: var(--mid-ink);
    line-height: 1.55;
  }
  .feature-list--does li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--validator-green);
    font-weight: 700;
  }
  .feature-list--doesnt li::before {
    content: "✗";
    position: absolute;
    left: 0;
    color: var(--mid-ink);
    font-weight: 700;
  }
  .feature-list code {
    font-size: 0.85em;
    background: var(--cream-2);
    padding: 0.08em 0.3em;
    border-radius: 2px;
  }
  .sibling-callout {
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top: 1px solid var(--hairline);
    font-size: var(--fs-small);
    color: var(--mid-ink);
    line-height: 1.55;
  }

  /* ── Quickstart install tabs ── */
  .qs-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--hairline);
    margin-bottom: 0;
  }
  .qs-tab {
    appearance: none;
    background: transparent;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 0.5rem 0.9rem;
    font-family: var(--font-code);
    font-size: 0.825rem;
    color: var(--mid-ink);
    cursor: pointer;
    transition: color 120ms ease, border-color 160ms ease;
  }
  .qs-tab:hover { color: var(--ink); }
  .qs-tab:focus-visible {
    outline: 2px solid var(--ink-blue);
    outline-offset: -2px;
  }
  .qs-tab.is-active {
    color: var(--ink);
    border-bottom-color: var(--validator-green);
    font-weight: 600;
  }
  .qs-panel {
    border-left: 1px solid var(--hairline);
    border-right: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    background: var(--surface);
  }
  .qs-panel pre.terminal {
    margin: 0;
    border: none;
    border-radius: 0;
  }
  .qs-note {
    font-size: var(--fs-small);
    color: var(--mid-ink);
    padding: var(--space-2) var(--space-3);
    border-top: 1px solid var(--hairline);
    line-height: 1.5;
    margin: 0;
  }
  .qs-note code {
    font-size: 0.85em;
    background: var(--cream-2);
    padding: 0.08em 0.3em;
    border-radius: 2px;
  }

  /* ── Terminal frame inside demo ── */
  .terminal-frame {
    border: 1px solid var(--hairline);
    background: var(--surface);
  }
  .terminal-frame__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.875rem;
    border-bottom: 1px solid var(--hairline);
    background: var(--cream);
    font-family: var(--font-code);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }
  .terminal-frame__title {
    color: var(--graphite);
    font-weight: 700;
    text-transform: uppercase;
  }
  .terminal-frame__hint { color: var(--pale-ink); }
  .terminal-frame__body {
    margin: 0;
    padding: var(--space-4);
    background: var(--surface);
    border: none;
    border-radius: 0;
    font-size: 0.875rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  /* ── Final CTA ── */
  .final-cta {
    background: var(--surface);
    border-top: 1px solid var(--hairline);
    padding: var(--space-7) var(--space-3);
  }
  .final-cta__inner {
    max-width: var(--max-prose);
    margin: 0 auto;
  }
  .final-cta__title {
    font-size: var(--fs-h2);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-3);
  }
  .final-cta__install { margin-bottom: var(--space-3); }
  .final-cta__note {
    font-size: var(--fs-small);
    color: var(--mid-ink);
  }

  @media (max-width: 860px) {
    .pipeline-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<QsTabsScript />
